[[- $on := true ]][[ range .Disabled ]][[ if eq . "victoria-metrics-k8s-stack" ]][[ $on = false ]][[ end ]][[ end ]]
[[- if $on -]]
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: victoria-metrics-k8s-stack
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
  annotations:
    argocd.argoproj.io/sync-wave: "30"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: platform
  source:
    repoURL: https://victoriametrics.github.io/helm-charts/
    chart: victoria-metrics-k8s-stack
    targetRevision: 0.95.0
    helm:
      releaseName: victoria-metrics-k8s-stack
      valuesObject:
        # The chart's own guidance under Argo CD: name the release after the
        # Application so its generated names are stable.
        argocdReleaseOverride: victoria-metrics-k8s-stack
        victoria-metrics-operator:
          # The webhook's self-signed certificate is regenerated on every
          # render, which Argo CD would show as permanent drift.
          admissionWebhooks:
            enabled: false
          resources:
            requests:
              cpu: 20m
              memory: 64Mi
        vmsingle:
          spec:
            # 30 days covers 28-day SLO windows; about 6-7 GB for one management cluster.
            retentionPeriod: "30d"
            # Read on infrared-cp-google on 2026-10-13 (localred plan, spike S4): 89,000
            # active series and 723 MiB in use under the former 1 GiB limit, before any
            # developer's stack pushes to the telemetry plane (ADR 0044). 2 GiB leaves
            # room for several stacks at a few thousand series each; the owner allowed
            # the raise.
            resources:
              requests:
                cpu: 100m
                memory: 512Mi
              limits:
                memory: 2Gi
[[- if and (eq .ClusterFlavor "k3s") .Stores ]]
            # With the stores the cluster is several servers, each with its own
            # disk, and is built to lose one: SeaweedFS keeps every file on two
            # of them. On k3s the default StorageClass, local-path, would keep
            # VMSingle's data on one server's disk, and after that server is
            # lost the pod would stay Pending until a person deleted the claim.
            # So the data is on the pod's own disk instead, an emptyDir of up
            # to 10Gi, which the
            # operator mounts where VictoriaMetrics keeps its data because it
            # is named data. A request for no space turns off the chart's
            # claim: the operator makes none for a zero request. (A null would
            # not do: an apply of this file deletes the key, and the chart's
            # 20Gi claim comes back.) The metrics start empty after a node loss
            # or a pod restart, and a pod that outgrows the limit is evicted
            # and starts empty.
            storage:
              resources:
                requests:
                  storage: "0"
            volumes:
              - name: data
                emptyDir:
                  sizeLimit: 10Gi
[[- else ]]
            storage:
              resources:
                requests:
                  storage: 10Gi
[[- end ]]
        vmagent:
          spec:
            externalLabels:
              cluster: [[ .ClusterName ]]
            resources:
              requests:
                cpu: 50m
                memory: 128Mi
              limits:
                memory: 512Mi
        vmalert:
          spec:
            resources:
              requests:
                cpu: 10m
                memory: 32Mi
        alertmanager:
          spec:
            resources:
              requests:
                cpu: 10m
                memory: 32Mi
        grafana:
          enabled: true
          # Access is by port-forward: svc/victoria-metrics-k8s-stack-grafana 80.
          ingress:
            enabled: false
          resources:
            requests:
              cpu: 20m
              memory: 128Mi
            limits:
              memory: 512Mi
        # Neither flavor exposes these: EKS runs the control plane for you,
        # and k3s runs it inside the k3s process without these endpoints.
        kubeControllerManager:
          enabled: false
        kubeScheduler:
          enabled: false
        kubeEtcd:
          enabled: false
        # The chart copies every node label onto each kubelet and cAdvisor
        # series. A GKE node has about 35, which takes each series past
        # VMSingle's limit of 40 labels, so VMSingle kept none of them: no CPU,
        # memory or network for any pod. This list replaces the chart's
        # without that copy; the node's name stays in the node label.
        kubelet:
          vmScrape:
            spec:
              relabelConfigs:
                - sourceLabels: [__metrics_path__]
                  targetLabel: metrics_path
                - replacement: kubelet
                  targetLabel: job
[[- if eq .ClusterFlavor "k3s" ]]
        # k3s keeps one metrics registry for the whole process, so a node's
        # kubelet and API server endpoints each serve all of it, about 60,000
        # series. The kubelet scrape keeps the kubelet's own families, and the
        # API server scrape drops the other components' families and ten
        # histograms that none of this chart's rules or dashboards read: about
        # 30,000 series a node in place of 120,000, which fits VMSingle's 1 GiB.
          vmScrapes:
            kubelet:
              spec:
                # This list replaces the chart's for this one scrape, so the
                # chart's two label drops are repeated here.
                metricRelabelConfigs:
                  - action: labeldrop
                    regex: (uid)
                  - action: labeldrop
                    regex: (id|name)
                  - action: keep
                    sourceLabels: [__name__]
                    regex: (kubelet_.+|volume_manager_.+|storage_operation_.+|csi_operations_.+|plugin_manager_.+|kubernetes_build_info|go_.+|process_.+|rest_client_requests_total)
        kubeApiServer:
          vmScrape:
            spec:
              # The chart's one endpoint, with the drops added.
              endpoints:
                - bearerTokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
                  port: https
                  scheme: https
                  tlsConfig:
                    caFile: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
                    serverName: kubernetes
                  metricRelabelConfigs:
                    - action: drop
                      sourceLabels: [__name__]
                      regex: (kubelet|kubeproxy|scheduler|volume_manager|storage_operation|prober|lasso)_.+
                    - action: drop
                      sourceLabels: [__name__]
                      regex: (etcd_request_duration_seconds_bucket|apiserver_watch_events_dispatch_duration_seconds_bucket|apiserver_request_body_size_bytes_bucket|apiserver_storage_list_duration_seconds_bucket|apiserver_watch_list_duration_seconds_bucket|apiserver_watch_cache_read_wait_seconds_bucket|apiserver_watch_cache_initialization_duration_seconds_bucket|apiserver_response_sizes_bucket|apiserver_watch_events_sizes_bucket|apiserver_admission_controller_admission_duration_seconds_bucket)
[[- end ]]
        # extraObjects go through tpl, so the dashboards' {{ }} legends are quoted.
        extraObjects:
          # Infrared's own metrics (ADR 0044): the operator's step counters and
          # the API's request counters, on every Service port named metrics in
          # the Infrared namespace, which the chart names so. An empty selector
          # is every Service there; one without such a port yields no target.
          - apiVersion: operator.victoriametrics.com/v1beta1
            kind: VMServiceScrape
            metadata:
              name: infrared-metrics
              namespace: [[ .InfraredNamespace ]]
            spec:
              selector: {}
              endpoints:
                - port: metrics
                  interval: 30s
          # The Fleet dashboard (infrared-docs-internal ADR 0044, P10): every
          # platform's numbers side by side, hosted's own and each Mac's stack
          # that pushes to this store through infrared-api's write path, by the
          # cluster label both carry: the plane's own health (targets, writes,
          # buffers), Infrared's API and operator, agent steps (attempts, cost,
          # duration, tokens), the step containers, the Macs' machines, the
          # builders' Claude Code sessions, and the store itself. The series
          # come from the operator, the API, each stack's vmagent and the
          # localred app, named as the plan (localred
          # docs/plan-work-distributor.md, phase 1) says. Its fourth cut, from
          # phase 1's proof on 2026-10-14: a change run's fourteen attempts and a
          # builder session from one Mac beside hosted. Counters use
          # increase_pure, so a platform's first hour counts from its first
          # sample; durations are quantiles over the hour's histogram.
          - apiVersion: v1
            kind: ConfigMap
            metadata:
              name: infrared-fleet-dashboard
              namespace: monitoring
              labels:
                # Grafana's sidecar loads every ConfigMap so labelled in monitoring.
                grafana_dashboard: "1"
            data:
              infrared-fleet.json: |
                {
                  "uid": "infrared-fleet",
                  "title": "Infrared fleet: every platform as one unit",
                  "tags": [
                    "infrared"
                  ],
                  "editable": true,
                  "schemaVersion": 39,
                  "version": 4,
                  "time": {
                    "from": "now-6h",
                    "to": "now"
                  },
                  "timezone": "browser",
                  "refresh": "1m",
                  "graphTooltip": 1,
                  "description": "Every platform of the telemetry plane as one unit (ADR 0044). Fourth cut, 2026-10-14, from the first proof: a change run and a builder session on a Mac, beside hosted.",
                  "templating": {
                    "list": [
                      {
                        "name": "cluster",
                        "label": "Platform",
                        "type": "query",
                        "query": {
                          "query": "label_values(up, cluster)",
                          "refId": "var"
                        },
                        "definition": "label_values(up, cluster)",
                        "multi": true,
                        "includeAll": true,
                        "allValue": ".*",
                        "current": {
                          "text": "All",
                          "value": "$__all"
                        },
                        "refresh": 2,
                        "sort": 1
                      }
                    ]
                  },
                  "panels": [
                    {
                      "id": 1,
                      "type": "row",
                      "title": "The plane: every platform that sends, and how its writes fare",
                      "collapsed": false,
                      "gridPos": {
                        "x": 0,
                        "y": 0,
                        "w": 24,
                        "h": 1
                      },
                      "panels": []
                    },
                    {
                      "id": 2,
                      "type": "stat",
                      "title": "Targets up, by platform",
                      "description": "Scrape targets answering on each platform: on a Mac's stack the API, the operator and the kubelet; on hosted everything its metrics stack scrapes.",
                      "gridPos": {
                        "x": 0,
                        "y": 1,
                        "w": 6,
                        "h": 5
                      },
                      "targets": [
                        {
                          "expr": "sum by (cluster) (up{cluster=~\"$cluster\"})",
                          "legendFormat": "{{ `{{cluster}}` }}",
                          "refId": "A",
                          "instant": true,
                          "range": false
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {
                          "unit": "short"
                        },
                        "overrides": []
                      },
                      "options": {
                        "reduceOptions": {
                          "calcs": [
                            "lastNotNull"
                          ],
                          "fields": "",
                          "values": false
                        },
                        "textMode": "value_and_name",
                        "colorMode": "none",
                        "graphMode": "none",
                        "justifyMode": "center",
                        "orientation": "auto"
                      }
                    },
                    {
                      "id": 3,
                      "type": "stat",
                      "title": "Samples per scrape, by platform",
                      "description": "How much each platform sends per scrape round: a rough size of its share of the plane.",
                      "gridPos": {
                        "x": 6,
                        "y": 1,
                        "w": 6,
                        "h": 5
                      },
                      "targets": [
                        {
                          "expr": "sum by (cluster) (scrape_samples_scraped{cluster=~\"$cluster\"})",
                          "legendFormat": "{{ `{{cluster}}` }}",
                          "refId": "A",
                          "instant": true,
                          "range": false
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {
                          "unit": "short"
                        },
                        "overrides": []
                      },
                      "options": {
                        "reduceOptions": {
                          "calcs": [
                            "lastNotNull"
                          ],
                          "fields": "",
                          "values": false
                        },
                        "textMode": "value_and_name",
                        "colorMode": "none",
                        "graphMode": "none",
                        "justifyMode": "center",
                        "orientation": "auto"
                      }
                    },
                    {
                      "id": 4,
                      "type": "stat",
                      "title": "Remote writes accepted per minute",
                      "description": "A Mac's vmagent writing to hosted's API; hosted's own vmagent writing to its store.",
                      "gridPos": {
                        "x": 12,
                        "y": 1,
                        "w": 6,
                        "h": 5
                      },
                      "targets": [
                        {
                          "expr": "sum by (cluster) (rate(vmagent_remotewrite_requests_total{cluster=~\"$cluster\", status_code=~\"2.*\"}[5m])) * 60",
                          "legendFormat": "{{ `{{cluster}}` }}",
                          "refId": "A",
                          "instant": true,
                          "range": false
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {
                          "unit": "short"
                        },
                        "overrides": []
                      },
                      "options": {
                        "reduceOptions": {
                          "calcs": [
                            "lastNotNull"
                          ],
                          "fields": "",
                          "values": false
                        },
                        "textMode": "value_and_name",
                        "colorMode": "none",
                        "graphMode": "none",
                        "justifyMode": "center",
                        "orientation": "auto"
                      }
                    },
                    {
                      "id": 5,
                      "type": "stat",
                      "title": "Buffered on disk, not yet written",
                      "description": "Bytes waiting in a vmagent's disk queue: rises while a Mac cannot reach hosted, drains when it can.",
                      "gridPos": {
                        "x": 18,
                        "y": 1,
                        "w": 6,
                        "h": 5
                      },
                      "targets": [
                        {
                          "expr": "sum by (cluster) (vmagent_remotewrite_pending_data_bytes{cluster=~\"$cluster\"})",
                          "legendFormat": "{{ `{{cluster}}` }}",
                          "refId": "A",
                          "instant": true,
                          "range": false
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {
                          "unit": "bytes"
                        },
                        "overrides": []
                      },
                      "options": {
                        "reduceOptions": {
                          "calcs": [
                            "lastNotNull"
                          ],
                          "fields": "",
                          "values": false
                        },
                        "textMode": "value_and_name",
                        "colorMode": "none",
                        "graphMode": "none",
                        "justifyMode": "center",
                        "orientation": "auto"
                      }
                    },
                    {
                      "id": 6,
                      "type": "timeseries",
                      "title": "Remote writes per minute, by platform and answer",
                      "description": "2XX is accepted; anything else is the write path refusing (401 a revoked token, 413 too large, 502 the store) or the edge.",
                      "gridPos": {
                        "x": 0,
                        "y": 6,
                        "w": 12,
                        "h": 7
                      },
                      "targets": [
                        {
                          "expr": "sum by (cluster, status_code) (rate(vmagent_remotewrite_requests_total{cluster=~\"$cluster\"}[5m])) * 60",
                          "legendFormat": "{{ `{{cluster}}` }} {{ `{{status_code}}` }}",
                          "refId": "A"
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {
                          "unit": "short",
                          "custom": {
                            "lineWidth": 1,
                            "fillOpacity": 12,
                            "showPoints": "never",
                            "stacking": {
                              "mode": "none"
                            }
                          }
                        },
                        "overrides": []
                      },
                      "options": {
                        "legend": {
                          "displayMode": "list",
                          "placement": "bottom",
                          "showLegend": true
                        },
                        "tooltip": {
                          "mode": "multi",
                          "sort": "desc"
                        }
                      }
                    },
                    {
                      "id": 7,
                      "type": "timeseries",
                      "title": "Rows pushed per second, by platform",
                      "description": "Samples leaving each platform's vmagent for the plane.",
                      "gridPos": {
                        "x": 12,
                        "y": 6,
                        "w": 12,
                        "h": 7
                      },
                      "targets": [
                        {
                          "expr": "sum by (cluster) (rate(vmagent_remotewrite_rows_pushed_total{cluster=~\"$cluster\"}[5m]))",
                          "legendFormat": "{{ `{{cluster}}` }}",
                          "refId": "A"
                        }
