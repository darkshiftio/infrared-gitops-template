                      "targets": [
                        {
                          "expr": "sum by (platform) (increase_pure(infrared_api_requests_total{platform=~\"$platform\", op=~\"login|complete-google-login|complete-github-login|redeem-sign-in-link\", status=~\"2..|3..\"}[$__range]))",
                          "legendFormat": "{{ `{{platform}}` }}",
