[[- $on := true ]][[ range .Disabled ]][[ if eq . "victoria-metrics-k8s-stack" ]][[ $on = false ]][[ end ]][[ end ]]
[[- $platform := default .ClusterName .Telemetry.Platform ]]
[[- if $on -]]
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: victoria-metrics-k8s-stack
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
  annotations:
    argocd.argoproj.io/sync-wave: "30"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: platform
  source:
    repoURL: https://victoriametrics.github.io/helm-charts/
    chart: victoria-metrics-k8s-stack
    targetRevision: 0.95.0
    helm:
      releaseName: victoria-metrics-k8s-stack
      valuesObject:
        # The chart's own guidance under Argo CD: name the release after the
        # Application so its generated names are stable.
        argocdReleaseOverride: victoria-metrics-k8s-stack
        victoria-metrics-operator:
          # The webhook's self-signed certificate is regenerated on every
          # render, which Argo CD would show as permanent drift.
          admissionWebhooks:
            enabled: false
          resources:
            requests:
              cpu: 20m
              memory: 64Mi
        vmsingle:
          spec:
            # 30 days covers 28-day SLO windows; about 6-7 GB for one management cluster.
            retentionPeriod: "30d"
            # Read on infrared-cp-google on 2026-10-13 (localred plan, spike S4): 89,000
            # active series and 723 MiB in use under the former 1 GiB limit, before any
            # developer's stack pushes to the telemetry plane (ADR 0044). 2 GiB leaves
            # room for several stacks at a few thousand series each; the owner allowed
            # the raise.
            resources:
              requests:
                cpu: 100m
                memory: 512Mi
              limits:
                memory: 2Gi
            # Caps against a runaway writer (infrared-docs-internal ADR 0069,
            # T3), the same on every install: the home takes every install's
            # series through the API's write path, and a Mac's stack or a
            # broken exporter must not fill the store. VictoriaMetrics
            # v1.153.0's own flags, which the operator passes as -<key>=<value>:
            # at most 40 labels on a series (its default, said here so that a
            # change is a change here), and at most 2,000,000 new series an
            # hour and 5,000,000 a day, logged and dropped past that. The home
            # held about 89,000 active series on 2026-10-13, and a Mac's stack
            # sends about 1,400 after the keep lists (ADR 0044): tens of
            # installs fit under both.
            extraArgs:
              maxLabelsPerTimeseries: "40"
              storage.maxHourlySeries: "2000000"
              storage.maxDailySeries: "5000000"
[[- if and (eq .ClusterFlavor "k3s") .Stores (ne .Cloud "gcp") ]]
            # With the stores the cluster is several servers, each with its own
            # disk, and is built to lose one: SeaweedFS keeps every file on two
            # of them. On k3s the default StorageClass, local-path, would keep
            # VMSingle's data on one server's disk, and after that server is
            # lost the pod would stay Pending until a person deleted the claim.
            # So the data is on the pod's own disk instead, an emptyDir of up
            # to 10Gi, which the
            # operator mounts where VictoriaMetrics keeps its data because it
            # is named data. A request for no space turns off the chart's
            # claim: the operator makes none for a zero request. (A null would
            # not do: an apply of this file deletes the key, and the chart's
            # 20Gi claim comes back.) The metrics start empty after a node loss
            # or a pod restart, and a pod that outgrows the limit is evicted
            # and starts empty.
            storage:
              resources:
                requests:
                  storage: "0"
            volumes:
              - name: data
                emptyDir:
                  sizeLimit: 10Gi
[[- else ]]
[[- if eq .Cloud "gcp" ]]
            # On Google Cloud the claim is a persistent disk of the cluster's
            # default class, which follows the pod to whichever node it lands
            # on, as SeaweedFS's disks do: a restart, a template move or a
            # node's replacement keeps the metrics. 10Gi holds the 30 days:
            # infrared-cp-google wrote about 130 MB a day on 2026-10-13 (localred
            # plan, spike S4), a few GB at the retention.
[[- end ]]
            storage:
              resources:
                requests:
                  storage: 10Gi
[[- end ]]
        vmagent:
[[- if .Telemetry.URL ]]
          # This install's own series to the telemetry plane (infrared-docs-
          # internal ADR 0069 T8, extending ADR 0044): the Installation's
          # spec.observability.telemetry names the plane's write path and this
          # install's platform, and whoever set them (ir install's
          # registration, ir telemetry connect, or Settings) wrote the token to
          # the Secret monitoring/telemetry-token, key token, which this repo
          # never holds; the VictoriaMetrics operator waits for it. A second
          # remote write beside VMSingle's own, which the chart keeps. What
          # leaves is the telemetry component's keep list and nothing else
          # (ADR 0069 T4): this vmagent scrapes far more than a Mac's (the
          # kubelet, kube-state-metrics, node exporter, Argo CD, the stack's
          # own components), so the write relabeling marks what is wanted and
          # keeps only that: Infrared's own series; the operator's and the
          # API's reconcile, workqueue, process and Go figures, by their jobs
          # alone, since every Go component here exports the same families;
          # up and the scrape figures of every target; this vmagent's own
          # write path, by its job; and the kubelet's memory working set and
          # CPU seconds of ir-org-* containers. The marker label is dropped
          # after the keep, the kubelet's id, name and image labels go from
          # the container series as the component drops them, and the
          # identity labels Claude Code puts on what it exports never leave
          # (localred finding K1). The buffer for this URL alone is up to
          # 800 MiB on the pod's own disk, so a plane that is away for a while
          # gets the backlog when it is back; a pod restart loses what is
          # buffered. No hourly series cap here: vmagent's is global, and would
          # cap VMSingle's own path too; the plane's VMSingle caps what it
          # takes (above). Without a URL nothing of this renders.
          additionalRemoteWrites:
            - url: [[ .Telemetry.URL ]]
              bearerTokenSecret:
                name: telemetry-token
                key: token
              maxDiskUsage: 800MiB
              inlineUrlRelabelConfig:
                - sourceLabels: [__name__]
                  regex: infrared_.*
                  targetLabel: __tmp_plane
                  replacement: keep
                - sourceLabels: [job, __name__]
                  regex: (infrared|infrared-operator|infrared-api);(controller_runtime_reconcile_total|controller_runtime_reconcile_errors_total|controller_runtime_reconcile_time_seconds.*|workqueue_depth|workqueue_adds_total|process_resident_memory_bytes|process_cpu_seconds_total|go_memstats_heap_inuse_bytes|go_goroutines)
                  targetLabel: __tmp_plane
                  replacement: keep
                - sourceLabels: [__name__]
                  regex: up|scrape_samples_scraped|scrape_duration_seconds
                  targetLabel: __tmp_plane
                  replacement: keep
                - sourceLabels: [job, __name__]
                  regex: vmagent-.*;(vmagent_remotewrite_requests_total|vmagent_remotewrite_pending_data_bytes|vmagent_remotewrite_rows_pushed_total|vmagent_remotewrite_rows_pushed_after_relabel_total|vmagent_remotewrite_packets_dropped_total|vmagent_remotewrite_retries_count_total|vm_persistentqueue_bytes_pending|vm_persistentqueue_blocks_dropped_total|vmagent_rows_inserted_total|vm_rows_inserted_total|vm_app_version|process_resident_memory_bytes)
                  targetLabel: __tmp_plane
                  replacement: keep
                - sourceLabels: [__name__, namespace, container]
                  regex: (container_memory_working_set_bytes|container_cpu_usage_seconds_total);ir-org-.+;.+
                  targetLabel: __tmp_plane
                  replacement: keep
                - sourceLabels: [__tmp_plane]
                  action: keep
                  regex: keep
                - action: labeldrop
                  regex: __tmp_plane
                - if: '{__name__=~"container_.*"}'
                  action: labeldrop
                  regex: id|name|image
                - action: labeldrop
                  regex: "user\\.email|user\\.id|organization\\.id|user_email|user_id|organization_id"
[[- end ]]
          spec:
            # Both labels name this install. A Mac's stack writes platform and
            # cluster with the same value, <login>-<stack> (ADR 0044, the
            # telemetry component), so the Fleet dashboard groups by platform
            # for every install, this one's own series included (localred
            # finding T4). With the Installation's telemetry set, platform is
            # the name the install registered under, install-<id> (ADR 0069
            # T2), which the plane's token sets on what arrives there too, so
            # the install's own Grafana and the home's show it under one name;
            # cluster stays the cluster's. vmagent adds them to every series it
            # scrapes; a series that already has a platform label keeps it only
            # under honorLabels (the API's infrared_telemetry_writes_total,
            # below), and elsewhere is renamed exported_platform.
            externalLabels:
              cluster: [[ .ClusterName ]]
              platform: [[ $platform ]]
[[- if .Telemetry.URL ]]
            # vmagent's own write series (vmagent_remotewrite_*) name each
            # URL rather than 1:secret-url: the URL carries no secret (the
            # token is a header), and the API's GET /v1/telemetry reads the
            # plane's last accepted write by it, as ir telemetry status does.
            remoteWriteSettings:
              showURL: true
[[- end ]]
            resources:
              requests:
                cpu: 50m
                memory: 128Mi
              limits:
                memory: 512Mi
        vmalert:
          spec:
            resources:
              requests:
                cpu: 10m
                memory: 32Mi
        alertmanager:
          spec:
            resources:
              requests:
                cpu: 10m
                memory: 32Mi
            # The platform receiver's token (config, below): the operator
            # writes it to the Secret monitoring/infrared-alert-webhook, key
            # token, as it writes each org's, and this repo never holds it.
            # Mounted the way VMAlertmanager mounts every Secret it is given,
            # at /etc/vm/secrets/<name>/; the pod waits for it.
            secrets:
              - infrared-alert-webhook
          # The root route (infrared-docs-internal ADR 0069 T9; workspace TODO
          # 429). Each org's alerts take the org's own route first: the
          # VMAlertmanagerConfig the operator writes in the org's namespace,
          # which the VictoriaMetrics operator merges in here as a sub-route
          # with a matcher on that namespace. Every other alert, the install's
          # own (the chart's Kubernetes rules, the metrics' copy's, the API's,
          # the operator's, the store's and the writes to the plane, the VMRule
          # infrared-platform below), goes to the API's platform receiver,
          # which opens an Incident on the platform org's own Product, or an
          # install-wide one where the install holds none. The chart's default
          # sent everything unrouted to a blackhole.
          #
          # Noise goes to the receiver none, which sends nowhere: the chart's
          # Watchdog, which always fires to prove the path works, InfoInhibitor,
          # which only mutes info alerts, and every alert of severity info or
          # none, such as a recording rule that produces no data. On
          # infrared-cp-google on 2026-11-06 these were 20 of 29 open Incidents,
          # none asking anything of a person. The API drops them too.
          config:
            route:
              receiver: infrared-platform
              group_by: [alertname, severity]
              group_wait: 30s
              group_interval: 5m
              repeat_interval: 4h
              routes:
                - receiver: none
                  matchers:
                    - alertname=~"Watchdog|InfoInhibitor"
                - receiver: none
                  matchers:
                    - severity=~"info|none"
            receivers:
              - name: infrared-platform
                webhook_configs:
                  - url: http://infrared-api.[[ .InfraredNamespace ]].svc:8080/v1/webhooks/alertmanager/_platform
                    send_resolved: true
                    http_config:
                      authorization:
                        type: Bearer
                        credentials_file: /etc/vm/secrets/infrared-alert-webhook/token
              - name: none
        grafana:
          enabled: true
          # Access is by port-forward: svc/victoria-metrics-k8s-stack-grafana 80.
          ingress:
            enabled: false
          resources:
            requests:
              cpu: 20m
              memory: 128Mi
            limits:
              memory: 512Mi
[[- if and .OIDC .GrafanaURL .InfraredHost ]]
          # People sign in through Infrared (infrared-docs-internal ADR 0053),
          # which signs them in as it signs them in to itself, Google first. A
          # person's role here is their role in the platform org: platform-admin
          # is Admin and server admin, org-admin Admin, member Editor and viewer
          # Viewer; anyone else is refused, by Infrared and here
          # (role_attribute_strict). The browser goes to Infrared's own address;
          # Grafana's own calls (the token, the person's claims and the signing
          # keys) stay in the cluster, on the API's Service. The admin keeps its
          # password as break glass, at /login?disableAutoLogin.
          grafana.ini:
            server:
              root_url: [[ printf "%s/" .GrafanaURL | quote ]]
            auth:
              disable_login_form: false
              # As long as Infrared's own session.
              login_maximum_lifetime_duration: 12h
            auth.generic_oauth:
              enabled: true
              name: Infrared
              client_id: grafana
              scopes: openid email profile offline_access
              auth_url: [[ printf "https://%s/api/v1/oidc/authorize" .InfraredHost | quote ]]
              token_url: [[ printf "http://infrared-api.%s.svc.cluster.local:8080/v1/oidc/token" .InfraredNamespace | quote ]]
              api_url: [[ printf "http://infrared-api.%s.svc.cluster.local:8080/v1/oidc/userinfo" .InfraredNamespace | quote ]]
              jwk_set_url: [[ printf "http://infrared-api.%s.svc.cluster.local:8080/v1/oidc/jwks" .InfraredNamespace | quote ]]
              validate_id_token: true
              use_pkce: true
              use_refresh_token: true
              auto_login: true
              allow_sign_up: true
              login_attribute_path: preferred_username
              email_attribute_path: email
              name_attribute_path: name
              role_attribute_path: "infrared_platform_role == 'platform-admin' && 'GrafanaAdmin' || infrared_platform_role == 'org-admin' && 'Admin' || infrared_platform_role == 'member' && 'Editor' || infrared_platform_role == 'viewer' && 'Viewer'"
              role_attribute_strict: true
              allow_assign_grafana_admin: true
              skip_org_role_sync: false
          # The client's secret, which infrared-api writes to the Secret
          # monitoring/infrared-oidc-grafana and never returns. Not optional:
          # Grafana waits for the API to write it. It stays out of grafana.ini,
          # which the grafana chart renders into a ConfigMap and refuses
          # secrets in (assertNoLeakedSecrets).
          envValueFrom:
            GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET:
              secretKeyRef:
                name: infrared-oidc-grafana
                key: client-secret
[[- end ]]
        # Neither flavor exposes these: EKS runs the control plane for you,
        # and k3s runs it inside the k3s process without these endpoints.
        kubeControllerManager:
          enabled: false
        kubeScheduler:
          enabled: false
        kubeEtcd:
          enabled: false
        # The chart copies every node label onto each kubelet and cAdvisor
        # series. A GKE node has about 35, which takes each series past
        # VMSingle's limit of 40 labels, so VMSingle kept none of them: no CPU,
        # memory or network for any pod. This list replaces the chart's
        # without that copy; the node's name stays in the node label.
        kubelet:
          vmScrape:
            spec:
              relabelConfigs:
                - sourceLabels: [__metrics_path__]
                  targetLabel: metrics_path
                - replacement: kubelet
                  targetLabel: job
[[- if eq .ClusterFlavor "k3s" ]]
        # k3s keeps one metrics registry for the whole process, so a node's
        # kubelet and API server endpoints each serve all of it, about 60,000
        # series. The kubelet scrape keeps the kubelet's own families, and the
        # API server scrape drops the other components' families and ten
        # histograms that none of this chart's rules or dashboards read: about
        # 30,000 series a node in place of 120,000, which fits VMSingle's 1 GiB.
          vmScrapes:
            kubelet:
              spec:
                # This list replaces the chart's for this one scrape, so the
                # chart's two label drops are repeated here.
                metricRelabelConfigs:
                  - action: labeldrop
                    regex: (uid)
                  - action: labeldrop
                    regex: (id|name)
                  - action: keep
                    sourceLabels: [__name__]
                    regex: (kubelet_.+|volume_manager_.+|storage_operation_.+|csi_operations_.+|plugin_manager_.+|kubernetes_build_info|go_.+|process_.+|rest_client_requests_total)
[[- end ]]
[[- if eq .Cloud "gcp" ]]
        # GKE runs the API server for you, and its /metrics is past vmagent's
        # 16 MiB scrape limit, so the target was never up: KubeAPIDown,
        # TargetDown and vmagent's scrape errors fired for good, and the
        # chart's API server recording rules produced no data
        # (infrared-cp-google, 2026-11-06). Off, its scrape and the rule
        # groups that read it go together. GKE's DNS is kube-dns, which serves
        # no metrics on CoreDNS's port 9153, so that scrape is off too.
        kubeApiServer:
          enabled: false
        coreDns:
          enabled: false
        # The chart turns off the API server's other rule groups with its
        # scrape, but not this one.
        defaultRules:
          groups:
            kube-apiserver-availability.rules:
              enabled: false
[[- else if eq .ClusterFlavor "k3s" ]]
        kubeApiServer:
          vmScrape:
            spec:
              # The chart's one endpoint, with the drops added.
              endpoints:
                - bearerTokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
                  port: https
                  scheme: https
                  tlsConfig:
                    caFile: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
                    serverName: kubernetes
                  metricRelabelConfigs:
                    - action: drop
                      sourceLabels: [__name__]
                      regex: (kubelet|kubeproxy|scheduler|volume_manager|storage_operation|prober|lasso)_.+
                    - action: drop
                      sourceLabels: [__name__]
                      regex: (etcd_request_duration_seconds_bucket|apiserver_watch_events_dispatch_duration_seconds_bucket|apiserver_request_body_size_bytes_bucket|apiserver_storage_list_duration_seconds_bucket|apiserver_watch_list_duration_seconds_bucket|apiserver_watch_cache_read_wait_seconds_bucket|apiserver_watch_cache_initialization_duration_seconds_bucket|apiserver_response_sizes_bucket|apiserver_watch_events_sizes_bucket|apiserver_admission_controller_admission_duration_seconds_bucket)
[[- end ]]
        # extraObjects go through tpl, so the dashboards' {{ }} legends are quoted.
        extraObjects:
[[- if .NetworkPolicies ]]
          # The network fence (INFRARED_NETWORK_POLICIES, README "The network
          # fence"): the platform reaches the metrics stack (Infrared's API and
          # operator read and write VMSingle, the tailnet reaches Grafana); no
          # org's namespace or zone does.
          - apiVersion: networking.k8s.io/v1
            kind: NetworkPolicy
            metadata:
              name: infrared-fence
              namespace: monitoring
            spec:
              podSelector: {}
              policyTypes:
                - Ingress
              ingress:
                # The platform: every namespace that is neither an org's nor a zone.
                - from:
                    - namespaceSelector:
                        matchExpressions:
                          - key: infrared.darkshift.io/org
                            operator: DoesNotExist
                          - key: infrared.darkshift.io/zone
                            operator: DoesNotExist
[[- end ]]
          # Infrared's own metrics (ADR 0044): the operator's step counters and
          # the API's request counters, on every Service port named metrics in
          # the Infrared namespace, which the chart names so. An empty selector
          # is every Service there; one without such a port yields no target.
          - apiVersion: operator.victoriametrics.com/v1beta1
            kind: VMServiceScrape
            metadata:
              name: infrared-metrics
              namespace: [[ .InfraredNamespace ]]
            spec:
              selector: {}
              endpoints:
                - port: metrics
                  interval: 30s
                  # The API labels infrared_telemetry_writes_total with the
                  # platform that wrote, a Mac's. Without this vmagent would
                  # rename that label exported_platform and set platform to
                  # this install's name, merging every Mac's writes into one
                  # row of the Fleet dashboard. No other series of the
                  # operator or the API has a label that clashes with a
                  # target's (job, instance, namespace, service, pod).
                  honorLabels: true
          # The install's own alerts (infrared-docs-internal ADR 0069 T9): the
          # API's and the operator's metrics targets down for 3 minutes, the
          # operator failing reconciles for 15 minutes, the store's own target
          # down[[ if .Telemetry.URL ]], and a remote write of this vmagent (the plane's, or
          # VMSingle's own) refused for 15 minutes[[ end ]]. Each carries severity and
          # infrared_platform, as the metrics' copy's alerts do, and no
          # infrared_product, so the root route above takes it to the API's
          # platform receiver. The platform label keeps every rule to this
          # install's own series: on the plane, VMSingle holds every install's.
          # The chart's own ServiceDown and TargetDown rules fire beside these
          # for the stack's components, and take the same route.
          - apiVersion: operator.victoriametrics.com/v1beta1
            kind: VMRule
            metadata:
              name: infrared-platform
              namespace: monitoring
            spec:
              groups:
                - name: infrared-platform
                  rules:
                    - alert: InfraredAPIDown
                      expr: max(up{job="infrared-api", platform="[[ $platform ]]"}) == 0 or absent(up{job="infrared-api", platform="[[ $platform ]]"})
                      for: 3m
                      labels:
                        severity: critical
                        infrared_platform: "true"
                      annotations:
                        summary: Infrared's API has not answered its metrics scrape for 3 minutes.
                    - alert: InfraredOperatorDown
                      expr: max(up{job="infrared-operator", platform="[[ $platform ]]"}) == 0 or absent(up{job="infrared-operator", platform="[[ $platform ]]"})
                      for: 3m
                      labels:
                        severity: critical
                        infrared_platform: "true"
                      annotations:
                        summary: Infrared's operator has not answered its metrics scrape for 3 minutes.
                    - alert: InfraredOperatorReconcileErrors
                      expr: sum by (controller) (rate(controller_runtime_reconcile_total{job="infrared-operator", platform="[[ $platform ]]", result="error"}[5m])) > 0
                      for: 15m
                      labels:
                        severity: warning
                        infrared_platform: "true"
                      annotations:
                        summary: "Infrared's operator has failed reconciles of {{ `{{ $labels.controller }}` }} for 15 minutes."
                    - alert: InfraredMetricsStoreDown
                      expr: max(up{job=~"vmsingle-.*", platform="[[ $platform ]]"}) == 0 or absent(up{job=~"vmsingle-.*", platform="[[ $platform ]]"})
                      for: 3m
                      labels:
                        severity: critical
                        infrared_platform: "true"
                      annotations:
                        summary: VMSingle, the install's metrics store, has not answered its scrape for 3 minutes.
[[- if .Telemetry.URL ]]
                    - alert: InfraredTelemetryWritesFailing
                      expr: sum by (url) (rate(vmagent_remotewrite_requests_total{job=~"vmagent-.*", platform="[[ $platform ]]", status_code!~"2.*"}[5m])) > 0
                      for: 15m
                      labels:
                        severity: warning
                        infrared_platform: "true"
                      annotations:
                        summary: "A remote write of this install's vmagent ({{ `{{ $labels.url }}` }}) has been refused for 15 minutes: the plane's token, or the store."
[[- end ]]
          # The Fleet dashboard (infrared-docs-internal ADR 0044, P10): every
          # platform's numbers side by side, hosted's own and each Mac's stack
          # that pushes to this store through infrared-api's write path, by the
          # platform label every install carries (this stack's vmagent sets it
          # to the install's name, above): the plane's own health (targets,
          # writes, buffers), Infrared's API and operator, agent steps
          # (attempts, cost, duration, tokens), the step containers, the Macs'
          # machines, the builders' Claude Code sessions, and the store itself.
          # The series come from the operator, the API, each stack's vmagent
          # and the localred app, named as the plan (localred
          # docs/plan-work-distributor.md, phase 1) says. Its fourth cut, from
          # phase 1's proof on 2026-10-14: a change run's fourteen attempts and a
          # builder session from one Mac beside hosted. Counters use
          # increase_pure, so a platform's first hour counts from its first
          # sample; durations are quantiles over the hour's histogram. Its
          # fifth cut groups by platform where the first four grouped by
          # cluster, which a Mac's stack sets to the same value, and which
          # hosted's own series had alone (localred finding T4).
          - apiVersion: v1
            kind: ConfigMap
            metadata:
              name: infrared-fleet-dashboard
              namespace: monitoring
              labels:
                # Grafana's sidecar loads every ConfigMap so labelled in monitoring.
                grafana_dashboard: "1"
            data:
              infrared-fleet.json: |
                {
                  "uid": "infrared-fleet",
                  "title": "Infrared fleet: every platform as one unit",
                  "tags": [
                    "infrared"
                  ],
                  "editable": true,
                  "schemaVersion": 39,
                  "version": 6,
                  "time": {
                    "from": "now-6h",
                    "to": "now"
                  },
                  "timezone": "browser",
                  "refresh": "1m",
                  "graphTooltip": 1,
                  "description": "Every platform of the telemetry plane as one unit (ADR 0044). Sixth cut, 2026-11-05: the agent steps split by model provider, and the model calls the runner forwards, by provider, status, error and latency (ADR 0069). Fifth cut, 2026-10-14: grouped by the platform label, which hosted's own series carry now too. Fourth cut, from the first proof: a change run and a builder session on a Mac, beside hosted.",
                  "templating": {
                    "list": [
                      {
                        "name": "platform",
                        "label": "Platform",
                        "type": "query",
                        "query": {
                          "query": "label_values(up, platform)",
                          "refId": "var"
                        },
                        "definition": "label_values(up, platform)",
                        "multi": true,
                        "includeAll": true,
                        "allValue": ".*",
                        "current": {
                          "text": "All",
                          "value": "$__all"
                        },
                        "refresh": 2,
                        "sort": 1
                      }
                    ]
