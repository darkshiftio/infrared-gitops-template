[[- $on := true ]][[ range .Disabled ]][[ if eq . "victoria-metrics-k8s-stack" ]][[ $on = false ]][[ end ]][[ end ]]
[[- if $on -]]
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: victoria-metrics-k8s-stack
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
  annotations:
    argocd.argoproj.io/sync-wave: "30"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: platform
  source:
    repoURL: https://victoriametrics.github.io/helm-charts/
    chart: victoria-metrics-k8s-stack
    targetRevision: 0.95.0
    helm:
      releaseName: victoria-metrics-k8s-stack
      valuesObject:
        # The chart's own guidance under Argo CD: name the release after the
        # Application so its generated names are stable.
        argocdReleaseOverride: victoria-metrics-k8s-stack
        victoria-metrics-operator:
          # The webhook's self-signed certificate is regenerated on every
          # render, which Argo CD would show as permanent drift.
          admissionWebhooks:
            enabled: false
          resources:
            requests:
              cpu: 20m
              memory: 64Mi
        vmsingle:
          spec:
            # 30 days covers 28-day SLO windows; about 6-7 GB for one management cluster.
            retentionPeriod: "30d"
            resources:
              requests:
                cpu: 100m
                memory: 256Mi
              limits:
                memory: 1Gi
[[- if eq .ClusterFlavor "k3s" ]]
            # On k3s the default StorageClass, local-path, would keep the data
            # on one node's disk, and after that node is lost the pod would
            # stay Pending until a person deleted the claim. So the data is on
            # the pod's own disk instead, an emptyDir of up to 10Gi, which the
            # operator mounts where VictoriaMetrics keeps its data because it
            # is named data. A request for no space turns off the chart's
            # claim: the operator makes none for a zero request. (A null would
            # not do: an apply of this file deletes the key, and the chart's
            # 20Gi claim comes back.) The metrics start empty after a node loss
            # or a pod restart, and a pod that outgrows the limit is evicted
            # and starts empty.
            storage:
              resources:
                requests:
                  storage: "0"
            volumes:
              - name: data
                emptyDir:
                  sizeLimit: 10Gi
[[- else ]]
            storage:
              resources:
                requests:
                  storage: 10Gi
[[- end ]]
        vmagent:
          spec:
            externalLabels:
              cluster: [[ .ClusterName ]]
            resources:
              requests:
                cpu: 50m
                memory: 128Mi
              limits:
                memory: 512Mi
        vmalert:
          spec:
            resources:
              requests:
                cpu: 10m
                memory: 32Mi
        alertmanager:
          spec:
            resources:
              requests:
                cpu: 10m
                memory: 32Mi
        grafana:
          enabled: true
          # Access is by port-forward: svc/victoria-metrics-k8s-stack-grafana 80.
          ingress:
            enabled: false
          resources:
            requests:
              cpu: 20m
              memory: 128Mi
            limits:
              memory: 512Mi
        # Neither flavor exposes these: EKS runs the control plane for you,
        # and k3s runs it inside the k3s process without these endpoints.
        kubeControllerManager:
          enabled: false
        kubeScheduler:
          enabled: false
        kubeEtcd:
          enabled: false
[[- if eq .ClusterFlavor "k3s" ]]
        # k3s keeps one metrics registry for the whole process, so a node's
        # kubelet and API server endpoints each serve all of it, about 60,000
        # series. The kubelet scrape keeps the kubelet's own families, and the
        # API server scrape drops the other components' families and ten
        # histograms that none of this chart's rules or dashboards read: about
        # 30,000 series a node in place of 120,000, which fits VMSingle's 1 GiB.
        kubelet:
          vmScrapes:
            kubelet:
              spec:
                # This list replaces the chart's for this one scrape, so the
                # chart's two label drops are repeated here.
                metricRelabelConfigs:
                  - action: labeldrop
                    regex: (uid)
                  - action: labeldrop
                    regex: (id|name)
                  - action: keep
                    sourceLabels: [__name__]
                    regex: (kubelet_.+|volume_manager_.+|storage_operation_.+|csi_operations_.+|plugin_manager_.+|kubernetes_build_info|go_.+|process_.+|rest_client_requests_total)
        kubeApiServer:
          vmScrape:
            spec:
              # The chart's one endpoint, with the drops added.
              endpoints:
                - bearerTokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
                  port: https
                  scheme: https
                  tlsConfig:
                    caFile: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
                    serverName: kubernetes
                  metricRelabelConfigs:
                    - action: drop
                      sourceLabels: [__name__]
                      regex: (kubelet|kubeproxy|scheduler|volume_manager|storage_operation|prober|lasso)_.+
                    - action: drop
                      sourceLabels: [__name__]
                      regex: (etcd_request_duration_seconds_bucket|apiserver_watch_events_dispatch_duration_seconds_bucket|apiserver_request_body_size_bytes_bucket|apiserver_storage_list_duration_seconds_bucket|apiserver_watch_list_duration_seconds_bucket|apiserver_watch_cache_read_wait_seconds_bucket|apiserver_watch_cache_initialization_duration_seconds_bucket|apiserver_response_sizes_bucket|apiserver_watch_events_sizes_bucket|apiserver_admission_controller_admission_duration_seconds_bucket)
[[- end ]]
  destination:
    server: https://kubernetes.default.svc
    namespace: monitoring
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true
      # The VictoriaMetrics operator CRDs are large.
      - ServerSideApply=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
[[- else -]]
# victoria-metrics-k8s-stack is left out: the Installation names it among its disabled
# components (INFRARED_DISABLED_COMPONENTS), so this file holds no objects.
[[- end ]]
