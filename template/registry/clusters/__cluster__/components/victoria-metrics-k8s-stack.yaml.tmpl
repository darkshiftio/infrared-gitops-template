[[- $on := true ]][[ range .Disabled ]][[ if eq . "victoria-metrics-k8s-stack" ]][[ $on = false ]][[ end ]][[ end ]]
[[- if $on -]]
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: victoria-metrics-k8s-stack
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
  annotations:
    argocd.argoproj.io/sync-wave: "30"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: platform
  source:
    repoURL: https://victoriametrics.github.io/helm-charts/
    chart: victoria-metrics-k8s-stack
    targetRevision: 0.95.0
    helm:
      releaseName: victoria-metrics-k8s-stack
      valuesObject:
        # The chart's own guidance under Argo CD: name the release after the
        # Application so its generated names are stable.
        argocdReleaseOverride: victoria-metrics-k8s-stack
        victoria-metrics-operator:
          # The webhook's self-signed certificate is regenerated on every
          # render, which Argo CD would show as permanent drift.
          admissionWebhooks:
            enabled: false
          resources:
            requests:
              cpu: 20m
              memory: 64Mi
        vmsingle:
          spec:
            # 30 days covers 28-day SLO windows; about 6-7 GB for one management cluster.
            retentionPeriod: "30d"
            resources:
              requests:
                cpu: 100m
                memory: 256Mi
              limits:
                memory: 1Gi
[[- if and (eq .ClusterFlavor "k3s") .Stores ]]
            # With the stores the cluster is several servers, each with its own
            # disk, and is built to lose one: SeaweedFS keeps every file on two
            # of them. On k3s the default StorageClass, local-path, would keep
            # VMSingle's data on one server's disk, and after that server is
            # lost the pod would stay Pending until a person deleted the claim.
            # So the data is on the pod's own disk instead, an emptyDir of up
            # to 10Gi, which the
            # operator mounts where VictoriaMetrics keeps its data because it
            # is named data. A request for no space turns off the chart's
            # claim: the operator makes none for a zero request. (A null would
            # not do: an apply of this file deletes the key, and the chart's
            # 20Gi claim comes back.) The metrics start empty after a node loss
            # or a pod restart, and a pod that outgrows the limit is evicted
            # and starts empty.
            storage:
              resources:
                requests:
                  storage: "0"
            volumes:
              - name: data
                emptyDir:
                  sizeLimit: 10Gi
[[- else ]]
            storage:
              resources:
                requests:
                  storage: 10Gi
[[- end ]]
        vmagent:
          spec:
            externalLabels:
              cluster: [[ .ClusterName ]]
            resources:
              requests:
                cpu: 50m
                memory: 128Mi
              limits:
                memory: 512Mi
        vmalert:
          spec:
            resources:
              requests:
                cpu: 10m
                memory: 32Mi
        alertmanager:
          spec:
            resources:
              requests:
                cpu: 10m
                memory: 32Mi
        grafana:
          enabled: true
          # Access is by port-forward: svc/victoria-metrics-k8s-stack-grafana 80.
          ingress:
            enabled: false
          resources:
            requests:
              cpu: 20m
              memory: 128Mi
            limits:
              memory: 512Mi
        # Neither flavor exposes these: EKS runs the control plane for you,
        # and k3s runs it inside the k3s process without these endpoints.
        kubeControllerManager:
          enabled: false
        kubeScheduler:
          enabled: false
        kubeEtcd:
          enabled: false
        # The chart copies every node label onto each kubelet and cAdvisor
        # series. A GKE node has about 35, which takes each series past
        # VMSingle's limit of 40 labels, so VMSingle kept none of them: no CPU,
        # memory or network for any pod. This list replaces the chart's
        # without that copy; the node's name stays in the node label.
        kubelet:
          vmScrape:
            spec:
              relabelConfigs:
                - sourceLabels: [__metrics_path__]
                  targetLabel: metrics_path
                - replacement: kubelet
                  targetLabel: job
[[- if eq .ClusterFlavor "k3s" ]]
        # k3s keeps one metrics registry for the whole process, so a node's
        # kubelet and API server endpoints each serve all of it, about 60,000
        # series. The kubelet scrape keeps the kubelet's own families, and the
        # API server scrape drops the other components' families and ten
        # histograms that none of this chart's rules or dashboards read: about
        # 30,000 series a node in place of 120,000, which fits VMSingle's 1 GiB.
          vmScrapes:
            kubelet:
              spec:
                # This list replaces the chart's for this one scrape, so the
                # chart's two label drops are repeated here.
                metricRelabelConfigs:
                  - action: labeldrop
                    regex: (uid)
                  - action: labeldrop
                    regex: (id|name)
                  - action: keep
                    sourceLabels: [__name__]
                    regex: (kubelet_.+|volume_manager_.+|storage_operation_.+|csi_operations_.+|plugin_manager_.+|kubernetes_build_info|go_.+|process_.+|rest_client_requests_total)
        kubeApiServer:
          vmScrape:
            spec:
              # The chart's one endpoint, with the drops added.
              endpoints:
                - bearerTokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
                  port: https
                  scheme: https
                  tlsConfig:
                    caFile: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
                    serverName: kubernetes
                  metricRelabelConfigs:
                    - action: drop
                      sourceLabels: [__name__]
                      regex: (kubelet|kubeproxy|scheduler|volume_manager|storage_operation|prober|lasso)_.+
                    - action: drop
                      sourceLabels: [__name__]
                      regex: (etcd_request_duration_seconds_bucket|apiserver_watch_events_dispatch_duration_seconds_bucket|apiserver_request_body_size_bytes_bucket|apiserver_storage_list_duration_seconds_bucket|apiserver_watch_list_duration_seconds_bucket|apiserver_watch_cache_read_wait_seconds_bucket|apiserver_watch_cache_initialization_duration_seconds_bucket|apiserver_response_sizes_bucket|apiserver_watch_events_sizes_bucket|apiserver_admission_controller_admission_duration_seconds_bucket)
[[- end ]]
        # extraObjects go through tpl, so the dashboards' {{ }} legends are quoted.
        extraObjects:
          # Infrared's own metrics (ADR 0044): the operator's step counters and
          # the API's request counters, on every Service port named metrics in
          # the Infrared namespace, which the chart names so. An empty selector
          # is every Service there; one without such a port yields no target.
          - apiVersion: operator.victoriametrics.com/v1beta1
            kind: VMServiceScrape
            metadata:
              name: infrared-metrics
              namespace: [[ .InfraredNamespace ]]
            spec:
              selector: {}
              endpoints:
                - port: metrics
                  interval: 30s
          # The Fleet dashboard (infrared-docs-internal ADR 0044, P10): every
          # platform's numbers side by side, hosted's own and each Mac's stack
          # that pushes to this store through infrared-api's write path: agent
          # steps (attempts, cost, duration, tokens), the step containers'
          # memory, the Macs' machines, the builders' Claude Code sessions, and
          # the write path's health. The series come from the operator, the
          # API, each stack's vmagent and the localred app, named as the plan
          # (localred docs/plan-work-distributor.md, phase 1) says.
          - apiVersion: v1
            kind: ConfigMap
            metadata:
              name: infrared-fleet-dashboard
              namespace: monitoring
              labels:
                # Grafana's sidecar loads every ConfigMap so labelled in monitoring.
                grafana_dashboard: "1"
            data:
              infrared-fleet.json: |
                {
                  "title": "Infrared fleet: every platform as one unit",
                  "uid": "infrared-fleet",
                  "schemaVersion": 39,
                  "time": {
                    "from": "now-24h",
                    "to": "now"
                  },
                  "refresh": "1m",
                  "tags": [
                    "infrared"
                  ],
                  "editable": true,
                  "panels": [
                    {
                      "id": 1,
                      "type": "stat",
                      "title": "Agent steps by platform, last 24 h",
                      "gridPos": {
                        "x": 0,
                        "y": 0,
                        "w": 8,
                        "h": 6
                      },
                      "targets": [
                        {
                          "expr": "sum by (platform) (increase(infrared_step_attempts_total[24h]))",
                          "legendFormat": "{{ `{{platform}}` }}",
                          "refId": "A"
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {},
                        "overrides": []
                      },
                      "options": {
                        "reduceOptions": {
                          "calcs": [
                            "lastNotNull"
                          ]
                        },
                        "colorMode": "none",
                        "graphMode": "none"
                      }
                    },
                    {
                      "id": 2,
                      "type": "stat",
                      "title": "Builder sessions: cost by platform, last 24 h (USD)",
                      "gridPos": {
                        "x": 8,
                        "y": 0,
                        "w": 8,
                        "h": 6
                      },
                      "targets": [
                        {
                          "expr": "sum by (platform) (increase({__name__=~\"claude_code_cost_usage.*\"}[24h]))",
                          "legendFormat": "{{ `{{platform}}` }}",
                          "refId": "A"
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {
                          "unit": "currencyUSD"
                        },
                        "overrides": []
                      },
                      "options": {
                        "reduceOptions": {
                          "calcs": [
                            "lastNotNull"
                          ]
                        },
                        "colorMode": "none",
                        "graphMode": "none"
                      }
                    },
                    {
                      "id": 3,
                      "type": "timeseries",
                      "title": "Telemetry writes by platform and status, per minute",
                      "gridPos": {
                        "x": 16,
                        "y": 0,
                        "w": 8,
                        "h": 6
                      },
                      "targets": [
                        {
                          "expr": "sum by (platform, status) (rate(infrared_telemetry_writes_total[5m])) * 60",
                          "legendFormat": "{{ `{{platform}} {{status}}` }}",
                          "refId": "A"
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {},
                        "overrides": []
                      }
                    },
                    {
                      "id": 4,
                      "type": "timeseries",
                      "title": "Step cost by platform and model, per hour (USD)",
                      "gridPos": {
                        "x": 0,
                        "y": 6,
                        "w": 12,
                        "h": 8
                      },
                      "targets": [
                        {
                          "expr": "sum by (platform, model) (increase(infrared_step_cost_usd_total[1h]))",
                          "legendFormat": "{{ `{{platform}} {{model}}` }}",
                          "refId": "A"
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {
                          "unit": "currencyUSD"
                        },
                        "overrides": []
                      }
                    },
                    {
                      "id": 5,
                      "type": "timeseries",
                      "title": "Step duration, p95 by platform",
                      "gridPos": {
                        "x": 12,
                        "y": 6,
                        "w": 12,
                        "h": 8
                      },
                      "targets": [
                        {
                          "expr": "histogram_quantile(0.95, sum by (platform, le) (rate(infrared_step_duration_seconds_bucket[1h])))",
                          "legendFormat": "{{ `{{platform}}` }}",
                          "refId": "A"
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {
                          "unit": "s"
                        },
                        "overrides": []
                      }
                    },
                    {
                      "id": 6,
                      "type": "timeseries",
                      "title": "Tokens by platform and kind, per hour",
                      "gridPos": {
                        "x": 0,
                        "y": 14,
                        "w": 12,
                        "h": 8
                      },
                      "targets": [
                        {
                          "expr": "sum by (platform, kind) (increase(infrared_step_tokens_total[1h]))",
                          "legendFormat": "{{ `{{platform}} {{kind}}` }}",
                          "refId": "A"
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {},
                        "overrides": []
                      }
                    },
                    {
                      "id": 7,
                      "type": "timeseries",
                      "title": "Step containers: peak memory working set by platform and container",
                      "gridPos": {
                        "x": 12,
                        "y": 14,
                        "w": 12,
                        "h": 8
                      },
                      "targets": [
                        {
                          "expr": "max by (platform, container) (container_memory_working_set_bytes{namespace=~\"ir-org-.*\"})",
                          "legendFormat": "{{ `{{platform}} {{container}}` }}",
                          "refId": "A"
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {
                          "unit": "bytes"
                        },
                        "overrides": []
                      }
                    },
                    {
                      "id": 8,
                      "type": "timeseries",
                      "title": "Machines: memory by platform and machine",
                      "gridPos": {
                        "x": 0,
                        "y": 22,
                        "w": 12,
                        "h": 8
                      },
                      "targets": [
                        {
                          "expr": "max by (platform, machine) (localred_machine_memory_bytes)",
                          "legendFormat": "{{ `{{platform}} {{machine}}` }}",
                          "refId": "A"
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {
                          "unit": "bytes"
                        },
                        "overrides": []
                      }
                    },
                    {
                      "id": 9,
                      "type": "timeseries",
                      "title": "vmagent remote write by platform and status code, per minute",
                      "gridPos": {
                        "x": 12,
                        "y": 22,
                        "w": 12,
                        "h": 8
                      },
                      "targets": [
                        {
                          "expr": "sum by (platform, status_code) (rate(vmagent_remotewrite_requests_total[5m])) * 60",
                          "legendFormat": "{{ `{{platform}} {{status_code}}` }}",
                          "refId": "A"
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {},
                        "overrides": []
                      }
                    }
                  ]
                }
[[- if eq .Edge "gateway" ]]
          # Requests at the edge, per zone: Envoy's own metrics for the upstream
          # of every HTTPRoute (httproute/<zone>/<route>/rule/<n>), so an app
          # needs nothing of its own. Only those families and upstreams are kept
          # (a few hundred series), with the zone and the route as labels. The
          # operator's edge-errors and edge-latency SLOs read them, and the
          # dashboard below shows them.
          - apiVersion: operator.victoriametrics.com/v1beta1
            kind: VMPodScrape
            metadata:
              name: edge-envoy
              namespace: envoy-gateway-system
            spec:
              selector:
                matchLabels:
                  app.kubernetes.io/component: proxy
                  app.kubernetes.io/managed-by: envoy-gateway
              podMetricsEndpoints:
                - port: metrics
                  path: /stats/prometheus
                  metricRelabelConfigs:
                    - action: keep
                      sourceLabels: [__name__]
                      regex: envoy_cluster_upstream_rq_(xx|total|time_bucket|time_count|time_sum)
                    - action: keep
                      sourceLabels: [envoy_cluster_name]
                      regex: httproute/.+
                    - action: replace
                      sourceLabels: [envoy_cluster_name]
                      regex: httproute/([^/]+)/([^/]+)/rule/.+
                      targetLabel: infrared_zone
                      replacement: $1
                    - action: replace
                      sourceLabels: [envoy_cluster_name]
                      regex: httproute/([^/]+)/([^/]+)/rule/.+
                      targetLabel: infrared_route
                      replacement: $2
          - apiVersion: v1
            kind: ConfigMap
            metadata:
              name: infrared-edge-zones-dashboard
              namespace: monitoring
              labels:
                # Grafana's sidecar loads every ConfigMap so labelled in monitoring.
                grafana_dashboard: "1"
            data:
              infrared-edge-zones.json: |
                {
                  "title": "Infrared zones: requests at the edge",
                  "uid": "infrared-edge-zones",
                  "schemaVersion": 39,
                  "time": {
                    "from": "now-24h",
                    "to": "now"
                  },
                  "refresh": "1m",
                  "tags": [
                    "infrared"
                  ],
                  "templating": {
                    "list": [
                      {
                        "name": "datasource",
                        "type": "datasource",
                        "query": "prometheus",
                        "current": {}
                      },
                      {
                        "name": "zone",
                        "type": "query",
                        "datasource": {
                          "type": "prometheus",
                          "uid": "${datasource}"
                        },
                        "query": "label_values(envoy_cluster_upstream_rq_total, infrared_zone)",
                        "refresh": 2,
                        "includeAll": true,
                        "multi": true,
                        "current": {
                          "text": "All",
                          "value": "$__all"
                        }
                      }
                    ]
                  },
                  "panels": [
                    {
                      "id": 1,
                      "type": "timeseries",
                      "title": "Requests per second",
                      "datasource": {
                        "type": "prometheus",
                        "uid": "${datasource}"
                      },
                      "gridPos": {
                        "h": 8,
                        "w": 24,
                        "x": 0,
                        "y": 0
                      },
                      "fieldConfig": {
                        "defaults": {
                          "unit": "reqps"
                        },
                        "overrides": []
                      },
                      "targets": [
                        {
                          "refId": "A",
                          "expr": "sum by (infrared_zone) (rate(envoy_cluster_upstream_rq_total{infrared_zone=~\"$zone\"}[5m]))",
                          "legendFormat": "{{ `{{infrared_zone}}` }}"
                        }
                      ]
                    },
                    {
                      "id": 2,
                      "type": "timeseries",
                      "title": "Server errors (5xx share)",
                      "datasource": {
                        "type": "prometheus",
                        "uid": "${datasource}"
                      },
                      "gridPos": {
                        "h": 8,
                        "w": 12,
                        "x": 0,
                        "y": 8
                      },
                      "fieldConfig": {
                        "defaults": {
                          "unit": "percentunit"
                        },
                        "overrides": []
                      },
                      "targets": [
                        {
                          "refId": "A",
                          "expr": "sum by (infrared_zone) (rate(envoy_cluster_upstream_rq_xx{infrared_zone=~\"$zone\",envoy_response_code_class=\"5\"}[5m])) / sum by (infrared_zone) (rate(envoy_cluster_upstream_rq_total{infrared_zone=~\"$zone\"}[5m]))",
                          "legendFormat": "{{ `{{infrared_zone}}` }}"
                        }
                      ]
                    },
                    {
                      "id": 3,
                      "type": "timeseries",
                      "title": "Latency p95 (ms)",
                      "datasource": {
                        "type": "prometheus",
                        "uid": "${datasource}"
                      },
                      "gridPos": {
                        "h": 8,
                        "w": 12,
                        "x": 12,
                        "y": 8
                      },
                      "fieldConfig": {
                        "defaults": {
                          "unit": "ms"
                        },
                        "overrides": []
                      },
                      "targets": [
                        {
                          "refId": "A",
                          "expr": "histogram_quantile(0.95, sum by (infrared_zone, le) (rate(envoy_cluster_upstream_rq_time_bucket{infrared_zone=~\"$zone\"}[5m])))",
                          "legendFormat": "{{ `{{infrared_zone}}` }}"
                        }
                      ]
                    }
                  ]
                }
[[- end ]]
  destination:
    server: https://kubernetes.default.svc
    namespace: monitoring
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true
      # The VictoriaMetrics operator CRDs are large.
      - ServerSideApply=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
[[- else -]]
# victoria-metrics-k8s-stack is left out: the Installation names it among its disabled
# components (INFRARED_DISABLED_COMPONENTS), so this file holds no objects.
[[- end ]]
