          # The installs dashboard (infrared-docs-internal ADR 0069, T10):
          # every install that registered with the plane, from ir install to
          # its first model call on Bedrock, by the platform label as the
          # Fleet dashboard. The series are the operator's install series
          # (infrared_install_info and the Installation's readiness and age;
          # counts of orgs, Products and people; cloud accounts by state; each
          # org's model provider; open Incidents), the API's request counter
          # for the sign-ins, and the step and model-call series by provider.
          # On the install's own Grafana it shows that install alone; on the
          # home every platform that writes. Counters use increase_pure over
          # the dashboard's range, so a new install's first hour counts from
          # its first sample; the table reads a week back, so an install that
          # went quiet stays listed with its last write's age.
          - apiVersion: v1
            kind: ConfigMap
            metadata:
              name: infrared-installs-dashboard
              namespace: monitoring
              labels:
                # Grafana's sidecar loads every ConfigMap so labelled in monitoring.
                grafana_dashboard: "1"
            data:
              infrared-installs.json: |
                {
                  "uid": "infrared-installs",
                  "title": "New installs: install to first Bedrock run",
                  "tags": [
                    "infrared"
                  ],
                  "editable": true,
                  "schemaVersion": 39,
                  "version": 1,
                  "time": {
                    "from": "now-7d",
                    "to": "now"
                  },
                  "timezone": "browser",
                  "refresh": "1m",
                  "graphTooltip": 1,
                  "description": "Every install that registered with the plane, from ir install to its first model call on Bedrock (infrared-docs-internal ADR 0069 T10). First cut, 2026-11-05: the installs by release, cloud and provider; the funnel from Ready to the first sign-in, org, Product, cloud account, run and Bedrock call; Bedrock's calls, throttles, refusals, latency, tokens and cost; the open platform Incidents. On an install's own Grafana it shows that install alone; on the home every platform.",
                  "templating": {
                    "list": [
                      {
                        "name": "platform",
                        "label": "Platform",
                        "type": "query",
                        "query": {
                          "query": "label_values(up, platform)",
                          "refId": "var"
                        },
                        "definition": "label_values(up, platform)",
                        "multi": true,
                        "includeAll": true,
                        "allValue": ".*",
                        "current": {
                          "text": "All",
                          "value": "$__all"
                        },
                        "refresh": 2,
                        "sort": 1
                      }
                    ]
                  },
                  "panels": [
                    {
                      "id": 1,
                      "type": "row",
                      "title": "Installs: every platform that registered, by release, cloud and provider (the operator's install series)",
                      "collapsed": false,
                      "gridPos": {
                        "x": 0,
                        "y": 0,
                        "w": 24,
                        "h": 1
                      },
                      "panels": []
                    },
                    {
                      "id": 2,
                      "type": "table",
                      "title": "Installs that wrote in the last 7 days",
                      "description": "One row per platform: the cluster's name, the platform release it runs, its cloud and edge, whether Bedrock is on, whether its Installation is Ready, its age since the Installation was made, and how long since its last series arrived here (its own scrape on the install's own Grafana; the plane's write path on the home).",
                      "gridPos": {
                        "x": 0,
                        "y": 1,
                        "w": 24,
                        "h": 10
                      },
                      "targets": [
                        {
                          "expr": "max by (platform, cluster, version, cloud, edge, bedrock) (last_over_time(infrared_install_info{platform=~\"$platform\"}[7d]))",
                          "legendFormat": "",
                          "refId": "A",
                          "format": "table",
                          "instant": true,
                          "range": false
                        },
                        {
                          "expr": "max by (platform) (last_over_time(infrared_installation_ready{platform=~\"$platform\"}[7d]))",
                          "legendFormat": "",
                          "refId": "B",
                          "format": "table",
                          "instant": true,
                          "range": false
                        },
                        {
                          "expr": "max by (platform) (time() - last_over_time(infrared_installation_created_timestamp_seconds{platform=~\"$platform\"}[7d]))",
                          "legendFormat": "",
                          "refId": "C",
                          "format": "table",
                          "instant": true,
                          "range": false
                        },
                        {
                          "expr": "max by (platform) (time() - timestamp(infrared_install_info{platform=~\"$platform\"}[7d]))",
                          "legendFormat": "",
                          "refId": "D",
                          "format": "table",
                          "instant": true,
                          "range": false
                        }
                      ],
                      "transformations": [
                        {
                          "id": "joinByField",
                          "options": {
                            "byField": "platform",
                            "mode": "outer"
                          }
                        },
                        {
                          "id": "filterFieldsByName",
                          "options": {
                            "include": {
                              "pattern": "^(platform|cluster|version|cloud|edge|bedrock|Value #[B-D])$"
                            }
                          }
                        },
                        {
                          "id": "organize",
                          "options": {
                            "excludeByName": {},
                            "indexByName": {
                              "platform": 0,
                              "cluster": 1,
                              "version": 2,
                              "cloud": 3,
                              "edge": 4,
                              "bedrock": 5,
                              "Value #B": 6,
                              "Value #C": 7,
                              "Value #D": 8
                            },
                            "renameByName": {
                              "platform": "Platform",
                              "cluster": "Cluster",
                              "version": "Release",
                              "cloud": "Cloud",
                              "edge": "Edge",
                              "bedrock": "Bedrock",
                              "Value #B": "Ready",
                              "Value #C": "Age",
                              "Value #D": "Last write"
                            }
                          }
                        }
                      ],
                      "fieldConfig": {
                        "defaults": {
                          "unit": "short",
                          "custom": {
                            "align": "auto",
                            "filterable": true
                          }
                        },
                        "overrides": [
                          {
                            "matcher": {
                              "id": "byName",
                              "options": "Age"
                            },
                            "properties": [
                              {
                                "id": "unit",
                                "value": "dtdurations"
                              }
                            ]
                          },
                          {
                            "matcher": {
                              "id": "byName",
                              "options": "Last write"
                            },
                            "properties": [
                              {
                                "id": "unit",
                                "value": "dtdurations"
                              }
                            ]
                          },
                          {
                            "matcher": {
                              "id": "byName",
                              "options": "Ready"
                            },
                            "properties": [
                              {
                                "id": "mappings",
                                "value": [
                                  {
                                    "type": "value",
                                    "options": {
                                      "0": {
                                        "text": "not ready"
                                      },
                                      "1": {
                                        "text": "Ready"
                                      }
                                    }
                                  }
                                ]
                              }
                            ]
                          }
                        ]
                      },
                      "options": {
                        "showHeader": true,
                        "cellHeight": "sm",
                        "footer": {
                          "show": false,
                          "reducer": [
                            "sum"
                          ],
                          "fields": ""
                        },
                        "sortBy": [
                          {
                            "displayName": "Age",
                            "desc": false
                          }
                        ]
                      }
                    },
                    {
                      "id": 3,
                      "type": "row",
                      "title": "The funnel: from Ready to the first Bedrock call, per platform",
                      "collapsed": false,
                      "gridPos": {
                        "x": 0,
                        "y": 11,
                        "w": 24,
                        "h": 1
                      },
                      "panels": []
                    },
                    {
                      "id": 4,
                      "type": "stat",
                      "title": "Ready",
                      "description": "The Installation's Ready condition (infrared_installation_ready).",
                      "gridPos": {
                        "x": 0,
