                    },
                    {
                      "id": 8,
                      "type": "row",
                      "title": "Infrared's API: requests, refusals, latency",
                      "collapsed": false,
                      "gridPos": {
                        "x": 0,
                        "y": 13,
                        "w": 24,
                        "h": 1
