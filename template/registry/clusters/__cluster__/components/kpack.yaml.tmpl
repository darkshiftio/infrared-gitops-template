apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: kpack
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
  annotations:
    argocd.argoproj.io/sync-wave: "25"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: platform
  source:
    repoURL: [[ .GitopsRepoURL ]]
    targetRevision: [[ .DefaultBranch ]]
    path: components/kpack
  destination:
    server: https://kubernetes.default.svc
    namespace: kpack
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true
      - ServerSideApply=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
