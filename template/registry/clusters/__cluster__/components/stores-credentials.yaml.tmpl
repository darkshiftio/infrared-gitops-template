[[- $on := true ]][[ range .Disabled ]][[ if eq . "stores-credentials" ]][[ $on = false ]][[ end ]][[ end ]]
[[- $copies := and .Stores .Backup.Bucket .Copies.Recipients ]]
[[- if not $on -]]
# stores-credentials is left out: the Installation names it among its disabled
# components (INFRARED_DISABLED_COMPONENTS), so this file holds no objects.
[[- else if and .Stores (or .Registry $copies) -]]
# The stores' credentials (components/stores-credentials): the
# ClusterSecretStore `infrared-stores`, which reads the Secrets the stores keep
# for their consumers in the namespace stores, each one by name, and the account
# it reads them with. A consumer copies its credential into its own namespace
[[- if and .Registry $copies ]]
# with an ExternalSecret: the registry inside the cluster, its S3 keys, and the
# Infrared chart's two encrypted copies, theirs (components/stores-credentials/
# copies.yaml).
[[- else if $copies ]]
# with an ExternalSecret: the Infrared chart's two encrypted copies, their S3
# keys (components/stores-credentials/copies.yaml).
[[- else ]]
# with an ExternalSecret: today the registry inside the cluster, its S3 keys.
[[- end ]]
# Wave 19: after SeaweedFS (18), whose keys it hands out.
#
# The namespace stores belongs to the stores' own Applications, which label it;
# this one never creates it, and its wait holds the sync until SeaweedFS's S3
# gateway answers there.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: stores-credentials
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
    infrared.darkshift.io/layer: secrets
  annotations:
    argocd.argoproj.io/sync-wave: "19"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: platform
  source:
    repoURL: [[ .GitopsRepoURL ]]
    targetRevision: [[ .DefaultBranch ]]
    path: components/stores-credentials
  destination:
    server: https://kubernetes.default.svc
    namespace: stores
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - SkipDryRunOnMissingResource=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
[[- else -]]
# The stores' credentials are handed out only to the components that use them:
# the registry inside the cluster (INFRARED_REGISTRY), with the platform's own
# stores (INFRARED_STORES). This cluster has no such consumer, so this file
# holds no objects.
[[- end ]]
