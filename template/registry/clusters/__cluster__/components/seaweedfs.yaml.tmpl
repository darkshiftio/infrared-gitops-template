[[- $on := true ]][[ range .Disabled ]][[ if eq . "seaweedfs" ]][[ $on = false ]][[ end ]][[ end ]]
[[- $restore := and .Stores .Backup.Bucket .Restore.Point ]]
[[- $prefix := default .ClusterName .Backup.Prefix ]]
[[- /* One node (StoresSingleNode, the chart's stores.singleNode): one of each server, and every file once. */ -]]
[[- $single := .StoresSingleNode ]]
[[- /* SeaweedFS's own security (StoresSecurity): mutual TLS needs cert-manager's certificates. */ -]]
[[- $certManager := true ]][[ range .Disabled ]][[ if eq . "cert-manager" ]][[ $certManager = false ]][[ end ]][[ end ]]
[[- $mtls := and .StoresSecurity $certManager ]]
[[- if not $on -]]
# seaweedfs is left out: the Installation names it among its disabled
# components (INFRARED_DISABLED_COMPONENTS), so this file holds no objects.
[[- else if .Stores -]]
# SeaweedFS 4.48 (chart 4.48.0), the platform's object store, in the namespace
# stores. Wave 18, after the Postgres (17) that holds its filer metadata.
#
[[- if $single ]]
# On the cluster's one node (the install's stores.singleNode): one master, one
# volume server with its data on the node's own disk ([[ if eq .Cloud "gcp" ]]a persistent disk that follows it[[ else ]]hostPath[[ end ]]), one
# filer and one S3 gateway. Every file is written once (replication 000):
# there is no other server to copy it to, so the node's disk is the only copy.
# The data is under /var/lib/seaweedfs on the node. The filer keeps every
# entry in the platform's Postgres (database seaweedfs).
[[- else ]]
# Across the nodes: three masters (Raft), a volume server and its data on each
# node's own disk ([[ if eq .Cloud "gcp" ]]on Google Cloud a persistent disk that follows it[[ else ]]hostPath[[ end ]]), two filers and two S3 gateways, each on a node of its own.
# Every file is written to two volume servers (replication 001), so with
# SeaweedFS stopped on any one node every object still reads; the masters copy
# what a lost node held back to two nodes (volume.fix.replication). The data is
# under /var/lib/seaweedfs on each node, never on a cloud volume. The filers
# keep every entry in the platform's Postgres (database seaweedfs).
[[- end ]]
#
# S3 at http://seaweedfs-s3.stores.svc:8333, with an identity per bucket
# (components/seaweedfs/identities.yaml). The chart's bucket hook makes the
# buckets ate-snapshots and registry after each sync.
[[- if .Backup.Bucket ]]
#
# Every hour both buckets are copied to s3://[[ .Backup.Bucket ]]/[[ $prefix ]]/seaweedfs
# (components/seaweedfs/backup.yaml), what each copy replaces kept seven days.
[[- end ]]
[[- if $restore ]]
#
# A restore, from [[ .Restore.Point ]], is in progress: a PreSync hook holds this sync
# until the Infrared chart's restore has brought Postgres's records back
# (components/seaweedfs/restore-wait.yaml), and the identity restore may write
# every bucket while the stores-restore Application copies them back.
[[- end ]]
[[- if .StoresSecurity ]]
#
# SeaweedFS takes no caller it cannot identify (the Infrared chart's
# tenancy.storesSecurity, infrared-docs-internal ADR 0066 D3): the filers'
# HTTP answers only a token signed with the keys in stores/seaweedfs-jwt, which
# the PreSync hook makes once (components/seaweedfs/prepare.yaml), and a volume
# server takes a write only with a token from the master or a filer; the
# master's HTTP API is off but its status. Each server reads its keys from its
# environment (WEED_JWT_*), never from a file in this repo; the chart's own
# key generation is off, because it would make new keys at every render.
[[- if $mtls ]] Every
# gRPC call between them is mutual TLS, with certificates from the chart's own
# CA, which cert-manager issues and renews in stores.
[[- else ]] cert-manager is
# left out of this install, so gRPC stays without TLS: only the tokens hold.
[[- end ]]
# Zot, Substrate, the copies and the restore speak S3 with their identities,
# as before. A volume server still serves a file to whoever names its id (a
# random cookie in it): SeaweedFS signs reads only without a filer.
[[- end ]]
#
# No resources finalizer: removing this Application leaves SeaweedFS running,
# and its data stays on the nodes' disks either way.
[[- /* Each volume server's persistent disk on Google Cloud (Cloud "gcp"): the registry's images, the snapshots' bundles and the backups' copies. */ -]]
[[- $seaweedfsVolumeSize := "20Gi" ]]
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: seaweedfs
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
    infrared.darkshift.io/layer: object-storage
  annotations:
    argocd.argoproj.io/sync-wave: "18"
spec:
  project: platform
  sources:
    # The S3 keys, the wait for Postgres and the S3 identities[[ if .Backup.Bucket ]], and the hourly copy[[ end ]].
    - repoURL: [[ .GitopsRepoURL ]]
      targetRevision: [[ .DefaultBranch ]]
      path: components/seaweedfs
    - repoURL: https://seaweedfs.github.io/seaweedfs/helm
      chart: seaweedfs
      targetRevision: 4.48.0
      helm:
        releaseName: seaweedfs
        valuesObject:
          global:
            seaweedfs:
              # The chart's ClusterRole may edit any pod in the cluster; nothing
              # here needs it.
              createClusterRole: false
[[- if $single ]]
              # One volume server: every file once (the masters' default, 000).
              enableReplication: false
[[- else ]]
              # Every file on two volume servers: another server in the same
              # rack, and each server is on a node of its own.
              enableReplication: true
              replicationPlacement: "001"
[[- end ]]
[[- if $mtls ]]
              # Mutual TLS on every gRPC call: the chart's CA and certificates,
              # issued by cert-manager in stores.
              enableSecurity: true
[[- end ]]
[[- if .StoresSecurity ]]
              # The tokens' keys come from stores/seaweedfs-jwt by environment
              # (below): the chart's would be new at every render.
              securityConfig:
                jwtSigning:
                  volumeWrite: false
                  volumeRead: false
                  filerWrite: false
                  filerRead: false
[[- end ]]
          image:
            registry: docker.io
            tag: "4.48@sha256:4e61d15fd35994cb1e43e1e553dff106794841fd9a99ade2fc8c8bfce4d7872d"
          master:
            replicas: [[ if $single ]]1[[ else ]]3[[ end ]]
[[- if eq .Cloud "gcp" ]]
            # On Google Cloud every server's data is a persistent disk of the
            # cluster's default class, which follows its pod to whichever node
            # it lands on: replacing the nodes (a resize, GKE's own upgrades)
            # takes nothing with it. Elsewhere the data stays on each node's own
            # disk (hostPath), where a replaced node's copies are remade from
            # the other servers (volume.fix.replication, below).
            data:
              type: persistentVolumeClaim
              size: 2Gi
              storageClass: ""
[[- else ]]
            data:
              type: hostPath
              hostPathPrefix: /var/lib/seaweedfs
[[- end ]]
            logs:
              type: ""
[[- if $single ]]
            # Every 17 minutes: empty volumes and stale uploads go. With every
            # file written once, volume.fix.replication finds nothing to copy.
[[- else ]]
            # The leader copies under-replicated volumes back to two servers,
            # e.g. after a node is replaced, every 17 minutes. No erasure
            # coding: it needs more servers than three nodes give.
[[- end ]]
            config: |-
              [master.maintenance]
              scripts = """
                lock
                volume.deleteEmpty -quietFor=24h -apply
                volume.fix.replication -apply
                s3.clean.uploads -timeAgo=24h
                unlock
              """
              sleep_minutes = 17
[[- if .StoresSecurity ]]
            # No HTTP API (assign, lookup, collection delete, grow, vacuum):
            # gRPC only. /cluster/status, which the probes ask, stays.
            disableHttp: true
            extraEnvironmentVars:
              WEED_JWT_SIGNING_KEY:
                secretKeyRef:
                  name: seaweedfs-jwt
                  key: volume-write
[[- end ]]
            resources:
              requests:
                cpu: 20m
                memory: 64Mi
              limits:
                memory: 512Mi
          volume:
            replicas: [[ if $single ]]1[[ else ]]3[[ end ]]
            dataDirs:
              - name: data
[[- if eq .Cloud "gcp" ]]
                type: persistentVolumeClaim
                size: [[ $seaweedfsVolumeSize ]]
                storageClass: ""
[[- else ]]
                type: hostPath
                hostPathPrefix: /var/lib/seaweedfs
[[- end ]]
                # Slots, not space. 0 sized them as the disk over the 1000 MB
                # volume limit (19 on 20Gi), and every collection's nearly
                # empty volumes took one each, so the registry ran out of
                # slots with the disks half full (infrared-cp-google,
                # 2026-10-16). minFreeSpacePercent below guards the disk.
                maxVolumes: 1000
[[- if eq .Cloud "gcp" ]]
            # The chart's resize Job runs an unpinned image; a disk is grown by
            # hand (troubleshooting runbook) rather than on a size change here.
            resizeHook:
              enabled: false
[[- end ]]
            # Read-only below 10% free, well before the kubelet evicts pods.
            minFreeSpacePercent: 10
[[- if .StoresSecurity ]]
            # A write or a delete needs a token the master or a filer signed.
            extraEnvironmentVars:
              WEED_JWT_SIGNING_KEY:
                secretKeyRef:
                  name: seaweedfs-jwt
                  key: volume-write
[[- end ]]
            resources:
              requests:
                cpu: 50m
                memory: 128Mi
              limits:
                memory: 1Gi
          filer:
            replicas: [[ if $single ]]1[[ else ]]2[[ end ]]
            data:
              type: emptyDir
            logs:
              type: ""
            extraEnvironmentVars:
              # The filer store is the platform's Postgres, not a local LevelDB.
              WEED_LEVELDB2_ENABLED: "false"
              WEED_POSTGRES2_ENABLED: "true"
              WEED_POSTGRES2_HOSTNAME: postgres-rw.stores.svc
              WEED_POSTGRES2_PORT: "5432"
              WEED_POSTGRES2_DATABASE: seaweedfs
              WEED_POSTGRES2_SSLMODE: require
              WEED_POSTGRES2_CONNECTION_MAX_IDLE: "20"
[[- if .StoresSecurity ]]
              # No directory listing over HTTP.
              WEED_FILER_EXPOSE_DIRECTORY_METADATA_ENABLED: "false"
[[- end ]]
            secretExtraEnvironmentVars:
              WEED_POSTGRES2_USERNAME:
                secretKeyRef:
                  name: postgres-seaweedfs
                  key: username
              WEED_POSTGRES2_PASSWORD:
                secretKeyRef:
                  name: postgres-seaweedfs
                  key: password
[[- if .StoresSecurity ]]
              # Its HTTP takes a write or a read only with a token signed with
              # these, as the S3 gateways sign theirs; it signs volume writes.
              WEED_JWT_FILER_SIGNING_KEY:
                secretKeyRef:
                  name: seaweedfs-jwt
                  key: filer-write
              WEED_JWT_FILER_SIGNING_READ_KEY:
                secretKeyRef:
                  name: seaweedfs-jwt
                  key: filer-read
              WEED_JWT_SIGNING_KEY:
                secretKeyRef:
                  name: seaweedfs-jwt
                  key: volume-write
            # The chart probes GET /, a listing the read key refuses.
            livenessProbe:
              httpGet:
                path: /healthz
            readinessProbe:
              httpGet:
                path: /readyz
[[- end ]]
            resources:
              requests:
                cpu: 50m
                memory: 128Mi
              limits:
                memory: 1Gi
          s3:
            enabled: true
            replicas: [[ if $single ]]1[[ else ]]2[[ end ]]
            enableAuth: true
            existingConfigSecret: seaweedfs-s3-identities
            # Lance's namespace server is not used.
            lancePort: 0
            logs:
              type: ""
            affinity: |
              podAntiAffinity:
                requiredDuringSchedulingIgnoredDuringExecution:
                  - labelSelector:
                      matchLabels:
                        app.kubernetes.io/name: seaweedfs
                        app.kubernetes.io/instance: seaweedfs
                        app.kubernetes.io/component: s3
                    topologyKey: kubernetes.io/hostname
            # The gateway reads the identities file once, at start: a new set of
            # identities is a new value here, so the gateways roll.
            podAnnotations:
              infrared.darkshift.io/s3-identities: ate-snapshots registry[[ if .Backup.Bucket ]] backup[[ end ]][[ if $restore ]] restore[[ end ]]
            extraEnvironmentVars:
              S3_ATE_SNAPSHOTS_ACCESS_KEY_ID:
                secretKeyRef:
                  name: seaweedfs-s3-ate-snapshots
                  key: AWS_ACCESS_KEY_ID
              S3_ATE_SNAPSHOTS_SECRET_ACCESS_KEY:
                secretKeyRef:
                  name: seaweedfs-s3-ate-snapshots
                  key: AWS_SECRET_ACCESS_KEY
              S3_REGISTRY_ACCESS_KEY_ID:
                secretKeyRef:
                  name: seaweedfs-s3-registry
                  key: AWS_ACCESS_KEY_ID
              S3_REGISTRY_SECRET_ACCESS_KEY:
                secretKeyRef:
                  name: seaweedfs-s3-registry
                  key: AWS_SECRET_ACCESS_KEY
[[- if .Backup.Bucket ]]
              S3_BACKUP_ACCESS_KEY_ID:
                secretKeyRef:
                  name: seaweedfs-s3-backup
                  key: AWS_ACCESS_KEY_ID
              S3_BACKUP_SECRET_ACCESS_KEY:
                secretKeyRef:
                  name: seaweedfs-s3-backup
                  key: AWS_SECRET_ACCESS_KEY
[[- end ]]
[[- if $restore ]]
              S3_RESTORE_ACCESS_KEY_ID:
                secretKeyRef:
                  name: seaweedfs-s3-restore
                  key: AWS_ACCESS_KEY_ID
              S3_RESTORE_SECRET_ACCESS_KEY:
                secretKeyRef:
                  name: seaweedfs-s3-restore
                  key: AWS_SECRET_ACCESS_KEY
[[- end ]]
[[- if .StoresSecurity ]]
              # The tokens the gateway signs its filer calls with.
              WEED_JWT_FILER_SIGNING_KEY:
                secretKeyRef:
                  name: seaweedfs-jwt
                  key: filer-write
              WEED_JWT_FILER_SIGNING_READ_KEY:
                secretKeyRef:
                  name: seaweedfs-jwt
                  key: filer-read
[[- end ]]
            createBuckets:
              - name: ate-snapshots
              - name: registry
            # The gateway holds each upload's parts in memory: at 512Mi it was
            # OOMKilled while eight image builds pushed their layers at once
            # (2026-10-16).
            resources:
              requests:
                cpu: 20m
                memory: 128Mi
              limits:
                memory: 1536Mi
  destination:
    server: https://kubernetes.default.svc
    namespace: stores
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    # The masters and volume servers keep their data on the node (hostPath),
    # which Pod Security baseline forbids.
    managedNamespaceMetadata:
      labels:
        pod-security.kubernetes.io/enforce: privileged
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true
      - ServerSideApply=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
[[- else -]]
# SeaweedFS runs only with the platform's own stores (the operator's
# INFRARED_STORES), so this file holds no objects.
[[- end ]]
