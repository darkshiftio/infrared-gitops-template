[[- $on := true ]][[ range .Disabled ]][[ if eq . "substrate-crds" ]][[ $on = false ]][[ end ]][[ end ]]
[[- if not $on -]]
# substrate-crds is left out: the Installation names it among its disabled
# components (INFRARED_DISABLED_COMPONENTS), so this file holds no objects.
[[- else if and .Stores .SubstrateCapable .Registry -]]
# Agent Substrate 1.0, the agent runtime, arrives in four Applications, waves
# 20 to 23, each labelled infrared.darkshift.io/layer: agent-runtime:
#
#   20  substrate-crds     its CRDs and the admission policy on SandboxConfigs
#   21  substrate-podcert  the pod-certificate controller and its three CAs
#   22  substrate          the control plane: API, identity provider,
#                          controller, atelet, router, egress, and the policies
#                          that admit only Infrared's operator and Substrate
#                          itself to the API and the router
#   23  substrate-actors   the namespace of the platform's worker pools
#
# This is the first (components/substrate-crds): WorkerPool, SandboxConfig and
# CSIDriverConfig at ate.dev/v1, vendored from the pinned release. A PreSync
# hook first retires any of them an install before Substrate 1.0 left at
# ate.dev/v1alpha1, with every object of its kind; it runs in ate-system, which
# this Application makes when it is missing, without managing its labels (the
# substrate Application does). Each later one waits, in a PreSync hook, for
# what it needs from the one before it.
#
# No resources finalizer: removing this Application leaves the CRDs, and with
# them every WorkerPool and SandboxConfig.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: substrate-crds
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
    infrared.darkshift.io/layer: agent-runtime
  annotations:
    argocd.argoproj.io/sync-wave: "20"
spec:
  project: platform
  source:
    repoURL: [[ .GitopsRepoURL ]]
    targetRevision: [[ .DefaultBranch ]]
    path: components/substrate-crds
  destination:
    server: https://kubernetes.default.svc
    # Everything here is cluster-scoped but the hook, which runs in the control
    # plane's namespace; the `substrate` Application labels it.
    namespace: ate-system
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true
      - ServerSideApply=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
[[- else -]]
# Agent Substrate runs only where the operator's preflight found the cluster able
# to host it (SubstrateCapable), with the platform's own stores (INFRARED_STORES)
# and the registry inside the cluster (INFRARED_REGISTRY), so this file holds no
# objects.
[[- end ]]
