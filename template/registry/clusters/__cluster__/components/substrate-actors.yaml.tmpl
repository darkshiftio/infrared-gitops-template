[[- $on := true ]][[ range .Disabled ]][[ if eq . "substrate-actors" ]][[ $on = false ]][[ end ]][[ end ]]
[[- if not $on -]]
# substrate-actors is left out: the Installation names it among its disabled
# components (INFRARED_DISABLED_COMPONENTS), so this file holds no objects.
[[- else if and .Stores .SubstrateCapable .Registry -]]
# The namespace of the platform's worker pools on Agent Substrate
# (components/substrate-actors), ate-workers, with its wait and, where the
# install names one, its copy of the pull secret. Wave 23, after the control
# plane (22). Substrate 1.0 runs no WorkerPool here yet; the agents' pool comes
# with its own setting.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: substrate-actors
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
    infrared.darkshift.io/layer: agent-runtime
  annotations:
    argocd.argoproj.io/sync-wave: "23"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: platform
  source:
    repoURL: [[ .GitopsRepoURL ]]
    targetRevision: [[ .DefaultBranch ]]
    path: components/substrate-actors
  destination:
    server: https://kubernetes.default.svc
    namespace: ate-workers
[[- if .AgentPool ]][[ if .AgentPool.MaxWorkers ]]
  # The agents' pool is elastic (the chart's runner.actors.maxWorkers): its
  # replicas are Infrared's operator's to set, which the pool's scale
  # subresource does. Argo CD shows no drift for them, and a sync keeps what
  # the operator set; the operator sizes the pool only while this says so.
  ignoreDifferences:
    - group: ate.dev
      kind: WorkerPool
      name: agents
      namespace: ate-workers
      jsonPointers:
        - /spec/replicas
[[- end ]][[ end ]]
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    # Worker pods run as root with the capabilities gVisor needs, unconfined,
    # on the node's own paths.
    managedNamespaceMetadata:
      labels:
        pod-security.kubernetes.io/enforce: privileged
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true
[[- if .AgentPool ]][[ if .AgentPool.MaxWorkers ]]
      - RespectIgnoreDifferences=true
[[- end ]][[ end ]]
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
[[- else -]]
# Agent Substrate runs only where the operator's preflight found the cluster able
# to host it (SubstrateCapable), with the platform's own stores (INFRARED_STORES)
# and the registry inside the cluster (INFRARED_REGISTRY), so this file holds no
# objects.
[[- end ]]
