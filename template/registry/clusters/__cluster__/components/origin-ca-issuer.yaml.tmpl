[[- $on := true ]][[ range .Disabled ]][[ if eq . "origin-ca-issuer" ]][[ $on = false ]][[ end ]][[ end ]]
[[- if not $on -]]
# origin-ca-issuer is left out: the Installation names it among its disabled
# components (INFRARED_DISABLED_COMPONENTS), so this file holds no objects.
[[- else if eq .Edge "gateway" -]]
# Cloudflare's origin issuer (origin-ca-issuer v0.15.0): a cert-manager issuer
# that has Cloudflare's Origin CA sign the edge's certificate. Cloudflare trusts
# those certificates and nothing else does, so every name served with one is
# proxied by Cloudflare. Wave 11, after cert-manager (10).
#
# The chart ships no CRDs: they come from the issuer's repository at the same
# tag. The issuer itself, an OriginIssuer next to the Gateway, and its token
# are the `edge` Application's (wave 13).
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: origin-ca-issuer
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
    infrared.darkshift.io/layer: edge
  annotations:
    argocd.argoproj.io/sync-wave: "11"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: platform
  sources:
    # OriginIssuer and ClusterOriginIssuer.
    - repoURL: https://github.com/cloudflare/origin-ca-issuer
      targetRevision: v0.15.0
      path: deploy/crds
    - repoURL: ghcr.io/cloudflare/origin-ca-issuer-charts
      chart: origin-ca-issuer
      targetRevision: 0.6.10
      helm:
        releaseName: origin-ca-issuer
        valuesObject:
          controller:
            image:
              # The chart's default is Always: a pull from Docker Hub on every start.
              pullPolicy: IfNotPresent
            # The chart reserves a whole CPU; the controller idles at a few millicores.
            resources:
              requests:
                cpu: 20m
                memory: 64Mi
              limits:
                cpu: 500m
                memory: 256Mi
          # Lets cert-manager's approver approve this issuer's CertificateRequests.
          certmanager:
            namespace: cert-manager
            serviceAccountName: cert-manager
  destination:
    server: https://kubernetes.default.svc
    namespace: origin-ca-issuer
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true
      - ServerSideApply=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
[[- else -]]
# Cloudflare's origin issuer is installed only when the edge is a Gateway (the
# Installation's spec.edge: gateway). This cluster's edge is Traefik, so this
# file holds no objects.
[[- end ]]
