# The Infrared control plane itself: operator, api, ui and mcp.
#
# The first `helm install` of the chart created this release and bootstrapped
# this repo; this Application adopts it. Argo CD renders the chart with
# `helm template`, where `lookup` returns nothing, so the chart would mint new
# random Secrets on every render. The existingSecret values below tell it the
# Secrets already exist, so adoption never rotates them.
#
# The org's own chart values go in registry/clusters/[[ .ClusterName ]]/values/infrared.yaml,
# not here: Infrared re-renders this file when it upgrades its template, but it
# never writes that one. It is optional, and the values set below win over it.
#
# Upgrade Infrared with a pull request that changes the chart's targetRevision
# (the first source), never with `helm upgrade`.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: infrared
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
  annotations:
    argocd.argoproj.io/sync-wave: "40"
spec:
  project: infrared
  sources:
    # An OCI helm repository: no oci:// prefix. The chart is public on ghcr and
    # components/argocd registers the repository (no credentials); the operator
    # adds argocd/infrared-oci-charts only when an image pull secret is set.
    # OCI charts use the bare chart version; the pin changes in PRs.
    - repoURL: [[ .InfraredChartRepo ]]
      chart: infrared
      targetRevision: [[ .InfraredChartVersion ]]
      helm:
        releaseName: infrared
        # The org's values file, from the second source.
        valueFiles:
          - $values/registry/clusters/[[ .ClusterName ]]/values/infrared.yaml
        ignoreMissingValueFiles: true
        valuesObject:
          managementCluster:
            name: [[ .ClusterName ]]
          gitops:
            templateVersion: [[ .TemplateVersion ]]
[[- if .ImagePullSecret ]]
          imagePullSecrets:
            - name: [[ .ImagePullSecret ]]
[[- else ]]
          imagePullSecrets: []
[[- end ]]
          setup:
            existingSecret: infrared-setup
          session:
            existingSecret: infrared-session
          mcp:
            existingSecret: infrared-mcp-token
            # The bearer token MCP clients send to /mcp.
            access:
              existingSecret: infrared-mcp-access
          # The registry prefix kpack builds product images into; empty leaves
          # the builds component out. Rendered from the operator's own
          # INFRARED_BUILD_REGISTRY so adoption keeps it.
          builds:
            registry: [[ .BuildRegistry | quote ]]
    # This gitops repo, only as $values for the file above.
    - repoURL: [[ .GitopsRepoURL ]]
      targetRevision: [[ .DefaultBranch ]]
      ref: values
  destination:
    server: https://kubernetes.default.svc
    namespace: [[ .InfraredNamespace ]]
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true
      - ServerSideApply=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
