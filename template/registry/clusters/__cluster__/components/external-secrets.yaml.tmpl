[[- $on := true ]][[ range .Disabled ]][[ if eq . "external-secrets" ]][[ $on = false ]][[ end ]][[ end ]]
[[- if $on -]]
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: external-secrets
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
  annotations:
    argocd.argoproj.io/sync-wave: "10"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: platform
  source:
    repoURL: https://charts.external-secrets.io
    chart: external-secrets
    targetRevision: 2.11.0
    helm:
      releaseName: external-secrets
      valuesObject:
        installCRDs: true
[[- if .NetworkPolicies ]]
        # The network fence (INFRARED_NETWORK_POLICIES, README "The network
        # fence"): the platform reaches External Secrets, and the control plane
        # its webhook; no org's namespace or zone does.
        extraObjects:
          - |
            apiVersion: networking.k8s.io/v1
            kind: NetworkPolicy
            metadata:
              name: infrared-fence
              namespace: external-secrets
            spec:
              podSelector: {}
              policyTypes:
                - Ingress
              ingress:
                # The platform: every namespace that is neither an org's nor a zone.
                - from:
                    - namespaceSelector:
                        matchExpressions:
                          - key: infrared.darkshift.io/org
                            operator: DoesNotExist
                          - key: infrared.darkshift.io/zone
                            operator: DoesNotExist
                # External Secrets' webhook: from the control plane, whatever path it takes.
                - ports:
                    - protocol: TCP
                      port: 10250
[[- end ]]
  destination:
    server: https://kubernetes.default.svc
    namespace: external-secrets
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true
      # The external-secrets CRDs outgrow the last-applied annotation.
      - ServerSideApply=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
[[- else -]]
# external-secrets is left out: the Installation names it among its disabled
# components (INFRARED_DISABLED_COMPONENTS), so this file holds no objects.
[[- end ]]
