[[- $on := true ]][[ range .Disabled ]][[ if eq . "cert-manager" ]][[ $on = false ]][[ end ]][[ end ]]
[[- if $on -]]
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cert-manager
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
  annotations:
    argocd.argoproj.io/sync-wave: "10"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: platform
  source:
    repoURL: https://charts.jetstack.io
    chart: cert-manager
    targetRevision: v1.21.2
    helm:
      releaseName: cert-manager
      valuesObject:
        # installCRDs is the deprecated spelling of crds.enabled.
        crds:
          enabled: true
          keep: true
        resources:
          requests:
            cpu: 10m
            memory: 64Mi
  destination:
    server: https://kubernetes.default.svc
    namespace: cert-manager
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true
      - ServerSideApply=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
[[- else -]]
# cert-manager is left out: the Installation names it among its disabled
# components (INFRARED_DISABLED_COMPONENTS), so this file holds no objects.
[[- end ]]
