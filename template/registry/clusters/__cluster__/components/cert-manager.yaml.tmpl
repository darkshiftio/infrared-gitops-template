[[- $on := true ]][[ range .Disabled ]][[ if eq . "cert-manager" ]][[ $on = false ]][[ end ]][[ end ]]
[[- if $on -]]
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: cert-manager
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
  annotations:
    argocd.argoproj.io/sync-wave: "10"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: platform
  source:
    repoURL: https://charts.jetstack.io
    chart: cert-manager
    targetRevision: v1.21.2
    helm:
      releaseName: cert-manager
      valuesObject:
        # installCRDs is the deprecated spelling of crds.enabled.
        crds:
          enabled: true
          keep: true
        resources:
          requests:
            cpu: 10m
            memory: 64Mi
[[- if and (eq .Edge "gateway") .CustomHostnames ]]
        # The HTTP-01 challenges of custom hostnames' origin certificates are
        # routes on the edge Gateway (components/edge, Issuer letsencrypt-http).
        config:
          apiVersion: controller.config.cert-manager.io/v1alpha1
          kind: ControllerConfiguration
          enableGatewayAPI: true
[[- end ]]
[[- if .NetworkPolicies ]]
        # The network fence (INFRARED_NETWORK_POLICIES, README "The network
        # fence"): the platform reaches cert-manager, and the control plane its
        # webhook; no org's namespace or zone does.
        extraObjects:
          - |
            apiVersion: networking.k8s.io/v1
            kind: NetworkPolicy
            metadata:
              name: infrared-fence
              namespace: cert-manager
            spec:
              podSelector: {}
              policyTypes:
                - Ingress
              ingress:
                # The platform: every namespace that is neither an org's nor a zone.
                - from:
                    - namespaceSelector:
                        matchExpressions:
                          - key: infrared.darkshift.io/org
                            operator: DoesNotExist
                          - key: infrared.darkshift.io/zone
                            operator: DoesNotExist
                # cert-manager's webhook: from the control plane, whatever path it takes.
                - ports:
                    - protocol: TCP
                      port: 10250
[[- end ]]
  destination:
    server: https://kubernetes.default.svc
    namespace: cert-manager
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      - SkipDryRunOnMissingResource=true
      - ServerSideApply=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
[[- else -]]
# cert-manager is left out: the Installation names it among its disabled
# components (INFRARED_DISABLED_COMPONENTS), so this file holds no objects.
[[- end ]]
