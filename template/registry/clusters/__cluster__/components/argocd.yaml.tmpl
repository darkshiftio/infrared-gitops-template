# Argo CD managing itself, from the same components/argocd the operator applied
# at bootstrap. Last, so a bad Argo CD change cannot block the platform.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: argocd
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
  annotations:
    argocd.argoproj.io/sync-wave: "100"
spec:
  project: platform
  source:
    repoURL: [[ .GitopsRepoURL ]]
    targetRevision: [[ .DefaultBranch ]]
    path: components/argocd
[[- if .NetworkPolicies ]]
    # The network fence (INFRARED_NETWORK_POLICIES, README "The network
    # fence"). Argo CD's own policies admit every namespace to its server, and
    # to the metrics of its controller (whose argocd_app_info names every
    # org's Applications), repo server, ApplicationSet controller, Dex and
    # notifications. Here each admits the platform alone: no org's namespace
    # or zone. A port-forward comes from the node and still works. Each patch
    # tests the upstream value first, so an Argo CD bump that moves it fails
    # the sync rather than patching the wrong rule.
    kustomize:
      patches:
        - target:
            group: networking.k8s.io
            version: v1
            kind: NetworkPolicy
            name: argocd-server-network-policy
          patch: |-
            - op: test
              path: /spec/ingress
              value: [{}]
            - op: replace
              path: /spec/ingress
              value:
                - from:
                    - namespaceSelector:
                        matchExpressions:
                          - key: infrared.darkshift.io/org
                            operator: DoesNotExist
                          - key: infrared.darkshift.io/zone
                            operator: DoesNotExist
        - target:
            group: networking.k8s.io
            version: v1
            kind: NetworkPolicy
            name: argocd-application-controller-network-policy
          patch: |-
            - op: test
              path: /spec/ingress/0/from/0/namespaceSelector
              value: {}
            - op: replace
              path: /spec/ingress/0/from/0/namespaceSelector
              value:
                matchExpressions:
                  - key: infrared.darkshift.io/org
                    operator: DoesNotExist
                  - key: infrared.darkshift.io/zone
                    operator: DoesNotExist
        - target:
            group: networking.k8s.io
            version: v1
            kind: NetworkPolicy
            name: argocd-applicationset-controller-network-policy
          patch: |-
            - op: test
              path: /spec/ingress/0/from/0/namespaceSelector
              value: {}
            - op: replace
              path: /spec/ingress/0/from/0/namespaceSelector
              value:
                matchExpressions:
                  - key: infrared.darkshift.io/org
                    operator: DoesNotExist
                  - key: infrared.darkshift.io/zone
                    operator: DoesNotExist
        - target:
            group: networking.k8s.io
            version: v1
            kind: NetworkPolicy
            name: argocd-dex-server-network-policy
          patch: |-
            - op: test
              path: /spec/ingress/1/from/0/namespaceSelector
              value: {}
            - op: replace
              path: /spec/ingress/1/from/0/namespaceSelector
              value:
                matchExpressions:
                  - key: infrared.darkshift.io/org
                    operator: DoesNotExist
                  - key: infrared.darkshift.io/zone
                    operator: DoesNotExist
        - target:
            group: networking.k8s.io
            version: v1
            kind: NetworkPolicy
            name: argocd-notifications-controller-network-policy
          patch: |-
            - op: test
              path: /spec/ingress/0/from/0/namespaceSelector
              value: {}
            - op: replace
              path: /spec/ingress/0/from/0/namespaceSelector
              value:
                matchExpressions:
                  - key: infrared.darkshift.io/org
                    operator: DoesNotExist
                  - key: infrared.darkshift.io/zone
                    operator: DoesNotExist
        - target:
            group: networking.k8s.io
            version: v1
            kind: NetworkPolicy
            name: argocd-repo-server-network-policy
          patch: |-
            - op: test
              path: /spec/ingress/1/from/0/namespaceSelector
              value: {}
            - op: replace
              path: /spec/ingress/1/from/0/namespaceSelector
              value:
                matchExpressions:
                  - key: infrared.darkshift.io/org
                    operator: DoesNotExist
                  - key: infrared.darkshift.io/zone
                    operator: DoesNotExist
[[- end ]]
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      # Never prune Argo CD's own objects automatically: one bad commit must
      # not be able to delete the thing that would roll it back.
      prune: false
      selfHeal: true
    syncOptions:
      - SkipDryRunOnMissingResource=true
      # Argo CD's CRDs outgrow the last-applied annotation.
      - ServerSideApply=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
