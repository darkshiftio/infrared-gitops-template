# The root app-of-apps for management cluster [[ .ClusterName ]].
# Rendered by the Infrared operator from infrared-gitops-template [[ .TemplateVersion ]].
#
# The operator applies this once, right after it applies components/argocd.
# From then on everything under components/ next to this file is an
# Application this one owns, synced in sync-wave order.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: registry-[[ .ClusterName ]]
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
spec:
  project: default
  source:
    repoURL: [[ .GitopsRepoURL ]]
    targetRevision: [[ .DefaultBranch ]]
    path: registry/clusters/[[ .ClusterName ]]/components
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  # Argo CD adds its own finalizers to child Applications, e.g.
  # pre-delete-finalizer.argocd.argoproj.io when a chart has pre-delete hooks
  # (victoria-metrics-k8s-stack). Without this the root app would be OutOfSync
  # forever: self-heal strips them and Argo CD adds them back.
  ignoreDifferences:
    - group: argoproj.io
      kind: Application
      jsonPointers:
        - /metadata/finalizers
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - RespectIgnoreDifferences=true
    retry:
      limit: 5
      backoff:
        duration: 10s
        factor: 2
        maxDuration: 3m
