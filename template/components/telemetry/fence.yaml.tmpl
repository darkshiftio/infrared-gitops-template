[[- $on := true ]][[ range .Disabled ]][[ if eq . "telemetry" ]][[ $on = false ]][[ end ]][[ end ]]
[[- $metrics := true ]][[ range .Disabled ]][[ if eq . "victoria-metrics-k8s-stack" ]][[ $metrics = false ]][[ end ]][[ end ]]
[[- if and .NetworkPolicies $on .Telemetry.URL (not $metrics) -]]
# =============================================================================
# The network fence (INFRARED_NETWORK_POLICIES, infrared-docs-internal ADR 0066
# D1; README "The network fence"): the telemetry vmagent's namespace, monitoring,
# without the metrics stack.
# =============================================================================
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: infrared-fence
  namespace: monitoring
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
spec:
  podSelector: {}
  policyTypes:
    - Ingress
  ingress:
    # The platform: every namespace that is neither an org's nor a zone.
    - from:
        - namespaceSelector:
            matchExpressions:
              - key: infrared.darkshift.io/org
                operator: DoesNotExist
              - key: infrared.darkshift.io/zone
                operator: DoesNotExist
[[- else -]]
# The network fence is off (INFRARED_NETWORK_POLICIES), or the telemetry vmagent is not
# rendered here: this file holds no objects.
[[- end ]]
