[[- $on := true ]][[ range .Disabled ]][[ if eq . "telemetry" ]][[ $on = false ]][[ end ]][[ end ]]
[[- $metrics := true ]][[ range .Disabled ]][[ if eq . "victoria-metrics-k8s-stack" ]][[ $metrics = false ]][[ end ]][[ end ]]
[[- if and $on .Telemetry.URL (not $metrics) -]]
# One vmagent for a stack without the metrics stack: it scrapes, takes
# OpenTelemetry metrics, and remote-writes to the telemetry plane
# ([[ .Telemetry.URL ]]) as platform [[ .Telemetry.Platform ]].
#
#   scrapes   every Endpoints port named metrics in [[ .InfraredNamespace ]]
#             (the API's and the operator's, which the chart names so), every
#             30 s, keeping only what the Fleet dashboard reads and a few
#             series beside it; the kubelet's cAdvisor series for the org
#             namespaces (ir-org-*), memory working set and CPU seconds by pod
#             and container, with the id, name and image labels dropped,
#             every 10 s; and itself, every 30 s, keeping only the health of
#             its writes
#   takes     OpenTelemetry metrics at :8429/opentelemetry/v1/metrics, named
#             the Prometheus way (claude_code.cost.usage becomes
#             claude_code_cost_usage), from the person's Claude Code sessions
#             and the localred app
#   drops     user.email, user.id and organization.id, which Claude Code puts
#             on every series (localred finding K1): the platform label is the
#             only identity that leaves the Mac
#   writes    with the bearer token in the Secret telemetry-token (key token),
#             which `ir local telemetry connect` writes and this repo never
#             holds; the labels platform and cluster on every series; a disk
#             buffer of up to 800 MiB on a 1 Gi claim, so a Mac shut for a
#             while flushes when it wakes; at most 50,000 new series an hour
#
# The series budget (localred finding O7). Before the keep lists a Mac's
# stack sent about 4,100 series: 4,105 in the first proof, 2026-10-14, of
# which 2,878 were the job infrared (the operator's whole controller-runtime,
# workqueue, Go and process registry beside Infrared's own infrared_* series
# and the API's), 1,211 were vmagent's own, 8 were cAdvisor's and 8 the
# localred app's. The lists keep what the Fleet dashboard names for the two
# jobs and a few series beside it (reconcile errors and times, workqueue adds,
# CPU, heap and goroutines, the push queue's drops). On the proof's stack an
# hour later, 4,567 series before (3,327 infrared, 1,224 vmagent, 8 and 8) and
# 2,180 after (2,133 infrared, 31 vmagent, 8 and 8); the proof's 4,105 would
# have been about 1,800. What is left grows with use, not with the registry:
# the operator's reconcile-time histogram (820 series) and the API's latency
# histogram (689) are the two largest, and only the second is read by the
# dashboard. The up and scrape_* series vmagent makes for each target bypass
# metric_relabel_configs, so they are in the lists only to say they are
# wanted. The cAdvisor job keeps two families for ir-org-* pods already, and
# the OpenTelemetry and import paths carry what the person's sessions (13
# series each) and the localred app (8) send; none of them is trimmed here.
apiVersion: v1
kind: ServiceAccount
metadata:
  name: vmagent
  namespace: monitoring
  labels:
    app.kubernetes.io/name: vmagent
    app.kubernetes.io/part-of: infrared-gitops
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: telemetry-vmagent
  labels:
    app.kubernetes.io/name: vmagent
    app.kubernetes.io/part-of: infrared-gitops
rules:
  - apiGroups: [""]
    resources: [nodes, nodes/metrics, nodes/proxy, services, endpoints, pods]
    verbs: [get, list, watch]
  - nonResourceURLs: [/metrics, /metrics/cadvisor]
    verbs: [get]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: telemetry-vmagent
  labels:
    app.kubernetes.io/name: vmagent
    app.kubernetes.io/part-of: infrared-gitops
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: telemetry-vmagent
subjects:
  - kind: ServiceAccount
    name: vmagent
    namespace: monitoring
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: vmagent-config
  namespace: monitoring
  labels:
    app.kubernetes.io/name: vmagent
    app.kubernetes.io/part-of: infrared-gitops
data:
  scrape.yaml: |
    global:
      scrape_interval: 30s
    scrape_configs:
      - job_name: infrared
        kubernetes_sd_configs:
          - role: endpoints
            namespaces:
              names: ["[[ .InfraredNamespace ]]"]
        relabel_configs:
          - action: keep
            source_labels: [__meta_kubernetes_endpoint_port_name]
            regex: metrics
          - source_labels: [__meta_kubernetes_service_name]
            target_label: service
          - source_labels: [__meta_kubernetes_namespace]
            target_label: namespace
        # Most of a Mac's series were the operator's whole registry
        # (controller-runtime, workqueue, Go, process; see the header of this
        # file). Keep Infrared's own series, what the Fleet dashboard reads of
        # the rest, and a few beside it: reconcile errors and times, workqueue
        # adds, process CPU, heap and goroutines. The regex is anchored, and a
        # list is joined with |.
        metric_relabel_configs:
          - action: keep
            source_labels: [__name__]
            regex:
              - infrared_.*
              - controller_runtime_reconcile_total
              - controller_runtime_reconcile_errors_total
              - controller_runtime_reconcile_time_seconds.*
              - workqueue_depth
              - workqueue_adds_total
              - process_resident_memory_bytes
              - process_cpu_seconds_total
              - go_memstats_heap_inuse_bytes
              - go_goroutines
              - up
              - scrape_samples_scraped
              - scrape_duration_seconds
      - job_name: kubelet-cadvisor
        # Every 10 s where the other jobs scrape every 30. A 30 s scrape caught
        # 6 of the first proof's 14 runner Jobs and none of those that ran 7
        # to 10 s (localred finding T3). The kubelet serves the whole node's
        # cAdvisor series, about 2 MB in under 100 ms on a Mac's node, and
        # only the two families below, for ir-org-* pods, are kept.
        scrape_interval: 10s
        scheme: https
        metrics_path: /metrics/cadvisor
        tls_config:
          insecure_skip_verify: true
        bearer_token_file: /var/run/secrets/kubernetes.io/serviceaccount/token
        kubernetes_sd_configs:
          - role: node
        relabel_configs:
          - source_labels: [__meta_kubernetes_node_name]
            target_label: node
        metric_relabel_configs:
          - action: keep
            source_labels: [__name__]
            regex: container_memory_working_set_bytes|container_cpu_usage_seconds_total
          - action: keep
            source_labels: [namespace]
            regex: ir-org-.+
          - action: keep
            source_labels: [container]
            regex: .+
          - action: labeldrop
            regex: id|name|image
      - job_name: vmagent
        static_configs:
          - targets: ["127.0.0.1:8429"]
        # vmagent's own registry is about 1,200 series. Keep its write path:
        # requests by answer, the disk buffer and rows pushed (the Fleet
        # dashboard names vmagent_remotewrite_rows_pushed_total, which vmagent
        # v1.154.0 does not export; it counts rows as
        # ..._rows_pushed_after_relabel_total, kept too), the push queue's
        # drops, and the version.
        metric_relabel_configs:
          - action: keep
            source_labels: [__name__]
            regex:
              - vmagent_remotewrite_requests_total
              - vmagent_remotewrite_pending_data_bytes
              - vmagent_remotewrite_rows_pushed_total
              - vmagent_remotewrite_rows_pushed_after_relabel_total
              - vmagent_remotewrite_packets_dropped_total
              - vmagent_remotewrite_retries_count_total
              - vm_persistentqueue_bytes_pending
              - vm_persistentqueue_blocks_dropped_total
              - vmagent_rows_inserted_total
              - vm_rows_inserted_total
              - vm_app_version
              - process_resident_memory_bytes
              - up
              - scrape_samples_scraped
  relabel.yaml: |
    # Claude Code puts the person's email and IDs on every series it exports
    # (localred finding K1). They never leave the Mac: the platform label is
    # the one identity the plane keeps. Both spellings, since Prometheus naming
    # turns the dots into underscores.
    - action: labeldrop
      regex: "user\\.email|user\\.id|organization\\.id|user_email|user_id|organization_id"
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: vmagent-buffer
  namespace: monitoring
  labels:
    app.kubernetes.io/name: vmagent
    app.kubernetes.io/part-of: infrared-gitops
spec:
  accessModes: [ReadWriteOnce]
  resources:
    requests:
      storage: 1Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: vmagent
  namespace: monitoring
  labels:
    app.kubernetes.io/name: vmagent
    app.kubernetes.io/part-of: infrared-gitops
spec:
  replicas: 1
  # One claim, one pod: the new one starts once the old one has let go.
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: vmagent
  template:
    metadata:
      labels:
        app.kubernetes.io/name: vmagent
        app.kubernetes.io/part-of: infrared-gitops
    spec:
      serviceAccountName: vmagent
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        fsGroup: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: vmagent
          image: docker.io/victoriametrics/vmagent:v1.154.0@sha256:2a939a9df9c8591aa5447efcd21af8c4f2ecc60ca6a8e742ffd46b9c76ef7f17
          args:
            - -promscrape.config=/etc/vmagent/scrape.yaml
            - -promscrape.configCheckInterval=1m
            - -remoteWrite.url=[[ .Telemetry.URL ]]
            - -remoteWrite.bearerTokenFile=/etc/telemetry/token
            - -remoteWrite.label=platform=[[ .Telemetry.Platform ]]
            - -remoteWrite.label=cluster=[[ .Telemetry.Platform ]]
            - -remoteWrite.relabelConfig=/etc/vmagent/relabel.yaml
            - -remoteWrite.tmpDataPath=/var/lib/vmagent
            - -remoteWrite.maxDiskUsagePerURL=800MiB
            - -remoteWrite.maxHourlySeries=50000
            - -opentelemetry.usePrometheusNaming
            - -httpListenAddr=:8429
          ports:
            - name: http
              containerPort: 8429
          readinessProbe:
            httpGet:
              path: /health
              port: http
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 30
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              memory: 512Mi
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          volumeMounts:
            - name: config
              mountPath: /etc/vmagent
              readOnly: true
            - name: token
              mountPath: /etc/telemetry
              readOnly: true
            - name: buffer
              mountPath: /var/lib/vmagent
      volumes:
        - name: config
          configMap:
            name: vmagent-config
        - name: token
          secret:
            secretName: telemetry-token
        - name: buffer
          persistentVolumeClaim:
            claimName: vmagent-buffer
---
apiVersion: v1
kind: Service
metadata:
  name: vmagent
  namespace: monitoring
  labels:
    app.kubernetes.io/name: vmagent
    app.kubernetes.io/part-of: infrared-gitops
spec:
  selector:
    app.kubernetes.io/name: vmagent
  ports:
    - name: http
      port: 8429
      targetPort: http
[[- else -]]
# The telemetry component renders only with a telemetry URL and without the
# metrics stack, so this file holds no objects.
[[- end ]]
