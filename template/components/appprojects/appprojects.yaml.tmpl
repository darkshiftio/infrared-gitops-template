# Rendered by the Infrared operator from infrared-gitops-template [[ .TemplateVersion ]].
#
# platform: the management cluster's shared components (cert-manager,
#   external-secrets, infisical, kpack, builds, monitoring, Argo CD itself),
#   and the org's own product Applications.
# infrared: the Infrared control plane, from its OCI chart.
#
# Source repos are listed explicitly: adding a component that pulls from a new
# chart repository means adding that repository here first.
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: platform
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
spec:
  description: Platform components of the [[ .ClusterName ]] management cluster
  sourceRepos:
    - [[ .GitopsRepoURL ]]
    - https://charts.jetstack.io
    - https://charts.external-secrets.io
    - https://aws.github.io/eks-charts
    - https://dl.cloudsmith.io/public/infisical/helm-charts/helm/charts/
    - https://victoriametrics.github.io/helm-charts/
[[- if eq .Edge "gateway" ]]
    # The edge (Edge gateway): Envoy Gateway's and Cloudflare's origin issuer's
    # OCI charts (registered below), the issuer's CRDs at its tag, external-dns.
    - docker.io/envoyproxy
    - ghcr.io/cloudflare/origin-ca-issuer-charts
    - https://github.com/cloudflare/origin-ca-issuer
    - https://kubernetes-sigs.github.io/external-dns/
[[- end ]]
[[- if .Stores ]]
    # The platform's own stores (Stores): CloudNativePG's and SeaweedFS's charts.
    - https://cloudnative-pg.github.io/charts
    - https://seaweedfs.github.io/seaweedfs/helm
[[- end ]]
  # Every namespace and every cluster-scoped kind. This covers, among the
  # rest, builds (namespaces builds and build-credentials, the Role it adds in
  # ir-org-[[ .OrgName ]], Namespaces, and kpack's ClusterStore, ClusterStack
  # and ClusterBuilder). Narrowing either list means listing those.
  destinations:
    - server: https://kubernetes.default.svc
      namespace: "*"
  clusterResourceWhitelist:
    - group: "*"
      kind: "*"
---
apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: infrared
  namespace: argocd
  labels:
    app.kubernetes.io/part-of: infrared-gitops
spec:
  description: The Infrared control plane on [[ .ClusterName ]]
  sourceRepos:
    - [[ .GitopsRepoURL ]]
    - [[ .InfraredChartRepo ]]
    - https://github.com/darkshiftio/infrared-chart.git
  destinations:
    - server: https://kubernetes.default.svc
      namespace: [[ .InfraredNamespace ]]
  # The chart ships the infrared.darkshift.io CRDs and the operator's and
  # API's ClusterRoles.
  clusterResourceWhitelist:
    - group: apiextensions.k8s.io
      kind: CustomResourceDefinition
    - group: rbac.authorization.k8s.io
      kind: ClusterRole
    - group: rbac.authorization.k8s.io
      kind: ClusterRoleBinding
[[- if eq .Edge "gateway" ]]
---
# Argo CD pulls an OCI helm chart only from a registered repository. Envoy
# Gateway's and Cloudflare's origin issuer's charts are public, so these entries
# carry no credentials. They are here, at wave 0, because an Application cannot
# register the repository its own chart comes from.
apiVersion: v1
kind: Secret
metadata:
  name: envoy-charts
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
    app.kubernetes.io/part-of: infrared-gitops
stringData:
  name: envoy-charts
  type: helm
  url: docker.io/envoyproxy
  enableOCI: "true"
---
apiVersion: v1
kind: Secret
metadata:
  name: origin-ca-issuer-charts
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
    app.kubernetes.io/part-of: infrared-gitops
stringData:
  name: origin-ca-issuer-charts
  type: helm
  url: ghcr.io/cloudflare/origin-ca-issuer-charts
  enableOCI: "true"
[[- end ]]
