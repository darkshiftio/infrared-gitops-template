              }
              store_ready() {
                [ "$(kubectl get clustersecretstore "$1" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = True ]
              }
              present() {
                kubectl -n "${1%%/*}" get secret "${1#*/}" -o name >/dev/null 2>&1
              }
              for crd in $WAIT_CRDS; do
                until established "$crd"; do echo "waiting for the CRD $crd"; sleep 5; done
              done
              for svc in $WAIT_SERVICES; do
                until answering "$svc"; do echo "waiting for a ready endpoint of the Service $svc"; sleep 5; done
              done
              for store in $WAIT_STORES; do
                until store_ready "$store"; do echo "waiting for the ClusterSecretStore $store to be Ready"; sleep 5; done
              done
              for secret in $WAIT_SECRETS; do
                until present "$secret"; do echo "waiting for the Secret $secret"; sleep 5; done
              done
              echo "everything this component needs answers"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 128Mi
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
[[- else -]]
# The registry inside the cluster runs only with a registry address and the
# platform's own stores: nothing to wait for.
[[- end ]]
