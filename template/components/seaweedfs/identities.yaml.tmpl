[[- $copies := and .Stores .Backup.Bucket .Copies.Recipients -]]
[[- $restore := and .Stores .Backup.Bucket .Restore.Point -]]
[[- if .Stores -]]
# =============================================================================
# SeaweedFS's S3 identities: who may do what, in which bucket.
# =============================================================================
# The S3 gateway reads this file (s3.existingConfigSecret). It holds no key:
# each ${...} names an environment variable of the gateway, set from the Secret
# seaweedfs-s3-<identity> that the PreSync hook makes (prepare.yaml). SeaweedFS
# drops a credential whose variable is unset, so a missing Secret never becomes
# an empty key. Each identity reaches its own bucket only:
#
#   identity        bucket          for
#   ate-snapshots   ate-snapshots   Agent Substrate's actor snapshots
#   registry        registry        the registry's images and charts
[[- if $copies ]]
#   objects-copy    infrared-objects  the hourly copy of Infrared's objects, encrypted
#   gitea-dump      gitea-dumps       the hourly dump of Gitea, encrypted
#   backup          every bucket, read  the hourly copy to the outside bucket
[[- else if .Backup.Bucket ]]
#   backup          both, read      the hourly copy to the outside bucket
[[- end ]]
[[- if $restore ]]
#   restore         every bucket, read and write  a restore copying the buckets
#                   back (stores-restore), while the restore lasts
[[- end ]]
#
# No identity is an administrator. The buckets are made by the chart's bucket
# hook, with weed shell, which needs no S3 key.
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: seaweedfs-s3-identities
  namespace: stores
  annotations:
    # Before the gateway that mounts it.
    argocd.argoproj.io/sync-wave: "-1"
type: Opaque
stringData:
  seaweedfs_s3_config: |
    {
      "identities": [
        {
          "name": "ate-snapshots",
          "credentials": [{"accessKey": "${S3_ATE_SNAPSHOTS_ACCESS_KEY_ID}", "secretKey": "${S3_ATE_SNAPSHOTS_SECRET_ACCESS_KEY}"}],
          "actions": ["Read:ate-snapshots", "Write:ate-snapshots", "List:ate-snapshots", "Tagging:ate-snapshots"]
        },
        {
          "name": "registry",
          "credentials": [{"accessKey": "${S3_REGISTRY_ACCESS_KEY_ID}", "secretKey": "${S3_REGISTRY_SECRET_ACCESS_KEY}"}],
          "actions": ["Read:registry", "Write:registry", "List:registry", "Tagging:registry"]
        }[[ if .Backup.Bucket ]],
        {
          "name": "backup",
          "credentials": [{"accessKey": "${S3_BACKUP_ACCESS_KEY_ID}", "secretKey": "${S3_BACKUP_SECRET_ACCESS_KEY}"}],
          "actions": ["Read:ate-snapshots", "List:ate-snapshots", "Read:registry", "List:registry"[[ if $copies ]], "Read:infrared-objects", "List:infrared-objects", "Read:gitea-dumps", "List:gitea-dumps"[[ end ]]]
        }[[ end ]][[ if $copies ]],
        {
          "name": "objects-copy",
          "credentials": [{"accessKey": "${S3_OBJECTS_COPY_ACCESS_KEY_ID}", "secretKey": "${S3_OBJECTS_COPY_SECRET_ACCESS_KEY}"}],
          "actions": ["Read:infrared-objects", "Write:infrared-objects", "List:infrared-objects"]
        },
        {
          "name": "gitea-dump",
          "credentials": [{"accessKey": "${S3_GITEA_DUMP_ACCESS_KEY_ID}", "secretKey": "${S3_GITEA_DUMP_SECRET_ACCESS_KEY}"}],
          "actions": ["Read:gitea-dumps", "Write:gitea-dumps", "List:gitea-dumps"]
        }[[ end ]][[ if $restore ]],
        {
          "name": "restore",
          "credentials": [{"accessKey": "${S3_RESTORE_ACCESS_KEY_ID}", "secretKey": "${S3_RESTORE_SECRET_ACCESS_KEY}"}],
          "actions": ["Read:ate-snapshots", "Write:ate-snapshots", "List:ate-snapshots", "Read:registry", "Write:registry", "List:registry"[[ if $copies ]], "Read:infrared-objects", "Write:infrared-objects", "List:infrared-objects", "Read:gitea-dumps", "Write:gitea-dumps", "List:gitea-dumps"[[ end ]]]
        }[[ end ]]
      ]
    }
[[- else -]]
# The platform's own stores are off (INFRARED_STORES): no S3 identities.
[[- end ]]
