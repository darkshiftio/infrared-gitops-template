[[- if .Stores -]]
# =============================================================================
# Before SeaweedFS: its S3 keys, and the Postgres that holds its filer metadata.
# =============================================================================
# This PreSync hook makes the Secret seaweedfs-s3-<identity> (AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY) of each S3 identity, once, if it is absent, and never
# replaces one. Then it waits, up to half an hour, until the platform's Postgres
# answers, so the filers start against their store. On a fresh cluster every
# Application syncs at once (README, "Order on a fresh cluster").
# =============================================================================
apiVersion: v1
kind: ServiceAccount
metadata:
  name: seaweedfs-prepare
  namespace: stores
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
---
# Read only: CRDs, EndpointSlices and ClusterSecretStores, nothing else.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: infrared-wait-seaweedfs
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
rules:
  - apiGroups: ["apiextensions.k8s.io"]
    resources: ["customresourcedefinitions"]
    verbs: ["get"]
  - apiGroups: ["discovery.k8s.io"]
    resources: ["endpointslices"]
    verbs: ["list"]
  - apiGroups: ["external-secrets.io"]
    resources: ["clustersecretstores"]
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: infrared-wait-seaweedfs
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: infrared-wait-seaweedfs
subjects:
  - kind: ServiceAccount
    name: seaweedfs-prepare
    namespace: stores
---
# Make the Secrets below once; read them to see whether they exist. Nothing else.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: seaweedfs-prepare
  namespace: stores
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    resourceNames: ["seaweedfs-s3-ate-snapshots", "seaweedfs-s3-registry"]
    verbs: ["get"]
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: seaweedfs-prepare
  namespace: stores
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: seaweedfs-prepare
subjects:
  - kind: ServiceAccount
    name: seaweedfs-prepare
    namespace: stores
---
apiVersion: batch/v1
kind: Job
metadata:
  name: seaweedfs-prepare
  namespace: stores
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-9"
spec:
  # Half an hour, then the sync fails and Argo CD retries it, waiting again.
  activeDeadlineSeconds: 1800
  backoffLimit: 6
  ttlSecondsAfterFinished: 3600
  template:
    spec:
      serviceAccountName: seaweedfs-prepare
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: prepare
          # alpine/k8s 1.37.0: kubectl and a busybox shell.
          image: docker.io/alpine/k8s:1.37.0@sha256:b421c2e9419edb98db39b6ab641669f4db7bb2acf354f22450c6b7e7176d1ff4
          env:
            - name: HOME
              value: /tmp
            - name: IDENTITIES
              value: "ate-snapshots registry"
            - name: WAIT_CRDS
              value: ""
            - name: WAIT_SERVICES
              value: "stores/postgres-rw"
            - name: WAIT_STORES
              value: ""
          command:
            - /bin/sh
            - -ec
            - |
              # Each S3 identity's keys, made once and never replaced: the S3
              # gateway reads them as environment variables (identities.yaml), and
              # the identity's user reads the same Secret. Nothing prints a key.
              for identity in $IDENTITIES; do
                secret="seaweedfs-s3-$identity"
                if kubectl get secret "$secret" >/dev/null 2>&1; then
                  echo "$secret exists; leaving it alone"
                  continue
                fi
                key_id="$(tr -dc 'A-Z0-9' </dev/urandom | head -c 20)"
                key="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 40)"
                if [ "${#key_id}" -ne 20 ] || [ "${#key}" -ne 40 ]; then
                  echo "a generated key has the wrong length; not writing $secret" >&2
                  exit 1
                fi
                kubectl create -f - >/dev/null <<EOF
              apiVersion: v1
              kind: Secret
              type: Opaque
              metadata:
                name: $secret
              stringData:
                AWS_ACCESS_KEY_ID: $key_id
                AWS_SECRET_ACCESS_KEY: $key
              EOF
                echo "created $secret"
              done
              # Each list is space-separated; an empty one waits for nothing.
              established() {
                [ "$(kubectl get crd "$1" -o jsonpath='{.status.conditions[?(@.type=="Established")].status}' 2>/dev/null)" = True ]
              }
              answering() {
                kubectl -n "${1%%/*}" get endpointslices -l "kubernetes.io/service-name=${1#*/}" \
                  -o jsonpath='{.items[*].endpoints[*].conditions.ready}' 2>/dev/null | grep -qw true
              }
              store_ready() {
                [ "$(kubectl get clustersecretstore "$1" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = True ]
              }
              for crd in $WAIT_CRDS; do
                until established "$crd"; do echo "waiting for the CRD $crd"; sleep 5; done
              done
              for svc in $WAIT_SERVICES; do
                until answering "$svc"; do echo "waiting for a ready endpoint of the Service $svc"; sleep 5; done
              done
              for store in $WAIT_STORES; do
                until store_ready "$store"; do echo "waiting for the ClusterSecretStore $store to be Ready"; sleep 5; done
              done
              echo "everything this component needs answers"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 128Mi
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
[[- else -]]
# The platform's own stores are off (INFRARED_STORES): nothing to prepare.
[[- end ]]
