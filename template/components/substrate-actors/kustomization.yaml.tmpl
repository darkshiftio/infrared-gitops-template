[[- if and .Stores .SubstrateCapable .Registry -]]
# The namespace of the platform's worker pools on Agent Substrate (the
# `substrate-actors` Application, wave 23), ate-workers:
#
#   wait.yaml          PreSync: Substrate's CRDs at ate.dev/v1, its API and
#                      router, and the registry inside the cluster, answer
[[- if .ImagePullSecret ]]
#   pull-secrets.yaml  the pull secret, for a worker pool's image
[[- end ]]
[[- if .AgentPool ]]
#   workers.yaml       the WorkerPool agents, where an org's agent steps run as
#                      actors (the chart's runner.actors)
[[- end ]]
#
# The platform's pool of three gVisor workers and Substrate's test actors (the
# ActorTemplates counter and sandbox, upstream's demos, which 1.0 no longer
# publishes) served only the checks of an install before Substrate 1.0. The
# agents' pool comes with the chart's runner.actors (.AgentPool). The
# substrate-test-actors name in the components the install leaves out changes
# nothing here any more.
#
# Every object names its own namespace.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - wait.yaml
[[- if .ImagePullSecret ]]
  - pull-secrets.yaml
[[- end ]]
[[- if .NetworkPolicies ]]
  - fence.yaml
[[- end ]]
[[- if .AgentPool ]]
  - workers.yaml
[[- end ]]
[[- else -]]
# Agent Substrate runs only where the operator's preflight found the cluster able
# to host it, with the platform's own stores and the registry inside the
# cluster, so this component holds no objects and no Application points at it.
[[- end ]]
