[[- $testActors := true ]][[ range .Disabled ]][[ if eq . "substrate-test-actors" ]][[ $testActors = false ]][[ end ]][[ end ]]
[[- if and .Stores .SubstrateCapable .Registry .ImagePullSecret -]]
# The pull secret for Substrate's images, [[ .InfraredNamespace ]]/[[ .ImagePullSecret ]],
# copied through the ClusterSecretStore infrared-platform[[ if .RegistryToken.Registry ]] every 5 minutes
# (a registry token, rewritten every 30 minutes and good for [[ if .RegistryToken.GCPServiceAccount ]]an hour[[ else ]]12 hours[[ end ]])[[ end ]] into:
#
#   ate-workers  the workers' image, ateom-gvisor: the WorkerPool cannot name a
#                pull secret, so the namespace's ServiceAccount default lists it
#                (workers.yaml)
[[- if $testActors ]]
#   registry     the copy of the actor images into the registry inside the
#                cluster reads them with it (images.yaml)
[[- end ]]
#
[[- if not $testActors ]]
# Not into registry: Substrate's test actors are off (substrate-test-actors is
# among the components the install leaves out), so no actor image is copied.
#
[[- end ]]
# The values the API server would fill in are written out, so Argo CD compares
# like with like. Wave -2, alone: External Secrets' webhook admits them.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: [[ .ImagePullSecret ]]
  namespace: ate-workers
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  refreshInterval: [[ if .RegistryToken.Registry ]]5m0s[[ else ]]1h0m0s[[ end ]]
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-platform
  target:
    name: [[ .ImagePullSecret ]]
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      type: kubernetes.io/dockerconfigjson
      engineVersion: v2
      mergePolicy: Replace
      data:
        .dockerconfigjson: '{{ index . ".dockerconfigjson" }}'
  dataFrom:
    - extract:
        key: [[ .ImagePullSecret ]]
[[- if $testActors ]]
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: [[ .ImagePullSecret ]]
  namespace: registry
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  refreshInterval: [[ if .RegistryToken.Registry ]]5m0s[[ else ]]1h0m0s[[ end ]]
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-platform
  target:
    name: [[ .ImagePullSecret ]]
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      type: kubernetes.io/dockerconfigjson
      engineVersion: v2
      mergePolicy: Replace
      data:
        .dockerconfigjson: '{{ index . ".dockerconfigjson" }}'
  dataFrom:
    - extract:
        key: [[ .ImagePullSecret ]]
[[- end ]]
[[- else -]]
# Substrate's images pull with the install's pull secret only where Substrate
# runs and the install names one (the chart's imagePullSecrets): none here.
[[- end ]]
