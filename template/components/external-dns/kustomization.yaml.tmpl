[[- if eq .Edge "gateway" -]]
# The second source of the `external-dns` Application (wave 12): its Cloudflare
# token, copied from the platform's tokens, and the hook that waits for them.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - wait.yaml
  - cloudflare-api-token.yaml
[[- else -]]
# external-dns runs only when the edge is a Gateway, so this component holds no
# objects and no Application points at it.
[[- end ]]
