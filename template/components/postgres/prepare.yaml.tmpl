[[- if .Stores -]]
# =============================================================================
# Before the Cluster: the roles' Secrets, and CloudNativePG's webhook.
# =============================================================================
# This PreSync hook makes the Secret postgres-<role> (kubernetes.io/basic-auth)
# of each role below, once, if it is absent, and never replaces one. Then it
# waits, up to half an hour, until CloudNativePG's CRDs are established and its
# webhook has a ready endpoint, so the Cluster is admitted when it is applied[[ if or (not .Backup.Bucket) .PostgresArchive.Enabled ]];
# with backups, also until the Barman Cloud plugin answers and the store
# infrared-platform, which copies the backup keys, is Ready[[ end ]].
# On a fresh cluster every Application syncs at once (README, "Order on a fresh
# cluster").
# =============================================================================
apiVersion: v1
kind: ServiceAccount
metadata:
  name: postgres-prepare
  namespace: stores
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
---
# Read only: CRDs, EndpointSlices and ClusterSecretStores, nothing else.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: infrared-wait-postgres
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
rules:
  - apiGroups: ["apiextensions.k8s.io"]
    resources: ["customresourcedefinitions"]
    verbs: ["get"]
  - apiGroups: ["discovery.k8s.io"]
    resources: ["endpointslices"]
    verbs: ["list"]
  - apiGroups: ["external-secrets.io"]
    resources: ["clustersecretstores"]
    verbs: ["get"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: infrared-wait-postgres
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: infrared-wait-postgres
subjects:
  - kind: ServiceAccount
    name: postgres-prepare
    namespace: stores
---
# Make the Secrets below once; read them to see whether they exist. Nothing else.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: postgres-prepare
  namespace: stores
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    resourceNames: ["postgres-seaweedfs", "postgres-substrate"]
    verbs: ["get"]
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: postgres-prepare
  namespace: stores
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: postgres-prepare
subjects:
  - kind: ServiceAccount
    name: postgres-prepare
    namespace: stores
---
apiVersion: batch/v1
kind: Job
metadata:
  name: postgres-prepare
  namespace: stores
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-9"
spec:
  # Half an hour, then the sync fails and Argo CD retries it, waiting again.
  activeDeadlineSeconds: 1800
  backoffLimit: 6
  ttlSecondsAfterFinished: 3600
  template:
    spec:
      serviceAccountName: postgres-prepare
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: prepare
          # alpine/k8s 1.37.0: kubectl and a busybox shell.
          image: docker.io/alpine/k8s:1.37.0@sha256:b421c2e9419edb98db39b6ab641669f4db7bb2acf354f22450c6b7e7176d1ff4
          env:
            - name: HOME
              value: /tmp
            - name: WAIT_CRDS
              value: "clusters.postgresql.cnpg.io databaseroles.postgresql.cnpg.io databases.postgresql.cnpg.io[[ if and .Backup.Bucket .PostgresArchive.Enabled ]] scheduledbackups.postgresql.cnpg.io objectstores.barmancloud.cnpg.io externalsecrets.external-secrets.io[[ end ]]"
            - name: WAIT_SERVICES
              value: "cnpg-system/cnpg-webhook-service[[ if and .Backup.Bucket .PostgresArchive.Enabled ]] cnpg-system/barman-cloud[[ end ]]"
            - name: WAIT_STORES
              value: "[[ if and .Backup.Bucket .PostgresArchive.Enabled ]]infrared-platform[[ end ]]"
          command:
            - /bin/sh
            - -ec
            - |
              # Each role's password, made once and never replaced: CloudNativePG
              # gives the role the password in its Secret, and the role's consumer
              # reads the same Secret. Nothing prints a password.
              for role in seaweedfs substrate; do
                secret="postgres-$role"
                if kubectl get secret "$secret" >/dev/null 2>&1; then
                  echo "$secret exists; leaving it alone"
                  continue
                fi
                password="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32)"
                if [ "${#password}" -ne 32 ]; then
                  echo "a generated password has the wrong length; not writing $secret" >&2
                  exit 1
                fi
                kubectl create -f - >/dev/null <<EOF
              apiVersion: v1
              kind: Secret
              type: kubernetes.io/basic-auth
              metadata:
                name: $secret
                labels:
                  cnpg.io/reload: "true"
              stringData:
                username: $role
                password: $password
              EOF
                echo "created $secret"
              done
              # Each list is space-separated; an empty one waits for nothing.
              established() {
                [ "$(kubectl get crd "$1" -o jsonpath='{.status.conditions[?(@.type=="Established")].status}' 2>/dev/null)" = True ]
              }
              answering() {
                kubectl -n "${1%%/*}" get endpointslices -l "kubernetes.io/service-name=${1#*/}" \
                  -o jsonpath='{.items[*].endpoints[*].conditions.ready}' 2>/dev/null | grep -qw true
              }
              store_ready() {
                [ "$(kubectl get clustersecretstore "$1" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = True ]
              }
              for crd in $WAIT_CRDS; do
                until established "$crd"; do echo "waiting for the CRD $crd"; sleep 5; done
              done
              for svc in $WAIT_SERVICES; do
                until answering "$svc"; do echo "waiting for a ready endpoint of the Service $svc"; sleep 5; done
              done
              for store in $WAIT_STORES; do
                until store_ready "$store"; do echo "waiting for the ClusterSecretStore $store to be Ready"; sleep 5; done
              done
              echo "everything this component needs answers"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 128Mi
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
[[- else -]]
# The platform's own stores are off (INFRARED_STORES): nothing to prepare.
[[- end ]]
