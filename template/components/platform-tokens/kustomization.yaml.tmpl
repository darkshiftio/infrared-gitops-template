[[- if (or (eq .Edge "gateway") (and .Stores .Backup.Bucket) (and .Stores .SubstrateCapable .Registry .ImagePullSecret)) -]]
# The platform's tokens (the `platform-tokens` Application, wave 11). See
# store.yaml; wait.yaml holds the sync until External Secrets answers. Every
# object names its own namespace.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - wait.yaml
  - store.yaml
[[- else -]]
# The platform's tokens are copied only for the edge when it is a Gateway and
# for the stores' backups, so this component holds no objects and no
# Application points at it.
[[- end ]]
