[[- $ci := index .Images "code-index" ]]
[[- if and .ImageRegistry (or $ci.Tag $ci.Digest) .ImagePullSecret -]]
# The pull secret for the code index's image: a copy of
# [[ .InfraredNamespace ]]/[[ .ImagePullSecret ]], the one Infrared's own images pull with, through the
# ClusterSecretStore infrared-platform (components/platform-tokens), whose
# conditions admit the namespace code-index. The values the API server would
# fill in are written out, so Argo CD compares like with like.
#
# Wave -1, alone: External Secrets' webhook admits it, so it is applied, and
# synced, before the pod (0) that pulls with its Secret.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: [[ .ImagePullSecret ]]
  namespace: code-index
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
spec:
  refreshInterval: [[ if .RegistryToken.Registry ]]5m0s[[ else ]]1h0m0s[[ end ]]
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-platform
  target:
    name: [[ .ImagePullSecret ]]
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      type: kubernetes.io/dockerconfigjson
      engineVersion: v2
      mergePolicy: Replace
      data:
        .dockerconfigjson: '{{ index . ".dockerconfigjson" }}'
  dataFrom:
    - extract:
        key: [[ .ImagePullSecret ]]
[[- else -]]
# The code index's image pulls with the install's pull secret only where the
# code index runs and the install names one (the chart's imagePullSecrets):
# none here.
[[- end ]]
