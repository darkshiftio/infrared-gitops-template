[[- if and (eq .Edge "gateway") (or .PlatformDomain .InfraredHost) -]]
[[- /* The platform domain in a Cloudflare zone of its own, on a token of its own (spec.previews.domainTokenKey, infrared-docs-internal ADR 0063): its wildcard takes a copy of that token, an issuer and a certificate of their own, and the certificate edge keeps Infrared's name alone. */ -]]
[[- $split := and .PlatformDomain .DomainTokenKey ]]
[[- /* Infrared's name needs a name of its own on the certificate only when the wildcard does not cover it: one label under the platform domain. A wildcard on a certificate of its own covers it nowhere. */ -]]
[[- $covered := false ]]
[[- if and .PlatformDomain .InfraredHost (not $split) ]]
[[- $label := trimSuffix (printf ".%s" .PlatformDomain) .InfraredHost ]]
[[- if and (hasSuffix (printf ".%s" .PlatformDomain) .InfraredHost) (not (contains "." $label)) ]][[ $covered = true ]][[ end ]]
[[- end -]]
# =============================================================================
# The edge's certificate, from Cloudflare's Origin CA.
# =============================================================================
# Cloudflare's proxy is the only client of this Gateway (external-dns proxies
# every record), and it checks the origin's certificate against Cloudflare's
# Origin CA (SSL/TLS mode Full (strict)). The browser sees Cloudflare's own edge
# certificate, never this one: a name served with it must stay proxied.
#
# An OriginIssuer next to the Gateway, not a ClusterOriginIssuer: only
# certificates in this namespace can use it, and its token stays here too. The
# token is the platform's cloudflare-api-token, which needs the permission
# Zone / SSL and Certificates / Edit; reading /certificates succeeds without it,
# and issuing does not.
[[- if $split ]]
#
# Two Cloudflare zones, two tokens (infrared-docs-internal ADR 0063). The
# platform domain, [[ .PlatformDomain ]], is in a zone of its own, and its token, the key
# [[ .DomainTokenKey ]] of infrared-platform-tokens, is kept apart from the zone of
# Infrared's own name. Origin CA checks a token against each name's zone, so
# the wildcard *.[[ .PlatformDomain ]] has a copy of that token, the OriginIssuer
# cloudflare-origin-domain and the Certificate edge-domain (Secret
# edge-domain-tls) of its own, in the same waves. cloudflare-origin, on
# cloudflare-api-token, signs [[ if .InfraredHost ]]the Certificate edge, Infrared's name alone, and [[ end ]]the
# certificates Infrared asks for a zone's own addresses.
[[- end ]]
#
# cert-manager renews [[ if $split ]]each[[ else ]]it[[ end ]], at two thirds of its 90 days. Cloudflare sends no
# expiry notice.
#
# Waves: the token's copy (-5), the issuer (-4), the certificate (-3), then the
# Envoy fleet and the Gateway (gateway.yaml, -2 to 0). External Secrets' and
# cert-manager's webhooks admit the first and the third, so each has a wave of
# its own, before everything whose health depends on it. A refused apply then
# fails the sync, which Argo CD retries; in one wave with the Gateway, the sync
# waited for ever on a Gateway that had no certificate.
# =============================================================================
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: cloudflare-api-token
  namespace: envoy-gateway-system
  annotations:
    argocd.argoproj.io/sync-wave: "-5"
spec:
  refreshInterval: 1h0m0s
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-platform
  target:
    name: cloudflare-api-token
    creationPolicy: Owner
    deletionPolicy: Retain
  data:
    - secretKey: api-token
      remoteRef:
        key: infrared-platform-tokens
        property: cloudflare-api-token
---
apiVersion: cert-manager.k8s.cloudflare.com/v1
kind: OriginIssuer
metadata:
  name: cloudflare-origin
  namespace: envoy-gateway-system
  annotations:
    argocd.argoproj.io/sync-wave: "-4"
spec:
  # RSA, the key cert-manager makes by default; the private key never leaves the cluster.
  requestType: OriginRSA
  auth:
    tokenRef:
      name: cloudflare-api-token
      key: api-token
[[- if or (not $split) .InfraredHost ]]
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: edge
  namespace: envoy-gateway-system
  annotations:
    # Healthy once issued: the Gateway's listeners need its Secret.
    argocd.argoproj.io/sync-wave: "-3"
spec:
  secretName: edge-tls
  dnsNames:
[[- if and .PlatformDomain (not $split) ]]
    - [[ printf "*.%s" .PlatformDomain | quote ]]
[[- end ]]
[[- if and .InfraredHost (not $covered) ]]
    - [[ .InfraredHost | quote ]]
[[- end ]]
  privateKey:
    algorithm: RSA
    size: 2048
  issuerRef:
    group: cert-manager.k8s.cloudflare.com
    kind: OriginIssuer
    name: cloudflare-origin
[[- end ]]
[[- if $split ]]
---
# The platform domain's own (ADR 0063): its token's copy, its issuer and its
# wildcard's certificate, for the Gateway's listener https.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: cloudflare-domain-api-token
  namespace: envoy-gateway-system
  annotations:
    argocd.argoproj.io/sync-wave: "-5"
spec:
  refreshInterval: 1h0m0s
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-platform
  target:
    name: cloudflare-domain-api-token
    creationPolicy: Owner
    deletionPolicy: Retain
  data:
    - secretKey: api-token
      remoteRef:
        key: infrared-platform-tokens
        property: [[ .DomainTokenKey | quote ]]
---
apiVersion: cert-manager.k8s.cloudflare.com/v1
kind: OriginIssuer
metadata:
  name: cloudflare-origin-domain
  namespace: envoy-gateway-system
  annotations:
    argocd.argoproj.io/sync-wave: "-4"
spec:
  # RSA, the key cert-manager makes by default; the private key never leaves the cluster.
  requestType: OriginRSA
  auth:
    tokenRef:
      name: cloudflare-domain-api-token
      key: api-token
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: edge-domain
  namespace: envoy-gateway-system
  annotations:
    # Healthy once issued: the zones' listener needs its Secret.
    argocd.argoproj.io/sync-wave: "-3"
spec:
  secretName: edge-domain-tls
  dnsNames:
    - [[ printf "*.%s" .PlatformDomain | quote ]]
  privateKey:
    algorithm: RSA
    size: 2048
  issuerRef:
    group: cert-manager.k8s.cloudflare.com
    kind: OriginIssuer
    name: cloudflare-origin-domain
[[- end ]]
[[- else -]]
# The edge is not a Gateway with a name to serve: no certificate.
[[- end ]]
