[[- if and (eq .Edge "gateway") (or .PlatformDomain .InfraredHost) -]]
[[- $tunnel := and (eq .Edge "gateway") .TunnelID -]]
# =============================================================================
# The edge's own routes. Every Gateway API default is written out (parentRef
# group and kind, the PathPrefix / match, backendRef group, kind and weight), or
# Argo CD would keep them OutOfSync.
# =============================================================================
# Plain HTTP, every name: a redirect to HTTPS, nothing served in the clear,
# a zone's own addresses too (on the listener http-any, which names no host).
[[- if $tunnel ]]
#
# Behind the Cloudflare Tunnel (spec.tunnel, infrared-docs-internal ADR 0064)
# no plain HTTP from outside reaches it: cloudflared sends every request to
# the HTTPS listeners, so only Cloudflare's edge can redirect it, with each
# zone's Always Use HTTPS on. Nor does anything publish DNS from these routes:
# external-dns does not run, and the edge's names are proxied CNAMEs to the
# tunnel, made once by a person:
[[- if .PlatformDomain ]]
#   [[ printf "*.%s" .PlatformDomain ]]  one wildcard record, for every zone
[[- end ]]
[[- if .InfraredHost ]]
#   [[ .InfraredHost ]]  Infrared's own record
[[- end ]]
# The label below stays, so the routes are the same either way.
[[- else ]]
#
# It is also where the edge's DNS records come from. It names no host, so it
# takes each listener's own (http-any has none, so it publishes nothing):
[[- if .PlatformDomain ]]
#   [[ printf "*.%s" .PlatformDomain ]]  one proxied wildcard record, for every zone
[[- end ]]
[[- if .InfraredHost ]]
#   [[ .InfraredHost ]]  Infrared's own record
[[- end ]]
# external-dns publishes only routes with the label below, at the Gateway's
# addresses: the ExternalIP of each node with a ready Envoy (gateway.yaml).
[[- end ]]
[[- if and .PlatformDomain .DomainTokenKey (not $tunnel) ]]
# Two of them read these routes, one for each Cloudflare zone (ADR 0063):
# external-dns-domain, on the platform domain's own token, publishes
# *.[[ .PlatformDomain ]] and edge.[[ .PlatformDomain ]][[ if .InfraredHost ]], and external-dns, on
# cloudflare-api-token, [[ .InfraredHost ]][[ end ]]. Each skips the names in a zone its token
# cannot see.
[[- end ]]
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: https-redirect
  namespace: envoy-gateway-system
  labels:
    infrared.darkshift.io/dns: edge
spec:
  parentRefs:
[[- if .PlatformDomain ]]
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: edge
      sectionName: http
[[- end ]]
[[- if .InfraredHost ]]
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: edge
      sectionName: infrared-http
[[- end ]]
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: edge
      sectionName: http-any
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      filters:
        - type: RequestRedirect
          requestRedirect:
            scheme: https
            statusCode: 301
[[- if .PlatformDomain ]]
---
[[- if $tunnel ]]
# The edge's own name, [[ printf "edge.%s" .PlatformDomain ]], the target Infrared points
# a zone's own addresses at (a proxied CNAME each; Cloudflare flattens one at
# a zone's apex). Behind the tunnel the wildcard's CNAME to the tunnel answers
# for it, and cloudflared's route for the wildcard takes it to Envoy. Plain
# HTTP only, a redirect like the one above: on HTTPS the name is the wildcard
# listener's.
[[- else ]]
# The edge's own name, [[ printf "edge.%s" .PlatformDomain ]]: one proxied record at the
# Gateway's addresses, which follow the nodes. Infrared points a zone's own
# addresses there (a proxied CNAME each; Cloudflare flattens one at a zone's
# apex), so none of them needs a node's IP. The wildcard record answers for
# the name too; this one is published by name, not by chance. Plain HTTP only,
# a redirect like the one above: on HTTPS the name is the wildcard listener's.
[[- end ]]
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: edge-name
  namespace: envoy-gateway-system
  labels:
    infrared.darkshift.io/dns: edge
spec:
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: edge
      sectionName: http
  hostnames:
    - [[ printf "edge.%s" .PlatformDomain | quote ]]
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      filters:
        - type: RequestRedirect
          requestRedirect:
            scheme: https
            statusCode: 301
[[- end ]]
[[- if .InfraredHost ]]
[[- if .EdgeProofSecret ]]
---
# The edge's proof (workspace TODO 473, F4; infrared-docs-internal ADR 0066
# D2): Envoy stamps every request it takes for Infrared's API with
# X-Infrared-Edge-Proof, the value of the key credential of the Secret
# [[ .InfraredNamespace ]]/[[ .EdgeProofSecret ]], over any copy a client sent, and
# infrared-api believes the client-address header (CF-Connecting-IP) only on a
# request that carries it. The operator makes the Secret before it renders
# this file, and so does the API at its start. While the Secret or its key is
# missing, Envoy answers 500 on the API's paths: to rotate the proof, replace
# its value in place, with no trailing newline, and never delete the Secret.
# Wave -1, before the route that names it; pruned last, after the route that
# stops naming it, since a route that names a missing filter answers 500 too.
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: HTTPRouteFilter
metadata:
  name: infrared-edge-proof
  namespace: [[ .InfraredNamespace ]]
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
    argocd.argoproj.io/sync-options: PruneLast=true
spec:
  credentialInjection:
    header: X-Infrared-Edge-Proof
    overwrite: true
    credential:
      valueRef:
        group: ""
        kind: Secret
        name: [[ .EdgeProofSecret | quote ]]
[[- end ]]
---
# Infrared at https://[[ .InfraredHost ]]: the UI's Service, which serves the UI
# and proxies /api to the API and /mcp to the MCP server. The chart names it
# after the release, `infrared`.
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: infrared
  namespace: [[ .InfraredNamespace ]]
spec:
  parentRefs:
    - group: gateway.networking.k8s.io
      kind: Gateway
      name: edge
      namespace: envoy-gateway-system
      sectionName: infrared-https
  hostnames:
    - [[ .InfraredHost | quote ]]
  rules:
[[- if .EdgeProofSecret ]]
    # The paths the UI's nginx sends to the API carry the edge's proof, and
    # only those: /mcp and the extensions' /ext/ go elsewhere and never see
    # it. No filter on this rule may remove the header: a route's own header
    # removal runs after the injection (the ClientTrafficPolicy edge strips a
    # client's copy before routing instead).
    - matches:
        - path:
            type: PathPrefix
            value: /api
        - path:
            type: Exact
            value: /.well-known/oauth-authorization-server/api/v1/oidc
        - path:
            type: Exact
            value: /.well-known/openid-configuration/api/v1/oidc
      filters:
        - type: ExtensionRef
          extensionRef:
            group: gateway.envoyproxy.io
            kind: HTTPRouteFilter
            name: infrared-edge-proof
      backendRefs:
        - group: ""
          kind: Service
          name: infrared
          port: 80
          weight: 1
[[- end ]]
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - group: ""
          kind: Service
          name: infrared
          port: 80
          weight: 1
[[- end ]]
[[- else -]]
# The edge is not a Gateway with a name to serve: no routes.
[[- end ]]
