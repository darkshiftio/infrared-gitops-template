[[- if and (eq .Edge "gateway") (or .PlatformDomain .InfraredHost) .TunnelID -]]
[[- $key := default "cloudflare-tunnel-credentials" .TunnelCredentialsKey ]]
[[- $edge := "https://edge.envoy-gateway-system.svc.cluster.local:443" -]]
[[- /* Beside the nodes' own ports (spec.tunnel.mode beside, ADR 0090) the edge keeps Cloudflare's Origin CA, which cloudflared trusts built in: no edge-ca, no caPool. */ -]]
[[- $beside := eq .TunnelMode "beside" -]]
[[- /* Infrared's own name, unless spec.previews.signInPrivate keeps it off the edge (ADR 0090). */ -]]
[[- $infrared := and (not .SignInPrivate) .InfraredHost -]]
[[- if $beside -]]
# =============================================================================
# cloudflared: the edge's Cloudflare Tunnel, beside the nodes' own ports.
# =============================================================================
# The Installation's spec.tunnel with mode beside (infrared-docs-internal ADR
# 0090): a locally managed tunnel, [[ .TunnelID ]], whose routes are
# these, rendered from the Installation's names and never kept in Cloudflare's
# dashboard. It runs beside the edge on the nodes' own ports, which stays as
# it renders without a tunnel (gateway.yaml, certificate.yaml, routes.yaml):
# a name with a route below reaches Envoy through the tunnel once its record
# is a proxied CNAME to [[ .TunnelID ]].cfargotunnel.com, and
# through the nodes' ports until then, so each name moves onto the tunnel, and
# back, by its record alone: list a name (spec.tunnel.hostnames) before its
# record moves, or the tunnel answers it 404.
[[- if .TunnelPublish ]] With spec.tunnel.publish external-dns publishes the
# edge's own names there (gateway.yaml); a person makes the others' records.
[[- else ]] external-dns publishes the edge's own names at the nodes'
# addresses, as before, and a person points a name at the tunnel.
[[- end ]]
#
# cloudflared dials out to Cloudflare on port 7844 (QUIC on UDP, or HTTP/2 on
# TCP), and Cloudflare's edge sends each request for the tunnel's names down
# that connection. cloudflared forwards it to Envoy's Service edge
# (gateway.yaml), by the name its route gives. Over HTTPS it checks Envoy's
# certificate against the roots it holds, the system's and Cloudflare's Origin
# CA, built into cloudflared: every certificate this edge shows comes from one
# of them (Let's Encrypt for custom hostnames, the Origin CA for the rest), so
# no route needs a caPool.
#
# Its routes, the first that matches wins:
#   /.well-known/acme-challenge/  Envoy's plain HTTP, for any name: a custom
#                  hostname's Let's Encrypt challenge reaches the solver on the
#                  listener http-any (certificate.yaml) through the tunnel too
[[- if $infrared ]]
#   [[ .InfraredHost ]]  Infrared, by that name (originServerName)
[[- end ]]
[[- range .TunnelHostnames ]]
#   [[ . ]]  by that name (originServerName)
[[- end ]]
[[- if .PlatformDomain ]]
#   *.[[ .PlatformDomain ]]  the zones, each by its own name (matchSNItoHost)
[[- end ]]
#   anything else  404, never Envoy
#
# Envoy picks a listener by the TLS name a connection carries (SNI), and each
# name it serves on a listener of its own, Infrared's, a zone's own address, a
# custom hostname or a name a person adds, finds its routes only there.
# cloudflared keeps one pool of connections to Envoy for each route here, and
# reuses one for any request its route takes, whatever the request's name: a
# route that took two such names would send one name's request down a
# connection made for the other, which Envoy answers 404 (NR). So each of
# those names has a route of its own, with its name fixed (originServerName):
# the Installation's spec.tunnel.hostnames lists the ones the template cannot
# see, among them a zone's own addresses and the custom hostnames once their
# records point at the tunnel. The zones share one listener, the wildcard,
# so their one route may take each request's own name. A name listed nowhere
# gets cloudflared's 404, so only the names above reach Envoy through the
# tunnel; any other name keeps the nodes' ports.
#
# Two replicas, never on one node, each holding connections of its own, so a
# node that goes takes one replica and none of the names. cloudflared reads
# its config and credentials only at start, so the pods carry the tunnel, its
# credentials' key and its routes in an annotation, and a change of any rolls
# them.
#
# Waves: the credentials' copy first (-7), before the edge's certificates,
# since External Secrets' webhook admits it; cloudflared last (2), after the
# Gateway and its certificate, and after Let's Encrypt's issuer (1), which
# cert-manager's webhook admits and so keeps a wave of its own. Beside the
# nodes' ports the tunnel is no name's only way in, so it may wait for it.
# =============================================================================
[[- else -]]
# =============================================================================
# cloudflared: the edge's Cloudflare Tunnel.
# =============================================================================
# The Installation's spec.tunnel (infrared-docs-internal ADR 0064): a locally
# managed tunnel, [[ .TunnelID ]], whose routes are these,
# rendered from the Installation's names and never kept in Cloudflare's
# dashboard. cloudflared dials out to Cloudflare on port 7844 (QUIC on UDP, or
# HTTP/2 on TCP), and Cloudflare's edge sends each request for the tunnel's
# names down that connection. cloudflared forwards it to Envoy's Service edge
# (gateway.yaml) over TLS, as the request's own name, and checks Envoy's
# certificate against the edge's own authority (certificate.yaml, caPool).
# The edge's names are proxied CNAMEs, made once by a person, to
# [[ .TunnelID ]].cfargotunnel.com: nothing here writes DNS.
#
# Its routes, the first that matches wins:
[[- if $infrared ]]
#   [[ .InfraredHost ]]  Infrared, by that name (originServerName)
[[- end ]]
[[- range .TunnelHostnames ]]
#   [[ . ]]  by that name (originServerName)
[[- end ]]
[[- if .PlatformDomain ]]
#   *.[[ .PlatformDomain ]]  the zones, each by its own name (matchSNItoHost)
[[- end ]]
#   anything else  404
[[- if or .TunnelHostnames .CustomHostnames ]]
#
# Envoy picks a listener by the TLS name a connection carries (SNI), and each
# name it serves on a listener of its own finds its routes only there.
# cloudflared keeps one pool of connections to Envoy for each route here, and
# reuses one for any request its route takes, whatever the request's name, so
# each such name has a route of its own, with its name fixed
# (originServerName): the Installation's spec.tunnel.hostnames lists them, a
# custom hostname (spec.previews.customHostnames) among them. A name listed
# nowhere gets cloudflared's 404.
[[- end ]]
#
# Two replicas, never on one node, each holding connections of its own, so a
# node that goes takes one replica and none of the names. cloudflared reads
# its config and credentials only at start, so the pods carry the tunnel, its
# credentials' key and its routes in an annotation, and a change of any rolls
# them.
#
# Waves: the credentials' copy first (-7), before the edge's certificates,
# since External Secrets' webhook admits it; cloudflared last (1), after the
# Gateway and its certificate, since it takes visitors the moment it
# connects.
# =============================================================================
[[- end ]]
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: cloudflared-credentials
  namespace: envoy-gateway-system
  annotations:
    argocd.argoproj.io/sync-wave: "-7"
spec:
  refreshInterval: 1h0m0s
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-platform
  target:
    name: cloudflared-credentials
    creationPolicy: Owner
    deletionPolicy: Retain
  data:
    - secretKey: credentials.json
      remoteRef:
        key: infrared-platform-tokens
        property: [[ $key | quote ]]
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: cloudflared
  namespace: envoy-gateway-system
  annotations:
    argocd.argoproj.io/sync-wave: "[[ if $beside ]]2[[ else ]]1[[ end ]]"
data:
  config.yaml: |
    tunnel: [[ .TunnelID | quote ]]
    credentials-file: /etc/cloudflared/credentials/credentials.json
    metrics: 0.0.0.0:2000
    no-autoupdate: true
    ingress:
[[- if $beside ]]
      - path: ^/\.well-known/acme-challenge/
        service: http://edge.envoy-gateway-system.svc.cluster.local:80
[[- if $infrared ]]
      - hostname: [[ .InfraredHost | quote ]]
        service: [[ $edge ]]
        originRequest:
          originServerName: [[ .InfraredHost | quote ]]
          http2Origin: true
[[- end ]]
[[- range .TunnelHostnames ]]
      - hostname: [[ . | quote ]]
        service: [[ $edge ]]
        originRequest:
          originServerName: [[ . | quote ]]
          http2Origin: true
[[- end ]]
[[- if .PlatformDomain ]]
      - hostname: [[ printf "*.%s" .PlatformDomain | quote ]]
        service: [[ $edge ]]
        originRequest:
          matchSNItoHost: true
          http2Origin: true
[[- end ]]
      - service: http_status:404
[[- else ]]
[[- if $infrared ]]
      - hostname: [[ .InfraredHost | quote ]]
        service: [[ $edge ]]
        originRequest:
          originServerName: [[ .InfraredHost | quote ]]
          caPool: /etc/cloudflared/ca/ca.crt
          http2Origin: true
[[- end ]]
[[- range .TunnelHostnames ]]
      - hostname: [[ . | quote ]]
        service: [[ $edge ]]
        originRequest:
          originServerName: [[ . | quote ]]
          caPool: /etc/cloudflared/ca/ca.crt
          http2Origin: true
[[- end ]]
[[- if .PlatformDomain ]]
      - hostname: [[ printf "*.%s" .PlatformDomain | quote ]]
        service: [[ $edge ]]
        originRequest:
          matchSNItoHost: true
          caPool: /etc/cloudflared/ca/ca.crt
          http2Origin: true
[[- end ]]
      - service: http_status:404
[[- end ]]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: cloudflared
  namespace: envoy-gateway-system
  labels:
    app.kubernetes.io/name: cloudflared
  annotations:
    argocd.argoproj.io/sync-wave: "[[ if $beside ]]2[[ else ]]1[[ end ]]"
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: cloudflared
  # One pod at a time, the other keeping its connections: with the replicas
  # on two nodes, a surge pod would find no node on a cluster of two.
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxSurge: 0
      maxUnavailable: 1
  template:
    metadata:
      labels:
        app.kubernetes.io/name: cloudflared
      annotations:
        # The tunnel, its credentials' key and its routes, read at start.
        infrared.darkshift.io/tunnel: "[[ .TunnelID ]] [[ $key ]][[ if $beside ]] beside acme[[ end ]][[ with $infrared ]] [[ . ]][[ end ]][[ range .TunnelHostnames ]] [[ . ]][[ end ]][[ with .PlatformDomain ]] *.[[ . ]][[ end ]] 404"
    spec:
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels:
                  app.kubernetes.io/name: cloudflared
              topologyKey: kubernetes.io/hostname
      # cloudflared never talks to the Kubernetes API.
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: cloudflared
          # cloudflared 2026.10.5, the image list's digest. Its entrypoint is
          # cloudflared --no-autoupdate; it runs as 65532, distroless.
          image: docker.io/cloudflare/cloudflared:2026.10.5@sha256:1b1d34d0a9c0bfca9de72db8460d328db3f19edd2b96169114e3e893a97bbe53
          args:
            - tunnel
            - --config
            - /etc/cloudflared/config/config.yaml
            - run
          ports:
            - name: metrics
              containerPort: 2000
              protocol: TCP
          # /ready answers 200 once the replica holds a connection to
          # Cloudflare's edge.
          readinessProbe:
            httpGet:
              path: /ready
              port: metrics
            periodSeconds: 10
            failureThreshold: 3
          livenessProbe:
            httpGet:
              path: /ready
              port: metrics
            initialDelaySeconds: 10
            periodSeconds: 10
            failureThreshold: 6
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 20m
              memory: 64Mi
            limits:
              memory: 256Mi
          volumeMounts:
            - name: config
              mountPath: /etc/cloudflared/config
              readOnly: true
            - name: credentials
              mountPath: /etc/cloudflared/credentials
              readOnly: true
[[- if not $beside ]]
            - name: ca
              mountPath: /etc/cloudflared/ca
              readOnly: true
[[- end ]]
      volumes:
        - name: config
          configMap:
            name: cloudflared
        - name: credentials
          secret:
            secretName: cloudflared-credentials
[[- if not $beside ]]
        # The authority's certificate alone, never its key.
        - name: ca
          secret:
            secretName: edge-ca
            items:
              - key: ca.crt
                path: ca.crt
[[- end ]]
---
# A drain keeps one replica, and with it the tunnel, up.
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: cloudflared
  namespace: envoy-gateway-system
  annotations:
    argocd.argoproj.io/sync-wave: "[[ if $beside ]]2[[ else ]]1[[ end ]]"
spec:
  minAvailable: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: cloudflared
[[- else -]]
# The edge is not a Gateway with a name to serve behind a Cloudflare Tunnel
# (the Installation's spec.tunnel): no cloudflared.
[[- end ]]
