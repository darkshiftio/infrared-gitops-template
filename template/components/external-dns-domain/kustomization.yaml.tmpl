[[- if and (eq .Edge "gateway") .PrivateEdge .PlatformDomain .DomainTokenKey -]]
# external-dns-domain does not run with the edge private (the Installation's
# spec.privateEdge, infrared-docs-internal ADR 0100): no record names the
# platform domain's wildcard, and its own token is not read. This component
# holds no objects and no Application points at it.
[[- else if and (eq .Edge "gateway") .TunnelID (ne .TunnelMode "beside") .PlatformDomain .DomainTokenKey -]]
# external-dns-domain does not run behind a Cloudflare Tunnel (the
# Installation's spec.tunnel, infrared-docs-internal ADR 0064): the platform
# domain's wildcard is a proxied CNAME to the tunnel, made once by a person.
# This component holds no objects and no Application points at it.
[[- else if and (eq .Edge "gateway") .PlatformDomain .DomainTokenKey -]]
# The second source of the `external-dns-domain` Application (wave 12): the
# platform domain's own Cloudflare token, copied from the platform's tokens,
# and the hook that waits for them. Every object is in the namespace
# external-dns, beside external-dns's own.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - wait.yaml
  - cloudflare-domain-api-token.yaml
[[- else -]]
# external-dns-domain runs only when the platform domain has a Cloudflare token
# of its own, so this component holds no objects and no Application points at
# it.
[[- end ]]
