[[- if and .Stores .Backup.Bucket .Restore.Point -]]
# The `stores-restore` Application (wave 18), while a restore is in progress:
# the wait for Postgres (wait.yaml), then the buckets' copy back once the
# Infrared chart's restore has brought Postgres's records back (restore.yaml).
# Every object names its own namespace.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - wait.yaml
  - restore.yaml
[[- else -]]
# No restore is in progress, so this component holds no objects and no
# Application points at it.
[[- end ]]
