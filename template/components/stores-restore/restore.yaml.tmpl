[[- $copies := and .Stores .Backup.Bucket .Copies.Recipients -]]
[[- if and .Stores .Backup.Bucket .Restore.Point -]]
# =============================================================================
# A restore, from [[ .Restore.Point ]]: the stores come back.
# =============================================================================
# The Infrared operator restored its own objects from the copy [[ .Restore.Point ]], and
# Postgres recovered from the archive outside the cluster (components/postgres,
# the Cluster's bootstrap). SeaweedFS's data was on the lost nodes' disks, so
# two Jobs, in order, bring the stores back, and mark the ConfigMap
# stores/restore-stores after each, for this point:
#
#   stores-index-reset  The recovered Postgres holds the lost cluster's file
#                       index, whose entries name data that went with the
#                       lost nodes; a copy back would skip those objects as
#                       present. As the role seaweedfs, it drops everything
#                       that role owns, once: it notes the point on the
#                       database seaweedfs in the same transaction, and does
#                       nothing when the note is there. Then it marks postgres,
#                       which SeaweedFS waits for (components/seaweedfs).
#   stores-restore      Copies every bucket back from the copy outside the
#                       cluster, [[ .Backup.Bucket ]]/[[ .ClusterName ]]/seaweedfs/current/<bucket>,
#                       as the S3 identity restore, skipping any object
#                       already there, so a second run never overwrites one.
#                       Then it marks buckets, which Zot, Agent Substrate and
#                       the hourly mirror wait for.
#
# The operator marks the restore Complete once buckets is marked, and stops
# rendering this. Neither Job is ever deleted by a timer: Argo CD would make a
# deleted one again, and run it again.
# =============================================================================
apiVersion: v1
kind: ServiceAccount
metadata:
  name: stores-restore
  namespace: stores
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
---
# The markers: make the ConfigMap restore-stores, then read and mark that one.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: stores-restore
  namespace: stores
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
rules:
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["create"]
  - apiGroups: [""]
    resources: ["configmaps"]
    resourceNames: ["restore-stores"]
    verbs: ["get", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: stores-restore
  namespace: stores
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: stores-restore
subjects:
  - kind: ServiceAccount
    name: stores-restore
    namespace: stores
---
apiVersion: batch/v1
kind: Job
metadata:
  name: stores-index-reset
  namespace: stores
  annotations:
    argocd.argoproj.io/sync-wave: "0"
spec:
  backoffLimit: 6
  activeDeadlineSeconds: 7200
  template:
    spec:
      serviceAccountName: stores-restore
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: reset
          # The platform's Postgres image, by digest, for psql.
          image: ghcr.io/cloudnative-pg/postgresql:18.6-standard-trixie@sha256:f89a40f4d74aa6e0900917eaf6299b125a6382eb02fd4ee5d46f55bcbf7e5726
          env:
            - name: HOME
              value: /tmp
            - name: POINT
              value: [[ .Restore.Point | quote ]]
            - name: PGHOST
              value: postgres-rw.stores.svc
            - name: PGPORT
              value: "5432"
            - name: PGDATABASE
              value: seaweedfs
            - name: PGSSLMODE
              value: require
            - name: PGCONNECT_TIMEOUT
              value: "10"
            - name: PGUSER
              valueFrom:
                secretKeyRef:
                  name: postgres-seaweedfs
                  key: username
            - name: PGPASSWORD
              valueFrom:
                secretKeyRef:
                  name: postgres-seaweedfs
                  key: password
          command:
            - /bin/sh
            - -ec
            - |
              # The role's password reaches Postgres a moment after it has
              # recovered (its DatabaseRole): sign in until it works.
              until psql -X -q -c 'SELECT 1' >/dev/null 2>&1; do
                echo "waiting to sign in to Postgres as seaweedfs"
                sleep 10
              done
              psql -X -v ON_ERROR_STOP=1 -v point="$POINT" <<'SQL'
              SET infrared.restore_point = :'point';
              DO $$
              DECLARE
                want text := 'infrared-restore ' || current_setting('infrared.restore_point') || ': file index reset';
                have text;
              BEGIN
                SELECT coalesce(shobj_description(oid, 'pg_database'), '') INTO have
                  FROM pg_database WHERE datname = current_database();
                IF have = want THEN
                  RAISE NOTICE 'the file index was reset for this restore already: nothing done';
                ELSE
                  DROP OWNED BY seaweedfs;
                  EXECUTE format('COMMENT ON DATABASE %I IS %L', current_database(), want);
                  RAISE NOTICE 'dropped what seaweedfs owned: the lost cluster''s file index';
                END IF;
              END $$;
              SQL
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 256Mi
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      containers:
        - name: mark
          # alpine/k8s 1.37.0: kubectl and a busybox shell.
          image: docker.io/alpine/k8s:1.37.0@sha256:b421c2e9419edb98db39b6ab641669f4db7bb2acf354f22450c6b7e7176d1ff4
          env:
            - name: HOME
              value: /tmp
            - name: POINT
              value: [[ .Restore.Point | quote ]]
            - name: MARKER
              value: postgres
          command:
            - /bin/sh
            - -ec
            - |
              kubectl -n stores create configmap restore-stores --from-literal=point="$POINT" >/dev/null 2>&1 || true
              have="$(kubectl -n stores get configmap restore-stores -o jsonpath='{.data.point}')"
              if [ "$have" != "$POINT" ]; then
                echo "stores/restore-stores belongs to the restore from $have, not $POINT: nothing marked" >&2
                exit 1
              fi
              kubectl -n stores patch configmap restore-stores --type merge \
                -p "{\"data\":{\"$MARKER\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}}" >/dev/null
              echo "marked $MARKER for the restore from $POINT"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 128Mi
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: stores-restore
  namespace: stores
  annotations:
    # After the file index is reset (0).
    argocd.argoproj.io/sync-wave: "1"
spec:
  backoffLimit: 6
  activeDeadlineSeconds: 14400
  template:
    spec:
      serviceAccountName: stores-restore
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: copy
          # The hourly mirror's rclone, by digest.
          image: docker.io/rclone/rclone:1.75.1@sha256:45401ad7410db1d67ffdb58e19059ad20b0d8e0285a60e38bbec55cc1019c7a5
          env:
            - name: HOME
              value: /tmp
            - name: BUCKETS
              value: "ate-snapshots registry[[ if $copies ]] infrared-objects gitea-dumps[[ end ]]"
            - name: SOURCE
              value: [[ printf "outside:%s/%s/seaweedfs/current" .Backup.Bucket .ClusterName | quote ]]
            # The source: the copy outside the cluster, with the platform's
            # backup keys (Secret seaweedfs-backup, components/seaweedfs).
            - name: RCLONE_CONFIG_OUTSIDE_TYPE
              value: s3
            - name: RCLONE_CONFIG_OUTSIDE_PROVIDER
              value: [[ if .Backup.Endpoint ]]Other[[ else ]]AWS[[ end ]]
[[- if .Backup.Endpoint ]]
            - name: RCLONE_CONFIG_OUTSIDE_ENDPOINT
              value: [[ .Backup.Endpoint | quote ]]
[[- end ]]
[[- if .Backup.Region ]]
            - name: RCLONE_CONFIG_OUTSIDE_REGION
              value: [[ .Backup.Region | quote ]]
[[- end ]]
            - name: RCLONE_CONFIG_OUTSIDE_NO_CHECK_BUCKET
              value: "true"
            - name: RCLONE_CONFIG_OUTSIDE_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: seaweedfs-backup
                  key: ACCESS_KEY_ID
            - name: RCLONE_CONFIG_OUTSIDE_SECRET_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: seaweedfs-backup
                  key: ACCESS_SECRET_KEY
            # The destination: SeaweedFS, as the identity restore.
            - name: RCLONE_CONFIG_SEAWEEDFS_TYPE
              value: s3
            - name: RCLONE_CONFIG_SEAWEEDFS_PROVIDER
              value: SeaweedFS
            - name: RCLONE_CONFIG_SEAWEEDFS_ENDPOINT
              value: http://seaweedfs-s3.stores.svc:8333
            - name: RCLONE_CONFIG_SEAWEEDFS_ACCESS_KEY_ID
              valueFrom:
                secretKeyRef:
                  name: seaweedfs-s3-restore
                  key: AWS_ACCESS_KEY_ID
            - name: RCLONE_CONFIG_SEAWEEDFS_SECRET_ACCESS_KEY
              valueFrom:
                secretKeyRef:
                  name: seaweedfs-s3-restore
                  key: AWS_SECRET_ACCESS_KEY
          command:
            - /bin/sh
            - -ec
            - |
              # SeaweedFS's chart makes the buckets after its first sync, which
              # waits for the file index's reset.
              for bucket in $BUCKETS; do
                until rclone lsf --max-depth 1 "seaweedfs:$bucket" >/dev/null 2>&1; do
                  echo "waiting for the bucket $bucket in SeaweedFS"
                  sleep 10
                done
              done
              for bucket in $BUCKETS; do
                # Only a copy that lists empty is skipped. A listing that fails
                # (a key, the network, a missing bucket) fails the Job, which
                # runs again, rather than mark a bucket it never copied.
                if ! listed="$(rclone lsf --max-depth 1 "$SOURCE/$bucket")"; then
                  echo "could not list $SOURCE/$bucket: nothing marked" >&2
                  exit 1
                fi
                if [ -z "$listed" ]; then
                  echo "the copy outside holds nothing for $bucket: nothing to copy back"
                  continue
                fi
                # Never overwrite: an object already in the bucket stays as it is.
                rclone copy "$SOURCE/$bucket" "seaweedfs:$bucket" --ignore-existing \
                  --fast-list --stats-one-line --stats 1m -v
              done
              echo "copied $BUCKETS back from $SOURCE"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 50m
              memory: 64Mi
            limits:
              memory: 512Mi
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      containers:
        - name: mark
          # alpine/k8s 1.37.0: kubectl and a busybox shell.
          image: docker.io/alpine/k8s:1.37.0@sha256:b421c2e9419edb98db39b6ab641669f4db7bb2acf354f22450c6b7e7176d1ff4
          env:
            - name: HOME
              value: /tmp
            - name: POINT
              value: [[ .Restore.Point | quote ]]
            - name: MARKER
              value: buckets
          command:
            - /bin/sh
            - -ec
            - |
              kubectl -n stores create configmap restore-stores --from-literal=point="$POINT" >/dev/null 2>&1 || true
              have="$(kubectl -n stores get configmap restore-stores -o jsonpath='{.data.point}')"
              if [ "$have" != "$POINT" ]; then
                echo "stores/restore-stores belongs to the restore from $have, not $POINT: nothing marked" >&2
                exit 1
              fi
              kubectl -n stores patch configmap restore-stores --type merge \
                -p "{\"data\":{\"$MARKER\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}}" >/dev/null
              echo "marked $MARKER for the restore from $POINT"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 128Mi
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
[[- else -]]
# No restore is in progress (the Infrared operator's restore point is empty),
# or there are no stores or backup bucket: nothing to bring back.
[[- end ]]
