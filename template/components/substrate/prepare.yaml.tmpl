[[- if and .Stores .SubstrateCapable .Registry -]]
# =============================================================================
# Before the control plane: what Substrate's installer does by hand.
# =============================================================================
# This PreSync hook does, in order, what ate-setup does before it applies the
# control plane (cmd/ate-setup, prereqs.go, create.go, version.go), each step
# safe to run again:
#
#   1. The actor-identity pools, made once and never replaced:
#        actor-id-jwt-pool   ES256 key the API signs actors' JWTs with
#        actor-id-ca-pool    Ed25519 CA the API signs actors' certificates
#                            with, as Substrate's localca reads it; its root
#                            valid 365 days, its expiry in the annotation
#                            infrared.darkshift.io/not-after
#        actor-id-ca-certs   that CA's root alone, for the egress gateway
#      OpenSSL makes the candidates in memory, in the hook's own pod; one it
#      does not write goes with the pod.
#   2. The API's authentication settings, the ConfigMap ate-api-authentication:
#      it trusts the cluster's ServiceAccount tokens for the audience
#      api.ate-system.svc, the issuer read from the cluster's discovery
#      document.
#   3. The label ate.dev/substrate-version=one-install-ce05e5d-7e86cab on every node that has none: atelet and
#      the workers run only on labelled nodes. node-labels.yaml labels a node
#      that joins later.
#   4. Waits, up to half an hour, for Substrate's CRDs, the pod-certificate
#      controller's trust bundles, the platform's Postgres and SeaweedFS's S3
#      gateway, and the stores the ExternalSecrets copy through.
#
# The hook prints the CA's expiry at every sync.
# =============================================================================
apiVersion: v1
kind: ServiceAccount
metadata:
  name: substrate-prepare
  namespace: ate-system
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
---
# Read only, but for the nodes' label: CRDs, EndpointSlices,
# ClusterSecretStores and ClusterTrustBundles; nodes, to label them.
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: infrared-substrate-prepare
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
rules:
  - apiGroups: ["apiextensions.k8s.io"]
    resources: ["customresourcedefinitions"]
    verbs: ["get"]
  - apiGroups: ["discovery.k8s.io"]
    resources: ["endpointslices"]
    verbs: ["list"]
  - apiGroups: ["external-secrets.io"]
    resources: ["clustersecretstores"]
    verbs: ["get"]
  - apiGroups: ["certificates.k8s.io"]
    resources: ["clustertrustbundles"]
    verbs: ["get"]
  # kubectl label reads the node before it patches it.
  - apiGroups: [""]
    resources: ["nodes"]
    verbs: ["get", "list", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: infrared-substrate-prepare
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: infrared-substrate-prepare
subjects:
  - kind: ServiceAccount
    name: substrate-prepare
    namespace: ate-system
---
# Make the pools once, read them to see whether they exist; write the one
# ConfigMap. Nothing else.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: substrate-prepare
  namespace: ate-system
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
rules:
  - apiGroups: [""]
    resources: ["secrets"]
    resourceNames: ["actor-id-jwt-pool", "actor-id-ca-pool", "actor-id-ca-certs"]
    verbs: ["get"]
  - apiGroups: [""]
    resources: ["secrets"]
    verbs: ["create"]
  - apiGroups: [""]
    resources: ["configmaps"]
    resourceNames: ["ate-api-authentication"]
    verbs: ["get", "patch"]
  - apiGroups: [""]
    resources: ["configmaps"]
    verbs: ["create"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: substrate-prepare
  namespace: ate-system
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-10"
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: substrate-prepare
subjects:
  - kind: ServiceAccount
    name: substrate-prepare
    namespace: ate-system
---
apiVersion: batch/v1
kind: Job
metadata:
  name: substrate-prepare
  namespace: ate-system
  annotations:
    argocd.argoproj.io/hook: PreSync
    argocd.argoproj.io/hook-delete-policy: BeforeHookCreation
    argocd.argoproj.io/sync-wave: "-9"
spec:
  # Half an hour, then the sync fails and Argo CD retries it, waiting again.
  activeDeadlineSeconds: 1800
  backoffLimit: 6
  ttlSecondsAfterFinished: 3600
  template:
    spec:
      serviceAccountName: substrate-prepare
      restartPolicy: OnFailure
      securityContext:
        runAsNonRoot: true
        runAsUser: 65534
        runAsGroup: 65534
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        # Candidate pools, in memory. prepare below keeps a Secret that exists.
        - name: generate
          # alpine/openssl 3.5.9: OpenSSL and a busybox shell.
          image: docker.io/alpine/openssl:3.5.9@sha256:59c5cb51e536d40587667229468b007a2a6cae1705397e59e5f7774c08b74029
          workingDir: /work
          env:
            - name: HOME
              value: /work
          command:
            - /bin/sh
            - -ec
            - |
              umask 077
              # A root as Substrate's localca.GenerateCA makes it: a random
              # common name, CA, critical key usage digitalSignature and
              # keyCertSign, 365 days.
              cat >ca.cnf <<'CNF'
              [req]
              distinguished_name = dn
              x509_extensions = ca
              prompt = no
              [dn]
              CN = substrate
              [ca]
              basicConstraints = critical,CA:TRUE
              keyUsage = critical,digitalSignature,keyCertSign
              subjectKeyIdentifier = hash
              CNF
              # A PEM file's body is the base64 of its DER, as Go's JSON
              # encodes []byte.
              body() { sed '/^-----/d' "$1" | tr -d '\n'; }
              mkdir actor-id-ca-pool actor-id-jwt-pool
              openssl genpkey -algorithm ed25519 -out actor-id-ca-pool/tls.key
              openssl req -x509 -new -config ca.cnf -key actor-id-ca-pool/tls.key -days 365 \
                -subj "/CN=$(openssl rand -hex 16)" -out actor-id-ca-pool/tls.crt
              printf '{"CAs":[{"ID":"1","SigningKeyPKCS8":"%s","RootCertificateDER":"%s"}],"ActiveForSigning":"1"}' \
                "$(body actor-id-ca-pool/tls.key)" "$(body actor-id-ca-pool/tls.crt)" >actor-id-ca-pool/pool
              openssl x509 -in actor-id-ca-pool/tls.crt -noout -enddate -dateopt iso_8601 | sed 's/^notAfter=//' >actor-id-ca-pool/not-after
              # localjwtauthority's pool: one ES256 key, id 1, active for signing.
              openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out actor-id-jwt-pool/key.pem
              printf '{"Authorities":[{"ID":"1","Algorithm":"ES256","SigningKeyPKCS8":"%s"}],"ActiveForSigning":"1"}' \
                "$(body actor-id-jwt-pool/key.pem)" >actor-id-jwt-pool/pool
              echo "candidate pools made"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 10m
              memory: 16Mi
            limits:
              memory: 64Mi
          volumeMounts:
            - name: work
              mountPath: /work
      containers:
        - name: prepare
          # alpine/k8s 1.37.0: kubectl, jq and a busybox shell.
          image: docker.io/alpine/k8s:1.37.0@sha256:b421c2e9419edb98db39b6ab641669f4db7bb2acf354f22450c6b7e7176d1ff4
          env:
            - name: HOME
              value: /tmp
            - name: SUBSTRATE_VERSION
              value: one-install-ce05e5d-7e86cab
            - name: WAIT_CRDS
              value: "workerpools.ate.dev sandboxconfigs.ate.dev externalsecrets.external-secrets.io"
            - name: WAIT_BUNDLES
              value: "servicedns.podcert.ate.dev:identity:primary-bundle podidentity.podcert.ate.dev:identity:primary-bundle"
            - name: WAIT_SERVICES
              value: "stores/postgres-rw stores/seaweedfs-s3"
            - name: WAIT_STORES
              value: "infrared-stores[[ if .ImagePullSecret ]] infrared-platform[[ end ]]"
          command:
            - /bin/sh
            - -ec
            - |
              present() { kubectl get secret "$1" -o name >/dev/null 2>&1; }
              # 1. The actor-identity pools, made once and never replaced.
              # Nothing prints a key.
              if present actor-id-jwt-pool; then
                echo "actor-id-jwt-pool exists; leaving it alone"
              else
                kubectl create -f - >/dev/null <<EOF
              apiVersion: v1
              kind: Secret
              type: Opaque
              metadata:
                name: actor-id-jwt-pool
              data:
                pool: $(base64 -w 0 </work/actor-id-jwt-pool/pool)
              EOF
                echo "created actor-id-jwt-pool"
              fi
              if present actor-id-ca-pool; then
                echo "actor-id-ca-pool exists; leaving it alone"
              else
                kubectl create -f - >/dev/null <<EOF
              apiVersion: v1
              kind: Secret
              type: kubernetes.io/tls
              metadata:
                name: actor-id-ca-pool
                labels:
                  infrared.darkshift.io/substrate-ca: "true"
                annotations:
                  infrared.darkshift.io/not-after: "$(cat /work/actor-id-ca-pool/not-after)"
              data:
                pool: $(base64 -w 0 </work/actor-id-ca-pool/pool)
                tls.crt: $(base64 -w 0 </work/actor-id-ca-pool/tls.crt)
                tls.key: $(base64 -w 0 </work/actor-id-ca-pool/tls.key)
              EOF
                echo "created actor-id-ca-pool"
              fi
              expires="$(kubectl get secret actor-id-ca-pool -o jsonpath='{.metadata.annotations.infrared\.darkshift\.io/not-after}')"
              echo "CA ate-system/actor-id-ca-pool expires ${expires:-on a date nobody recorded}"
              # The pool's root alone (it holds one CA), which the egress
              # gateway verifies actors' certificates against.
              if present actor-id-ca-certs; then
                echo "actor-id-ca-certs exists; leaving it alone"
              else
                kubectl create -f - >/dev/null <<EOF
              apiVersion: v1
              kind: Secret
              type: Opaque
              metadata:
                name: actor-id-ca-certs
              data:
                ca.crt: $(kubectl get secret actor-id-ca-pool -o jsonpath='{.data.tls\.crt}')
              EOF
                echo "created actor-id-ca-certs"
              fi

              # 2. The API's authentication settings, as ate-setup writes them
              # (buildAuthenticationConfig): an issuer inside the cluster is
              # reached with the pod's own CA and token.
              issuer="$(kubectl get --raw /.well-known/openid-configuration | jq -r '.issuer // ""')"
              [ -n "$issuer" ] || { echo "the cluster publishes no ServiceAccount issuer" >&2; exit 1; }
              {
                printf 'actorIdentityJWTProvider: kubernetes\njwtProviders:\n- name: kubernetes\n  issuer: %s\n  audiences: [api.ate-system.svc]' "$issuer"
                case "$issuer" in
                  https://kubernetes.default.svc | https://kubernetes.default.svc.cluster.local)
                    printf '\n  certificateAuthorityFile: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt'
                    printf '\n  discoveryTokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token'
                    ;;
                esac
              } >/tmp/authentication.yaml
              if [ "$(kubectl get configmap ate-api-authentication -o jsonpath='{.data.authentication\.yaml}' 2>/dev/null)" = "$(cat /tmp/authentication.yaml)" ]; then
                echo "ate-api-authentication trusts $issuer already"
              else
                kubectl create configmap ate-api-authentication --from-file=authentication.yaml=/tmp/authentication.yaml \
                  --dry-run=client -o yaml | kubectl apply --server-side --field-manager=substrate-prepare --force-conflicts -f - >/dev/null
                echo "ate-api-authentication trusts $issuer (a running API reads it at its next start)"
              fi

              # 3. The nodes' label: a node that has one keeps it, as ate-setup
              # leaves it (an upgrade moves it node by node).
              for node in $(kubectl get nodes -l '!ate.dev/substrate-version' -o name); do
                kubectl label "$node" "ate.dev/substrate-version=$SUBSTRATE_VERSION" >/dev/null
                echo "labelled $node ate.dev/substrate-version=$SUBSTRATE_VERSION"
              done
              echo "$(kubectl get nodes -l "ate.dev/substrate-version=$SUBSTRATE_VERSION" -o name | wc -l | tr -d ' ') of $(kubectl get nodes -o name | wc -l | tr -d ' ') nodes run Substrate $SUBSTRATE_VERSION"

              # 4. Waits. Each list is space-separated; an empty one waits for nothing.
              established() {
                [ "$(kubectl get crd "$1" -o jsonpath='{.status.conditions[?(@.type=="Established")].status}' 2>/dev/null)" = True ]
              }
              answering() {
                kubectl -n "${1%%/*}" get endpointslices -l "kubernetes.io/service-name=${1#*/}" \
                  -o jsonpath='{.items[*].endpoints[*].conditions.ready}' 2>/dev/null | grep -qw true
              }
              store_ready() {
                [ "$(kubectl get clustersecretstore "$1" -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null)" = True ]
              }
              bundle() {
                kubectl get clustertrustbundles "$1" -o name >/dev/null 2>&1
              }
              for crd in $WAIT_CRDS; do
                until established "$crd"; do echo "waiting for the CRD $crd"; sleep 5; done
              done
              for b in $WAIT_BUNDLES; do
                until bundle "$b"; do echo "waiting for the ClusterTrustBundle $b"; sleep 5; done
              done
              for svc in $WAIT_SERVICES; do
                until answering "$svc"; do echo "waiting for a ready endpoint of the Service $svc"; sleep 5; done
              done
              for store in $WAIT_STORES; do
                until store_ready "$store"; do echo "waiting for the ClusterSecretStore $store to be Ready"; sleep 5; done
              done
              echo "everything this component needs answers"
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 10m
              memory: 32Mi
            limits:
              memory: 128Mi
          volumeMounts:
            - name: work
              mountPath: /work
              readOnly: true
            - name: tmp
              mountPath: /tmp
      volumes:
        # The candidate keys never touch a disk.
        - name: work
          emptyDir:
            medium: Memory
            sizeLimit: 1Mi
        - name: tmp
          emptyDir: {}
[[- else -]]
# Agent Substrate runs only where the operator's preflight found the cluster able
# to host it, with the platform's own stores and the registry inside the
# cluster: nothing to prepare.
[[- end ]]
