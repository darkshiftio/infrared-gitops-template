[[- if and .Stores .SubstrateCapable .Registry -]]
# =============================================================================
# The control plane's credentials, each copied from where its owner keeps it.
# =============================================================================
#   Secret                          from                                     through
#   ate-s3-credentials-v1           stores/seaweedfs-s3-ate-snapshots-v1     infrared-stores
#     the S3 identity ate-snapshots-v1: Read, Write, List and Tagging on the
#     bucket ate-snapshots, where Substrate 1.0 keeps its snapshots, under v1/;
#     the objectstore-plugin sidecars of the API and atelet read it
#   ate-api-server-secret-envvars   stores/postgres-substrate-v1-owner-user  infrared-stores
#                                   stores/postgres-substrate-v1-readwrite-user
#     the API's two Postgres DSNs and its schema, as Substrate's installer
#     writes them: the logins substrate_v1_owner_user (migrations) and
#     substrate_v1_readwrite_user (everything else) on the platform's one
#     Postgres, the database substrate_v1, schema substrate, TLS as SeaweedFS's
#     filers use it
[[- if .ImagePullSecret ]]
#   [[ .ImagePullSecret ]]   [[ .InfraredNamespace ]]/[[ .ImagePullSecret ]]   infrared-platform
#     the pull secret for Substrate's images[[ if .RegistryToken.Registry ]], a registry token
#     copied every 5 minutes[[ end ]]
[[- end ]]
#
# Substrate before 1.0 kept its records in the database substrate, as the role
# substrate, and its snapshots as the S3 identity ate-snapshots: both stay in
# the stores, untouched and unused, and no copy of them is made here any more.
#
# Neither store hands out anything else: each reads only the Secrets its Role
# names, for the namespaces its conditions admit. The values the API server
# would fill in are written out, so Argo CD compares like with like.
#
# Wave -2, alone: External Secrets' webhook admits them, so they are applied,
# and synced, before what reads their Secrets (-1 and 0). A refused apply then
# fails the sync, which Argo CD retries.
# =============================================================================
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ate-s3-credentials-v1
  namespace: ate-system
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  refreshInterval: 1h0m0s
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-stores
  target:
    name: ate-s3-credentials-v1
    creationPolicy: Owner
    deletionPolicy: Retain
  data:
    - secretKey: AWS_ACCESS_KEY_ID
      remoteRef:
        key: seaweedfs-s3-ate-snapshots-v1
        property: AWS_ACCESS_KEY_ID
    - secretKey: AWS_SECRET_ACCESS_KEY
      remoteRef:
        key: seaweedfs-s3-ate-snapshots-v1
        property: AWS_SECRET_ACCESS_KEY
---
# ate-api-server reads every key through its optional envFrom on this Secret
# (--postgres-owner-connection-string=@env and the rest); the grants hook
# (grants.yaml) the owner's DSN. Each password is letters and digits only
# (components/postgres/prepare.yaml), so it needs no escaping in the URL. The
# roles each login takes are in the ConfigMap ate-api-server-envvars.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ate-api-server-secret-envvars
  namespace: ate-system
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  refreshInterval: 1h0m0s
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-stores
  target:
    name: ate-api-server-secret-envvars
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      engineVersion: v2
      mergePolicy: Replace
      data:
        ATE_API_POSTGRES_OWNER_CONNECTION_STRING: 'postgresql://substrate_v1_owner_user:{{ .owner }}@postgres-rw.stores.svc:5432/substrate_v1?sslmode=require'
        ATE_API_POSTGRES_READ_WRITE_CONNECTION_STRING: 'postgresql://substrate_v1_readwrite_user:{{ .readwrite }}@postgres-rw.stores.svc:5432/substrate_v1?sslmode=require'
        ATE_API_POSTGRES_SCHEMA: substrate
  data:
    - secretKey: owner
      remoteRef:
        key: postgres-substrate-v1-owner-user
        property: password
    - secretKey: readwrite
      remoteRef:
        key: postgres-substrate-v1-readwrite-user
        property: password
[[- if .ImagePullSecret ]]
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: [[ .ImagePullSecret ]]
  namespace: ate-system
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  refreshInterval: [[ if .RegistryToken.Registry ]]5m0s[[ else ]]1h0m0s[[ end ]]
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-platform
  target:
    name: [[ .ImagePullSecret ]]
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      type: kubernetes.io/dockerconfigjson
      engineVersion: v2
      mergePolicy: Replace
      data:
        .dockerconfigjson: '{{ index . ".dockerconfigjson" }}'
  dataFrom:
    - extract:
        key: [[ .ImagePullSecret ]]
[[- end ]]
[[- else -]]
# Agent Substrate runs only where the operator's preflight found the cluster able
# to host it, with the platform's own stores and the registry inside the
# cluster: no credentials to copy.
[[- end ]]
