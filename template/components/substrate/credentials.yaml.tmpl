[[- if and .Stores .SubstrateCapable .Registry -]]
# =============================================================================
# The control plane's credentials, each copied from where its owner keeps it.
# =============================================================================
#   Secret                          from                             through
#   ate-s3-credentials              stores/seaweedfs-s3-ate-snapshots  infrared-stores
#     the S3 identity ate-snapshots: Read, Write, List and Tagging on the
#     bucket ate-snapshots, nothing else; the API and atelet read it
#   ate-api-server-secret-envvars   stores/postgres-substrate          infrared-stores
#     the API's Postgres DSN and schema: the role substrate on the platform's
#     one Postgres, its database substrate, TLS as SeaweedFS's filers use it
[[- if .ImagePullSecret ]]
#   [[ .ImagePullSecret ]]   [[ .InfraredNamespace ]]/[[ .ImagePullSecret ]]   infrared-platform
#     the pull secret for Substrate's images[[ if .RegistryToken.GCPServiceAccount ]], a registry token
#     copied every 5 minutes[[ end ]]
[[- end ]]
#
# Neither store hands out anything else: each reads only the Secrets its Role
# names, for the namespaces its conditions admit. The values the API server
# would fill in are written out, so Argo CD compares like with like.
#
# Wave -2, alone: External Secrets' webhook admits them, so they are applied,
# and synced, before what reads their Secrets (0). A refused apply then fails
# the sync, which Argo CD retries.
# =============================================================================
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ate-s3-credentials
  namespace: ate-system
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  refreshInterval: 1h0m0s
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-stores
  target:
    name: ate-s3-credentials
    creationPolicy: Owner
    deletionPolicy: Retain
  data:
    - secretKey: AWS_ACCESS_KEY_ID
      remoteRef:
        key: seaweedfs-s3-ate-snapshots
        property: AWS_ACCESS_KEY_ID
    - secretKey: AWS_SECRET_ACCESS_KEY
      remoteRef:
        key: seaweedfs-s3-ate-snapshots
        property: AWS_SECRET_ACCESS_KEY
---
# ate-api-server reads both keys through its optional envFrom on this Secret
# (--postgres-connection-string=@env, --postgres-schema=@env). The password is
# letters and digits only (components/postgres/prepare.yaml), so it needs no
# escaping in the URL.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: ate-api-server-secret-envvars
  namespace: ate-system
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  refreshInterval: 1h0m0s
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-stores
  target:
    name: ate-api-server-secret-envvars
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      engineVersion: v2
      mergePolicy: Replace
      data:
        ATE_API_POSTGRES_CONNECTION_STRING: 'postgresql://substrate:{{ .password }}@postgres-rw.stores.svc:5432/substrate?sslmode=require'
        ATE_API_POSTGRES_SCHEMA: public
  data:
    - secretKey: password
      remoteRef:
        key: postgres-substrate
        property: password
[[- if .ImagePullSecret ]]
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: [[ .ImagePullSecret ]]
  namespace: ate-system
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  refreshInterval: [[ if .RegistryToken.GCPServiceAccount ]]5m0s[[ else ]]1h0m0s[[ end ]]
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-platform
  target:
    name: [[ .ImagePullSecret ]]
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      type: kubernetes.io/dockerconfigjson
      engineVersion: v2
      mergePolicy: Replace
      data:
        .dockerconfigjson: '{{ index . ".dockerconfigjson" }}'
  dataFrom:
    - extract:
        key: [[ .ImagePullSecret ]]
[[- end ]]
[[- else -]]
# Agent Substrate runs only where the operator's preflight found the cluster able
# to host it, with the platform's own stores and the registry inside the
# cluster: no credentials to copy.
[[- end ]]
