[[- if and .Stores .SubstrateCapable .Registry .ImagePullSecret -]]
# The pull secret for Substrate's images: a copy of
# [[ .InfraredNamespace ]]/[[ .ImagePullSecret ]], the one Infrared's own images pull with, through the
# ClusterSecretStore infrared-platform (components/platform-tokens), whose
# conditions admit Substrate's namespaces. The values the API server would fill
# in are written out, so Argo CD compares like with like.
#
# Wave -1, alone: External Secrets' webhook admits it, so it is applied, and
# synced, before the controller (0) that pulls with its Secret.
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: [[ .ImagePullSecret ]]
  namespace: podcertificate-controller-system
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
spec:
  refreshInterval: [[ if .RegistryToken.Registry ]]5m0s[[ else ]]1h0m0s[[ end ]]
  secretStoreRef:
    kind: ClusterSecretStore
    name: infrared-platform
  target:
    name: [[ .ImagePullSecret ]]
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      type: kubernetes.io/dockerconfigjson
      engineVersion: v2
      mergePolicy: Replace
      data:
        .dockerconfigjson: '{{ index . ".dockerconfigjson" }}'
  dataFrom:
    - extract:
        key: [[ .ImagePullSecret ]]
[[- else -]]
# Substrate's images pull with the install's pull secret only where Substrate
# runs and the install names one (the chart's imagePullSecrets): none here.
[[- end ]]
