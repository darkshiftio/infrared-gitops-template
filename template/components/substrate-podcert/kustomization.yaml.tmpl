[[- if and .Stores .SubstrateCapable .Registry -]]
# Agent Substrate's pod-certificate controller (the `substrate-podcert`
# Application, wave 21), in the namespace podcertificate-controller-system:
# its CAs, made once by the PreSync hook in prepare.yaml[[ if .ImagePullSecret ]], the pull secret
# for Substrate's images (pull-secret.yaml)[[ end ]], and the controller itself,
# upstream's, vendored by scripts/vendor-substrate.sh. What this install changes
# in it is the patches below. Every object names its own namespace.
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - prepare.yaml
[[- if .ImagePullSecret ]]
  - pull-secret.yaml
[[- end ]]
  - pod-certificate-controller.yaml
[[- if .SubstrateRegistry ]]
# Substrate's images from [[ .SubstrateRegistry ]] (INFRARED_SUBSTRATE_REGISTRY), each
# by the same tag and digest as on ghcr.
images:
  - name: ghcr.io/darkshiftio/substrate/podcertcontroller
    newName: [[ .SubstrateRegistry ]]/podcertcontroller
[[- end ]]
patches:
  # Argo CD makes the namespace (CreateNamespace), before the PreSync hook that
  # runs in it.
  - patch: |-
      $patch: delete
      apiVersion: v1
      kind: Namespace
      metadata:
        name: podcertificate-controller-system
[[- if .ImagePullSecret ]]
  # Substrate's images are private: they pull with [[ .ImagePullSecret ]], copied from
  # [[ .InfraredNamespace ]] (pull-secret.yaml).
  - patch: |-
      apiVersion: apps/v1
      kind: Deployment
      metadata:
        name: podcertificate-controller
        namespace: podcertificate-controller-system
      spec:
        template:
          spec:
            imagePullSecrets:
              - name: [[ .ImagePullSecret ]]
[[- end ]]
[[- else -]]
# Agent Substrate runs only where the operator's preflight found the cluster able
# to host it, with the platform's own stores and the registry inside the
# cluster, so this component holds no objects and no Application points at it.
[[- end ]]
