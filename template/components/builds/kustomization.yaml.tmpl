[[- if .BuildRegistry -]]
# Product image builds with kpack (the `builds` Application, wave 26).
# Builds push to [[ .BuildRegistry ]]. See README.md.
#
[[- if .Registry ]]
# The objects span namespaces (builds, kpack[[ if ne .Forge "gitea" ]], ir-org-[[ .OrgName ]][[ end ]] and cluster
# scope), so every one names its own namespace and this kustomization sets none.
[[- else ]]
# The objects span namespaces (builds, build-credentials, ir-org-[[ .OrgName ]]
# and cluster scope), so every one names its own namespace and this
# kustomization sets none.
[[- end ]]
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - namespaces.yaml
  - builder.yaml
[[- if .Registry ]]
  - wait.yaml
[[- end ]]
[[- if ne .Forge "gitea" ]]
  - github-token.yaml
[[- end ]]
[[- if and (contains ".dkr.ecr." .BuildRegistry) (not .Registry) ]]
  - ecr-login.yaml
[[- end ]]
[[- if or (ne .Forge "gitea") (and (contains ".dkr.ecr." .BuildRegistry) (not .Registry)) ]]
configMapGenerator:
[[- end ]]
[[- if ne .Forge "gitea" ]]
  - name: github-token-scripts
    namespace: builds
    files:
      - scripts/github-app.sh
      - scripts/github-jwt.sh
      - scripts/github-token.sh
[[- end ]]
[[- if and (contains ".dkr.ecr." .BuildRegistry) (not .Registry) ]]
  - name: ecr-login-scripts
    namespace: build-credentials
    files:
      - scripts/ecr-login.sh
[[- end ]]
[[- else -]]
# builds is off: Infrared has no build registry (INFRARED_BUILD_REGISTRY), so
# this component holds no objects and no Application points at it.
[[- end ]]
