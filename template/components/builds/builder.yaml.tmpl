[[- /* The stores' org layout (StoresOrgLayout, ADR 0087 D2): the platform's repositories under platform/images/. */ -]]
[[- $layout := and .Stores .Registry .StoresOrgLayout -]]
[[- if .BuildRegistry -]]
[[ if .Registry -]]
# =============================================================================
# The ServiceAccount the builder is pushed with, and the buildpacks builds use.
# =============================================================================
# Builds push to the registry inside the cluster, [[ .Registry ]], which takes a
# push only from a user its rules allow (components/zot/base.yaml):
#   - the ClusterBuilder pushes the builder image under platform/ as the user
#     platform, with this ServiceAccount, `infrared-builder` in the namespace
#     kpack. It lists registry-push, kubernetes.io/dockerconfigjson for
#     [[ .Registry ]], which the Infrared operator writes once the namespace
#     kpack exists; wait.yaml holds the builder back until it does. No platform
#     credential lives in builds, where an organization's gitops repo may create
#     any object.
[[- if $layout ]]
#   - each organization's builds push under its own path, <org>/images/, as
#     its own user, which writes only under its kinds there (the stores' org
#     layout): the operator makes builds/registry-push-<org> and the
#     ServiceAccount builds/builder-<org>, which its kpack Images name.
[[- else ]]
#   - each organization's builds push under its own path, <org>/, as its own
#     user: the operator makes builds/registry-push-<org> and the
#     ServiceAccount builds/builder-<org>, which its kpack Images name.
[[- end ]]
[[- if .RegistryPulls ]]
# No one pulls without a login (the Infrared chart's tenancy.registryPulls): a
# build pulls the builder as its organization's user, which reads platform/.
[[- else ]]
# Anything in the cluster pulls without a login, the kubelet included.
[[- end ]]
# =============================================================================
apiVersion: v1
kind: ServiceAccount
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
  name: infrared-builder
  namespace: kpack
secrets:
  - name: registry-push
imagePullSecrets:
  - name: registry-push
[[- else -]]
# =============================================================================
# The ServiceAccount builds run with, and the buildpacks they use.
# =============================================================================
# `builder` (namespace builds) is the serviceAccountName of every product's
# kpack Image, and the ClusterBuilder pushes the builder image with it too.
# Neither Secret it lists is written by hand in the usual case:
#   registry-push  kubernetes.io/dockerconfigjson, annotation
#                  kpack.io/docker: <registry host>.
[[- if contains ".dkr.ecr." .BuildRegistry ]]
#                  A 12-hour ECR token from the node role, refreshed every 6h
#                  by build-credentials/ecr-login (ecr-login.yaml).
[[- else ]]
#                  This registry is not ECR: the org creates builds/registry-push
#                  itself (README.md, "Registry credentials").
[[- end ]]
[[- if eq .Forge "gitea" ]]
#   gitea-git      kubernetes.io/basic-auth (the bot user, and its read-only
#                  token as the password), annotation kpack.io/git:
#                  [[ .ForgeURL ]]. The operator writes it from the org's
#                  GitProvider gitea once this namespace exists.
[[- else ]]
#   github-git     kubernetes.io/basic-auth (x-access-token), annotation
#                  kpack.io/git: https://github.com. A 1-hour installation token
#                  of Infrared's GitHub App for the org, refreshed every 45m by
#                  builds/github-token (github-token.yaml).
[[- end ]]
# imagePullSecrets lets kpack (and the kubelet) read the builder it pushed.
# =============================================================================
apiVersion: v1
kind: ServiceAccount
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
  name: builder
  namespace: builds
secrets:
  - name: registry-push
[[- if eq .Forge "gitea" ]]
  - name: gitea-git
[[- else ]]
  - name: github-git
[[- end ]]
imagePullSecrets:
  - name: registry-push
[[- end ]]
---
# =============================================================================
# The buildpacks kpack may use, pinned by tag AND digest.
# =============================================================================
# Each the newest release on 2026-11-20 (the upgrade sweep, workspace TODO 742): go 4.23.5,
# whose go-dist (2.11.4) offers Go 1.27.4, the fix for GO-2026-6859 (an HTTP/1 server crash
# in net/http); nodejs 10.17.0, whose node-engine (8.12.3) offers Node 22.23.5, 24.22.3 and
# 26.13.1; web-servers 4.16.3, whose nginx buildpack (1.3.8)
# serves nginx 1.31.9 by default, the fix for nginx2root (CVE-2026-123007, -123633, -123634,
# -121810 and -113425). Digests from `crane digest docker.io/paketobuildpacks/<bp>:<v>`.
# To bump: change tag and digest together, in one pull request.
# =============================================================================
apiVersion: kpack.io/v1alpha2
kind: ClusterStore
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "1"
  name: paketo
spec:
  sources:
    - image: docker.io/paketobuildpacks/go:4.23.5@sha256:db78f48f0b6d51607537db04c91e1611cea283bc05e09ab9554ddb9af7b33253
    - image: docker.io/paketobuildpacks/nodejs:10.17.0@sha256:ba6341b9dee1a3733f912fcf843e4c0e4b251dbf0ea5abdc09a819f2c3015f79
    - image: docker.io/paketobuildpacks/web-servers:4.16.3@sha256:a01f811143ca2629a1cfb2b053a63de0b845cf6e38d19ca375f2c3d6c62c6e97
---
# =============================================================================
# Ubuntu 24.04 (Noble): Paketo's current stack.
# =============================================================================
# The stack id `io.buildpacks.stacks.noble` is the image's own
# `io.buildpacks.stack.id` label. The run image is pinned, so kpack does NOT
# rebase images onto a newer run image on its own: a stack bump is a reviewed
# pull request, after which kpack rebases every Image (no rebuild needed).
# =============================================================================
apiVersion: kpack.io/v1alpha2
kind: ClusterStack
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "1"
  name: noble
spec:
  id: io.buildpacks.stacks.noble
  buildImage:
    image: docker.io/paketobuildpacks/ubuntu-noble-build:0.0.162@sha256:20752810c913fb51847cbf9159e0ad9769dd34db040cc89b6b588761269c68c4
  runImage:
    image: docker.io/paketobuildpacks/ubuntu-noble-run:0.0.162@sha256:00209cf68f2a1ed1cdb2f5a9502384433f0194fa11e1a9ac674bd0a2b54601b5
---
# =============================================================================
# The buildpacks lifecycle: what runs every build, and the launcher every image
# starts through (/cnb/lifecycle/launcher), pinned by tag AND digest.
# =============================================================================
# kpack's own ClusterLifecycle, `default-lifecycle` (components/kpack, vendored
# with kpack 0.18.0), is the lifecycle 0.21.14, built with Go 1.26.5. kpack puts
# its launcher in every image it builds, so every image carried the Go standard
# library's advisories fixed in Go 1.26.9 and 1.27.2, two critical among them
# (GO-2026-6604 and GO-2026-6612), and every customer release's security
# evidence read not safe. This is upstream's image of 0.21.30 (2026-11-24), built
# with Go 1.27.4. kpack's image is a copy of upstream's, layer for layer, and
# kpack reads only its labels (io.buildpacks.lifecycle.apis and
# io.buildpacks.builder.metadata) and its last layer. A lifecycle change is one
# of kpack's build reasons, so every Image builds again on this one. Digest from
# `crane digest docker.io/buildpacksio/lifecycle:<v>`. To bump: change tag and
# digest together, in one pull request.
# =============================================================================
apiVersion: kpack.io/v1alpha2
kind: ClusterLifecycle
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "1"
  name: buildpacks-lifecycle
spec:
  image: docker.io/buildpacksio/lifecycle:0.21.30@sha256:8b7f55e61b36ef7df4355273c96ee6edf0fee8b105c33f5e75ed543f44c84033
---
# =============================================================================
# `infrared-builder`: Go services, Go services with a UI built by Node, and web
# UIs (a Node build served by nginx).
# =============================================================================
# Order groups, first match wins:
#   1. Go with a UI a Go service that embeds a UI Node builds first, such as a
#                   React app in web/ built into web/dist: node-engine,
#                   npm-install and node-run-script, then the Go composite's
#                   own first group. It detects only with a package.json
#                   where BP_NODE_PROJECT_PATH points (the top when unset),
#                   BP_NODE_RUN_SCRIPTS naming its build script, and go.mod.
#                   kpack reads a repo's project.toml for its build env and
#                   include/exclude but ignores its io.buildpacks.group tables
#                   (kpack pkg/cnb/project_descriptor.go), so a group a repo
#                   asks for there has to be one of the builder's.
#   2. go           Go services
#   3. web-servers  a UI: BP_WEB_SERVER=nginx on the Image makes it detect.
#                   The web-servers composite already carries node-engine,
#                   npm-install and node-run-script, so the Node build
#                   (BP_NODE_RUN_SCRIPTS=build) happens inside this group.
#   4. nodejs       a plain Node server.
#   5. procfile     files and a start command, with no language: a repo none
#                   of the groups above detects, with a Procfile or
#                   BP_PROCFILE_DEFAULT_PROCESS. The image is the run image
#                   and the repo's files under /workspace, nothing else: no
#                   runtime, no package manager, nothing a scan would find
#                   but the run image's own packages. Infrared's summary
#                   video is one: its Job copies its files out and runs them
#                   in other images, so a Node runtime in its own image was
#                   unused and carried the npm bundled with Node into every
#                   scan (infrared-docs-internal ADR 0093).
# A Go repo with no package.json or no BP_NODE_RUN_SCRIPTS, and a Node repo
# with no go.mod, fail group 1 and build as they did before it.
# web-servers and nodejs are separate groups rather than one: both composites
# contain node-engine and npm-install, and one group would run the install
# twice. This is also the order Paketo's own builder uses.
#
[[- if .Registry ]]
# The builder image is pushed to [[ .Registry ]]/platform/[[ if $layout ]]images/[[ end ]]kpack-builder, by
# address and over plain HTTP: the build tools fall back to HTTP only for a
# private address, never for a name. Zot makes the repository on the first push.
[[- else ]]
# The builder image is pushed to [[ .BuildRegistry ]]/kpack-builder; that
# repository must exist (ECR does not create repositories on push).
[[- end ]]
# =============================================================================
apiVersion: kpack.io/v1alpha2
kind: ClusterBuilder
metadata:
  annotations:
    argocd.argoproj.io/sync-wave: "1"
  name: infrared-builder
spec:
[[- if .Registry ]]
  tag: [[ .Registry ]]/platform/[[ if $layout ]]images/[[ end ]]kpack-builder
  serviceAccountRef:
    name: infrared-builder
    namespace: kpack
[[- else ]]
  tag: [[ .BuildRegistry ]]/kpack-builder
  serviceAccountRef:
    name: builder
    namespace: builds
[[- end ]]
  stack:
    kind: ClusterStack
    name: noble
  lifecycle:
    kind: ClusterLifecycle
    name: buildpacks-lifecycle
  store:
    kind: ClusterStore
    name: paketo
  order:
    - group:
        - id: paketo-buildpacks/ca-certificates
          optional: true
        - id: paketo-buildpacks/node-engine
        - id: paketo-buildpacks/npm-install
        - id: paketo-buildpacks/node-run-script
        - id: paketo-buildpacks/go-dist
        - id: paketo-buildpacks/git
          optional: true
        - id: paketo-buildpacks/go-mod-vendor
        - id: paketo-buildpacks/go-build
        - id: paketo-buildpacks/procfile
          optional: true
        - id: paketo-buildpacks/environment-variables
          optional: true
        - id: paketo-buildpacks/image-labels
          optional: true
    - group:
        - id: paketo-buildpacks/go
    - group:
        - id: paketo-buildpacks/web-servers
    - group:
        - id: paketo-buildpacks/nodejs
    - group:
        - id: paketo-buildpacks/procfile
[[- else -]]
# builds is off (no build registry): no builder.
[[- end ]]
